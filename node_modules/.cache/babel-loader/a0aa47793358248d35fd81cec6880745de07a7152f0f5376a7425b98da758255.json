{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { signInWithEmailAndPassword, onAuthStateChanged } from 'firebase/auth';\nimport { auth } from '../firebase/config';\nexport default {\n  name: \"LoginView\",\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      error: \"\",\n      loading: false,\n      currentUser: null\n    };\n  },\n  mounted() {\n    // Verificar si el usuario ya está autenticado\n    onAuthStateChanged(auth, user => {\n      if (user) {\n        // Si ya está autenticado, redirigir\n        const isAdmin = user.email === 'admin@fashionstore.com';\n        localStorage.setItem('usuarioActivo', user.email);\n        localStorage.setItem('userRole', isAdmin ? 'admin' : 'user');\n        this.$router.push(isAdmin ? '/admin' : '/productos');\n      }\n    });\n  },\n  methods: {\n    async login() {\n      this.error = \"\";\n      this.loading = true;\n      try {\n        // Usar Firebase Authentication\n        const userCredential = await signInWithEmailAndPassword(auth, this.email, this.password);\n        const user = userCredential.user;\n\n        // Determinar el rol basado en el email\n        const isAdmin = user.email === 'admin@fashionstore.com';\n\n        // Guardar información del usuario\n        localStorage.setItem('usuarioActivo', user.email);\n        localStorage.setItem('userRole', isAdmin ? 'admin' : 'user');\n\n        // Mostrar notificación de éxito\n        window.dispatchEvent(new CustomEvent('show-notification', {\n          detail: {\n            message: `¡Bienvenido, ${user.email}!`,\n            type: 'success',\n            duration: 3000\n          }\n        }));\n\n        // Redirigir según el rol\n        if (isAdmin) {\n          this.$router.push('/admin');\n        } else {\n          this.$router.push('/productos');\n        }\n      } catch (error) {\n        this.loading = false;\n        console.error('Error de autenticación:', error);\n\n        // Mostrar mensajes de error específicos\n        if (error.code === 'auth/user-not-found') {\n          this.error = 'El correo electrónico no está registrado';\n        } else if (error.code === 'auth/wrong-password') {\n          this.error = 'Contraseña incorrecta';\n        } else if (error.code === 'auth/invalid-email') {\n          this.error = 'Correo electrónico inválido';\n        } else if (error.code === 'auth/user-disabled') {\n          this.error = 'Usuario deshabilitado';\n        } else {\n          this.error = 'Error al iniciar sesión. Verifica tus credenciales.';\n        }\n\n        // Mostrar notificación de error\n        window.dispatchEvent(new CustomEvent('show-notification', {\n          detail: {\n            message: this.error,\n            type: 'error',\n            duration: 3000\n          }\n        }));\n      }\n    }\n  }\n};","map":{"version":3,"names":["signInWithEmailAndPassword","onAuthStateChanged","auth","name","data","email","password","error","loading","currentUser","mounted","user","isAdmin","localStorage","setItem","$router","push","methods","login","userCredential","window","dispatchEvent","CustomEvent","detail","message","type","duration","console","code"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\views\\LoginView.vue"],"sourcesContent":["<template>\r\n\t<div class=\"login-container d-flex justify-content-center align-items-center vh-100\">\r\n\t\t<div class=\"card shadow p-4\" style=\"width: 22rem;\">\r\n\t\t\t<h3 class=\"text-center mb-4\">Iniciar Sesión</h3>\r\n\r\n\t\t\t<form @submit.prevent=\"login\">\r\n\t\t\t\t<div class=\"mb-3\">\r\n\t\t\t\t\t<label for=\"email\" class=\"form-label\">Correo Electrónico</label>\r\n\t\t\t\t\t<input\r\n\t\t\t\t\t\tv-model.trim=\"email\"\r\n\t\t\t\t\t\ttype=\"email\"\r\n\t\t\t\t\t\tclass=\"form-control\"\r\n\t\t\t\t\t\tid=\"email\"\r\n\t\t\t\t\t\tplaceholder=\"correo@ejemplo.com\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div class=\"mb-3\">\r\n\t\t\t\t\t<label for=\"password\" class=\"form-label\">Contraseña</label>\r\n\t\t\t\t\t<input\r\n\t\t\t\t\t\tv-model=\"password\"\r\n\t\t\t\t\t\ttype=\"password\"\r\n\t\t\t\t\t\tclass=\"form-control\"\r\n\t\t\t\t\t\tid=\"password\"\r\n\t\t\t\t\t\tplaceholder=\"Ingrese su contraseña\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div v-if=\"error\" class=\"alert alert-danger py-2 text-center\">\r\n\t\t\t\t\t{{ error }}\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<button type=\"submit\" class=\"btn btn-primary w-100\" :disabled=\"loading\">\r\n\t\t\t\t\t<span v-if=\"!loading\">Entrar</span>\r\n\t\t\t\t\t<span v-else>Iniciando sesión...</span>\r\n\t\t\t\t</button>\r\n\r\n\t\t\t\t<p class=\"text-center mt-3\">\r\n\t\t\t\t\t¿No tienes cuenta? <router-link to=\"/register\" class=\"text-decoration-none\">Regístrate aquí</router-link>\r\n\t\t\t\t</p>\r\n\t\t\t</form>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nimport { signInWithEmailAndPassword, onAuthStateChanged } from 'firebase/auth'\r\nimport { auth } from '../firebase/config'\r\n\r\nexport default {\r\n\tname: \"LoginView\",\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\temail: \"\",\r\n\t\t\tpassword: \"\",\r\n\t\t\terror: \"\",\r\n\t\t\tloading: false,\r\n\t\t\tcurrentUser: null\r\n\t\t};\r\n\t},\r\n\tmounted() {\r\n\t\t// Verificar si el usuario ya está autenticado\r\n\t\tonAuthStateChanged(auth, (user) => {\r\n\t\t\tif (user) {\r\n\t\t\t\t// Si ya está autenticado, redirigir\r\n\t\t\t\tconst isAdmin = user.email === 'admin@fashionstore.com'\r\n\t\t\t\tlocalStorage.setItem('usuarioActivo', user.email)\r\n\t\t\t\tlocalStorage.setItem('userRole', isAdmin ? 'admin' : 'user')\r\n\t\t\t\t\r\n\t\t\t\tthis.$router.push(isAdmin ? '/admin' : '/productos')\r\n\t\t\t}\r\n\t\t})\r\n\t},\r\n\tmethods: {\r\n\t\tasync login() {\r\n\t\t\tthis.error = \"\";\r\n\t\t\tthis.loading = true;\r\n\r\n\t\t\ttry {\r\n\t\t\t\t// Usar Firebase Authentication\r\n\t\t\t\tconst userCredential = await signInWithEmailAndPassword(auth, this.email, this.password);\r\n\t\t\t\tconst user = userCredential.user;\r\n\t\t\t\t\r\n\t\t\t\t// Determinar el rol basado en el email\r\n\t\t\t\tconst isAdmin = user.email === 'admin@fashionstore.com';\r\n\t\t\t\t\r\n\t\t\t\t// Guardar información del usuario\r\n\t\t\t\tlocalStorage.setItem('usuarioActivo', user.email);\r\n\t\t\t\tlocalStorage.setItem('userRole', isAdmin ? 'admin' : 'user');\r\n\t\t\t\t\r\n\t\t\t\t// Mostrar notificación de éxito\r\n\t\t\t\twindow.dispatchEvent(new CustomEvent('show-notification', {\r\n\t\t\t\t\tdetail: {\r\n\t\t\t\t\t\tmessage: `¡Bienvenido, ${user.email}!`,\r\n\t\t\t\t\t\ttype: 'success',\r\n\t\t\t\t\t\tduration: 3000\r\n\t\t\t\t\t}\r\n\t\t\t\t}));\r\n\t\t\t\t\r\n\t\t\t\t// Redirigir según el rol\r\n\t\t\t\tif (isAdmin) {\r\n\t\t\t\t\tthis.$router.push('/admin');\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.$router.push('/productos');\r\n\t\t\t\t}\r\n\t\t\t} catch (error) {\r\n\t\t\t\tthis.loading = false;\r\n\t\t\t\tconsole.error('Error de autenticación:', error);\r\n\t\t\t\t\r\n\t\t\t\t// Mostrar mensajes de error específicos\r\n\t\t\t\tif (error.code === 'auth/user-not-found') {\r\n\t\t\t\t\tthis.error = 'El correo electrónico no está registrado';\r\n\t\t\t\t} else if (error.code === 'auth/wrong-password') {\r\n\t\t\t\t\tthis.error = 'Contraseña incorrecta';\r\n\t\t\t\t} else if (error.code === 'auth/invalid-email') {\r\n\t\t\t\t\tthis.error = 'Correo electrónico inválido';\r\n\t\t\t\t} else if (error.code === 'auth/user-disabled') {\r\n\t\t\t\t\tthis.error = 'Usuario deshabilitado';\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.error = 'Error al iniciar sesión. Verifica tus credenciales.';\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t// Mostrar notificación de error\r\n\t\t\t\twindow.dispatchEvent(new CustomEvent('show-notification', {\r\n\t\t\t\t\tdetail: {\r\n\t\t\t\t\t\tmessage: this.error,\r\n\t\t\t\t\t\ttype: 'error',\r\n\t\t\t\t\t\tduration: 3000\r\n\t\t\t\t\t}\r\n\t\t\t\t}));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n</script>\r\n\r\n<s