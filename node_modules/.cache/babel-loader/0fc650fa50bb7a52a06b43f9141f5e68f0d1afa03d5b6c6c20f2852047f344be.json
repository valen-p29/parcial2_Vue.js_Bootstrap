{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { signInWithEmailAndPassword, onAuthStateChanged } from 'firebase/auth';\nimport { auth, db } from '../firebase/config';\nimport { doc, getDoc } from 'firebase/firestore';\nexport default {\n  name: \"LoginView\",\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      error: \"\",\n      loading: false,\n      currentUser: null\n    };\n  },\n  mounted() {\n    // Verificar si el usuario ya está autenticado\n    onAuthStateChanged(auth, async user => {\n      if (user) {\n        // Obtener rol de Firestore\n        const userRole = await this.getUserRole(user.uid);\n        localStorage.setItem('usuarioActivo', user.email);\n        localStorage.setItem('userRole', userRole);\n        this.$router.push(userRole === 'admin' ? '/admin' : '/productos');\n      }\n    });\n  },\n  methods: {\n    async getUserRole(uid) {\n      try {\n        const userDocRef = doc(db, 'users', uid);\n        const userDoc = await getDoc(userDocRef);\n        if (userDoc.exists()) {\n          return userDoc.data().role || 'user';\n        }\n      } catch (error) {\n        console.error('Error al obtener rol:', error);\n      }\n      return 'user';\n    },\n    async login() {\n      this.error = \"\";\n      this.loading = true;\n      try {\n        // Usar Firebase Authentication\n        const userCredential = await signInWithEmailAndPassword(auth, this.email, this.password);\n        const user = userCredential.user;\n\n        // Obtener rol de Firestore\n        const userRole = await this.getUserRole(user.uid);\n\n        // Guardar información del usuario\n        localStorage.setItem('usuarioActivo', user.email);\n        localStorage.setItem('userRole', userRole);\n\n        // Mostrar notificación de éxito\n        window.dispatchEvent(new CustomEvent('show-notification', {\n          detail: {\n            message: `¡Bienvenido, ${user.email}!`,\n            type: 'success',\n            duration: 3000\n          }\n        }));\n\n        // Redirigir según el rol\n        if (userRole === 'admin') {\n          this.$router.push('/admin');\n        } else {\n          this.$router.push('/productos');\n        }\n      } catch (error) {\n        this.loading = false;\n        console.error('Error de autenticación:', error);\n\n        // Mostrar mensajes de error específicos\n        if (error.code === 'auth/user-not-found') {\n          this.error = 'El correo electrónico no está registrado';\n        } else if (error.code === 'auth/wrong-password') {\n          this.error = 'Contraseña incorrecta';\n        } else if (error.code === 'auth/invalid-email') {\n          this.error = 'Correo electrónico inválido';\n        } else if (error.code === 'auth/user-disabled') {\n          this.error = 'Usuario deshabilitado';\n        } else {\n          this.error = 'Error al iniciar sesión. Verifica tus credenciales.';\n        }\n\n        // Mostrar notificación de error\n        window.dispatchEvent(new CustomEvent('show-notification', {\n          detail: {\n            message: this.error,\n            type: 'error',\n            duration: 3000\n          }\n        }));\n      }\n    }\n  }\n};","map":{"version":3,"names":["signInWithEmailAndPassword","onAuthStateChanged","auth","db","doc","getDoc","name","data","email","password","error","loading","currentUser","mounted","user","userRole","getUserRole","uid","localStorage","setItem","$router","push","methods","userDocRef","userDoc","exists","role","console","login","userCredential","window","dispatchEvent","CustomEvent","detail","message","type","duration","code"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\views\\LoginView.vue"],"sourcesContent":["<template>\r\n\t<div class=\"login-container d-flex justify-content-center align-items-center vh-100\">\r\n\t\t<div class=\"card shadow p-4\" style=\"width: 22rem;\">\r\n\t\t\t<h3 class=\"text-center mb-4\">Iniciar Sesión</h3>\r\n\r\n\t\t\t<form @submit.prevent=\"login\">\r\n\t\t\t\t<div class=\"mb-3\">\r\n\t\t\t\t\t<label for=\"email\" class=\"form-label\">Correo Electrónico</label>\r\n\t\t\t\t\t<input\r\n\t\t\t\t\t\tv-model.trim=\"email\"\r\n\t\t\t\t\t\ttype=\"email\"\r\n\t\t\t\t\t\tclass=\"form-control\"\r\n\t\t\t\t\t\tid=\"email\"\r\n\t\t\t\t\t\tplaceholder=\"correo@ejemplo.com\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div class=\"mb-3\">\r\n\t\t\t\t\t<label for=\"password\" class=\"form-label\">Contraseña</label>\r\n\t\t\t\t\t<input\r\n\t\t\t\t\t\tv-model=\"password\"\r\n\t\t\t\t\t\ttype=\"password\"\r\n\t\t\t\t\t\tclass=\"form-control\"\r\n\t\t\t\t\t\tid=\"password\"\r\n\t\t\t\t\t\tplaceholder=\"Ingrese su contraseña\"\r\n\t\t\t\t\t\trequired\r\n\t\t\t\t\t/>\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<div v-if=\"error\" class=\"alert alert-danger py-2 text-center\">\r\n\t\t\t\t\t{{ error }}\r\n\t\t\t\t</div>\r\n\r\n\t\t\t\t<button type=\"submit\" class=\"btn btn-primary w-100\" :disabled=\"loading\">\r\n\t\t\t\t\t<span v-if=\"!loading\">Entrar</span>\r\n\t\t\t\t\t<span v-else>Iniciando sesión...</span>\r\n\t\t\t\t</button>\r\n\r\n\t\t\t\t<p class=\"text-center mt-3\">\r\n\t\t\t\t\t¿No tienes cuenta? <router-link to=\"/register\" class=\"text-decoration-none\">Regístrate aquí</router-link>\r\n\t\t\t\t</p>\r\n\t\t\t</form>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nimport { signInWithEmailAndPassword, onAuthStateChanged } from 'firebase/auth'\r\nimport { auth, db } from '../firebase/config'\r\nimport { doc, getDoc } from 'firebase/firestore'\r\n\r\nexport default {\r\n\tname: \"LoginView\",\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\temail: \"\",\r\n\t\t\tpassword: \"\",\r\n\t\t\terror: \"\",\r\n\t\t\tloading: false,\r\n\t\t\tcurrentUser: null\r\n\t\t};\r\n\t},\r\n\tmounted() {\r\n\t\t// Verificar si el usuario ya está autenticado\r\n\t\tonAuthStateChanged(auth, async (user) => {\r\n\t\t\tif (user) {\r\n\t\t\t\t// Obtener rol de Firestore\r\n\t\t\t\tconst userRole = await this.getUserRole(user.uid)\r\n\t\t\t\tlocalStorage.setItem('usuarioActivo', user.email)\r\n\t\t\t\tlocalStorage.setItem('userRole', userRole)\r\n\t\t\t\t\r\n\t\t\t\tthis.$router.push(userRole === 'admin' ? '/admin' : '/productos')\r\n\t\t\t}\r\n\t\t})\r\n\t},\r\n\tmethods: {\r\n\t\tasync getUserRole(uid) {\r\n\t\t\ttry {\r\n\t\t\t\tconst userDocRef = doc(db, 'users', uid)\r\n\t\t\t\tconst userDoc = await getDoc(userDocRef)\r\n\t\t\t\tif (userDoc.exists()) {\r\n\t\t\t\t\treturn userDoc.data().role || 'user'\r\n\t\t\t\t}\r\n\t\t\t} catch (error) {\r\n\t\t\t\tconsole.error('Error al obtener rol:', error)\r\n\t\t\t}\r\n\t\t\treturn 'user'\r\n\t\t},\r\n\t\tasync login() {\r\n\t\t\tthis.error = \"\";\r\n\t\t\tthis.loading = true;\r\n\r\n\t\t\ttry {\r\n\t\t\t\t// Usar Firebase Authentication\r\n\t\t\t\tconst userCredential = await signInWithEmailAndPassword(auth, this.email, this.password);\r\n\t\t\t\tconst user = userCredential.user;\r\n\t\t\t\t\r\n\t\t\t\t// Obtener rol de Firestore\r\n\t\t\t\tconst userRole = await this.getUserRole(user.uid)\r\n\t\t\t\t\r\n\t\t\t\t// Guardar información del usuario\r\n\t\t\t\tlocalStorage.setItem('usuarioActivo', user.email);\r\n\t\t\t\tlocalStorage.setItem('userRole', userRole);\r\n\t\t\t\t\r\n\t\t\t\t// Mostrar notificación de éxito\r\n\t\t\t\twindow.dispatchEvent(new CustomEvent('show-notification', {\r\n\t\t\t\t\tdetail: {\r\n\t\t\t\t\t\tmessage: `¡Bienvenido, ${user.email}!`,\r\n\t\t\t\t\t\ttype: 'success',\r\n\t\t\t\t\t\tduration: 3000\r\n\t\t\t\t\t}\r\n\t\t\t\t}));\r\n\t\t\t\t\r\n\t\t\t\t// Redirigir según el rol\r\n\t\t\t\tif (userRole === 'admin') {\r\n\t\t\t\t\tthis.$router.push('/admin');\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.$router.push('/productos');\r\n\t\t\t\t}\r\n\t\t\t} catch (error) {\r\n\t\t\t\tthis.loading = false;\r\n\t\t\t\tconsole.error('Error de autenticación:', error);\r\n\t\t\t\t\r\n\t\t\t\t// Mostrar mensajes de error específicos\r\n\t\t\t\tif (error.code === 'auth/user-not-found') {\r\n\t\t\t\t\tthis.error = 'El correo electrónico no está registrado';\r\n\t\t\t\t} else if (error.code === 'auth/wrong-password') {\r\n\t\t\t\t\tthis.error = 'Contraseña incorrecta';\r\n\t\t\t\t} else if (error.code === 'auth/invalid-email') {\r\n\t\t\t\t\tthis.error = 'Correo electrónico inválido';\r\n\t\t\t\t} else if (error.code === 'auth/user-disabled') {\r\n\t\t\t\t\tthis.error = 'Usuario deshabilitado';\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.error = 'Error al iniciar sesión. Verifica tus credenciales.';\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t// Mostrar notificación de error\r\n\t\t\t\twindow.dispatchEvent(new CustomEvent('show-notification', {\r\n\t\t\t\t\tdetail: {\r\n\t\t\t\t\t\tmessage: this.error,\r\n\t\t\t\t\t\ttype: 'error',\r\n\t\t\t\t\t\tduration: 3000\r\n\t\t\t\t\t}\r\n\t\t\t\t}));\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-container { \r\n\tbackground: var(--primary-bg); \r\n}\r\n</style>"],"mappings":";AAgDA,SAASA,0BAA0B,EAAEC,kBAAiB,QAAS,eAAc;AAC7E,SAASC,IAAI,EAAEC,EAAC,QAAS,oBAAmB;AAC5C,SAASC,GAAG,EAAEC,MAAK,QAAS,oBAAmB;AAE/C,eAAe;EACdC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACN,OAAO;MACNC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,KAAK;MACdC,WAAW,EAAE;IACd,CAAC;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACT;IACAZ,kBAAkB,CAACC,IAAI,EAAE,MAAOY,IAAI,IAAK;MACxC,IAAIA,IAAI,EAAE;QACT;QACA,MAAMC,QAAO,GAAI,MAAM,IAAI,CAACC,WAAW,CAACF,IAAI,CAACG,GAAG;QAChDC,YAAY,CAACC,OAAO,CAAC,eAAe,EAAEL,IAAI,CAACN,KAAK;QAChDU,YAAY,CAACC,OAAO,CAAC,UAAU,EAAEJ,QAAQ;QAEzC,IAAI,CAACK,OAAO,CAACC,IAAI,CAACN,QAAO,KAAM,OAAM,GAAI,QAAO,GAAI,YAAY;MACjE;IACD,CAAC;EACF,CAAC;EACDO,OAAO,EAAE;IACR,MAAMN,WAAWA,CAACC,GAAG,EAAE;MACtB,IAAI;QACH,MAAMM,UAAS,GAAInB,GAAG,CAACD,EAAE,EAAE,OAAO,EAAEc,GAAG;QACvC,MAAMO,OAAM,GAAI,MAAMnB,MAAM,CAACkB,UAAU;QACvC,IAAIC,OAAO,CAACC,MAAM,CAAC,CAAC,EAAE;UACrB,OAAOD,OAAO,CAACjB,IAAI,CAAC,CAAC,CAACmB,IAAG,IAAK,MAAK;QACpC;MACD,EAAE,OAAOhB,KAAK,EAAE;QACfiB,OAAO,CAACjB,KAAK,CAAC,uBAAuB,EAAEA,KAAK;MAC7C;MACA,OAAO,MAAK;IACb