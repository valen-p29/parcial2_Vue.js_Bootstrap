{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\n// Animaciones de scroll: añade la clase `animate-in` a secciones observadas\n// y hace un reveal escalonado (stagger) para cards internas (.feature-card y .recommendation-card).\nconst setupScrollAnimations = () => {\n  try {\n    const els = Array.from(document.querySelectorAll('.scroll-animation'));\n    if (!els.length) return;\n    const io = new IntersectionObserver((entries, observer) => {\n      entries.forEach(entry => {\n        if (!entry.isIntersecting) return;\n        const container = entry.target;\n\n        // Añadir clase al contenedor para animaciones CSS globales\n        container.classList.add('animate-in');\n\n        // Animar children con stagger si existen\n        const staggerChildren = container.querySelectorAll('.feature-card, .recommendation-card');\n        if (staggerChildren.length) {\n          staggerChildren.forEach((child, i) => {\n            // Limpiar cualquier inline style previo\n            child.style.transitionDelay = '';\n            // Forzar reflow para asegurar que la transición se aplica\n            // eslint-disable-next-line no-unused-expressions\n            child.offsetHeight;\n            child.style.transitionDelay = `${i * 80}ms`;\n            child.classList.add('animate-in');\n          });\n        }\n\n        // Dejar de observar este contenedor una vez animado\n        observer.unobserve(container);\n      });\n    }, {\n      threshold: 0.12\n    });\n\n    // Esperar al siguiente frame para asegurar DOM y tamaños calculados\n    requestAnimationFrame(() => els.forEach(el => io.observe(el)));\n  } catch (e) {\n    // Fallback: si IntersectionObserver no está disponible, revelamos todo inmediatamente\n    const all = document.querySelectorAll('.scroll-animation');\n    all.forEach(container => {\n      container.classList.add('animate-in');\n      container.querySelectorAll('.feature-card, .recommendation-card').forEach((child, i) => {\n        child.style.transitionDelay = `${i * 80}ms`;\n        child.classList.add('animate-in');\n      });\n    });\n  }\n};\nexport { setupScrollAnimations };","map":{"version":3,"names":["setupScrollAnimations","els","Array","from","document","querySelectorAll","length","io","IntersectionObserver","entries","observer","forEach","entry","isIntersecting","container","target","classList","add","staggerChildren","child","i","style","transitionDelay","offsetHeight","unobserve","threshold","requestAnimationFrame","el","observe","e","all"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\components\\NexusComponent.vue"],"sourcesContent":["<template>\r\n  <main class=\"nexus-main container\" role=\"main\">\r\n\r\n    <section class=\"hero-section\" role=\"region\" aria-label=\"Presentación principal\">\r\n\r\n      <div class=\"hero-content\">\r\n\r\n        <h1 class=\"hero-title\">\r\n          Descubre el <span class=\"highlight\">futuro</span> de la lectura\r\n        </h1>\r\n        <p class=\"hero-subtitle\">\r\n          Una experiencia inmersiva donde la tecnología y la literatura\r\n          convergen\r\n        </p>\r\n\r\n        <div class=\"hero-actions\">\r\n          <button class=\"primary-btn btn\" onclick=\"showCollectionModal()\">\r\n            <i class=\"bi bi-collection\"></i> Explorar colección\r\n          </button>\r\n\r\n          <button class=\"secondary-btn btn\" onclick=\"showEventsModal()\">\r\n            <i class=\"bi bi-calendar-check\"></i> Próximos eventos\r\n          </button>\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </section>\r\n\r\n    <section class=\"carousel-section scroll-animation\">\r\n      <div class=\"section-header\">\r\n        <h2>Colección destacada</h2>\r\n      </div>\r\n      <div class=\"nexus-carousel position-relative overflow-hidden\">\r\n        <div class=\"recommendations-container\">\r\n          <div v-for=\"libro in librosDestacados\" :key=\"libro.id\" class=\"recommendation-card\">\r\n            <img :src=\"libro.portada\" :alt=\"'Portada de ' + libro.titulo\" class=\"book-cover\" />\r\n            <div class=\"book-info\">\r\n              <h3 class=\"book-title\">{{ libro.titulo }}</h3>\r\n              <p class=\"book-author\">{{ libro.autor }}</p>\r\n              <div class=\"book-meta\">\r\n                <span class=\"book-category\">{{ libro.categoria }}</span>\r\n                <span class=\"book-rating\">{{ '⭐'.repeat(libro.rating) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"features-section scroll-animation \" role=\"region\" aria-label=\"Características principales\">\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-telephone-plus fs-3\"></i>\r\n        </div>\r\n        <h3>Contacto</h3>\r\n        <p>Comunicate con nosotros a traves del correo: <a class=\"info-Correo\" href=\"#\">info@nexuslibrary.com</a> o deja\r\n          un comentario</p>\r\n      </div>\r\n\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-person-vcard fs-3\"></i>\r\n        </div>\r\n        <h3>Membresia <span class=\"premium\">VIP</span></h3>\r\n        <p>\r\n          Accede a contenido exclusivo, eventos privados y ofertas exclusivas.\r\n        </p>\r\n        <button class=\"btn primary-btn\" style=\"margin-top: 1.3rem;\" onclick=\"showMembershipModal()\">Únete ahora</button>\r\n      </div>\r\n\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-chat-left-dots fs-3\"></i>\r\n        </div>\r\n        <h3>Comunidad Nexus</h3>\r\n        <p>\r\n          Únete a nuestra comunidad de lectores y comparte tus opiniones y recomendaciones.\r\n        </p>\r\n\r\n        <button class=\"btn primary-btn\" onclick=\"showDiscordModal()\"> <i class=\"bi bi-discord\"></i> Unirte</button>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"newsletter-section scroll-animation\" role=\"region\" aria-label=\"Suscríbete a nuestro newsletter\">\r\n      <div class=\"newsletter-container\">\r\n        <div class=\"text\">\r\n          <p id=\"two\" class=\"fw-semibold\">Tu curiosidad nos inspira</p>\r\n          <p id=\"three\">Escríbenos sin temor para resolver tus dudas.</p>\r\n        </div>\r\n        <form class=\"newsletter-form\" action=\"#\" method=\"post\" novalidate>\r\n          <div>\r\n            <label for=\"nombre\" class=\"form-label visually-hidden\">Nombre</label>\r\n            <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Nombre\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa tu nombre.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"email\" class=\"form-label visually-hidden\">Email</label>\r\n            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Correo electrónico\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa un correo válido.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"telefono\" class=\"form-label visually-hidden\">Teléfono</label>\r\n            <input type=\"tel\" id=\"telefono\" name=\"telefono\" placeholder=\"Teléfono\" pattern=\"[0-9]{10,15}\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa un teléfono válido.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"mensaje\" class=\"form-label visually-hidden\">Mensaje</label>\r\n            <textarea id=\"mensaje\" name=\"mensaje\" placeholder=\"Mensaje\" rows=\"1\" required></textarea>\r\n            <div class=\"invalid-feedback\">Por favor, escribe tu mensaje.</div>\r\n          </div>\r\n          <div>\r\n            <button type=\"submit\" class=\"btn primary-btn px-4\" id=\"contact-btn\">¡Háblanos!</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </section>\r\n\r\n  </main>\r\n</template>\r\n\r\n<script>\r\n// Animaciones de scroll: añade la clase `animate-in` a secciones observadas\r\n// y hace un reveal escalonado (stagger) para cards internas (.feature-card y .recommendation-card).\r\nconst setupScrollAnimations = () => {\r\n  try {\r\n    const els = Array.from(document.querySelectorAll('.scroll-animation'));\r\n    if (!els.length) return;\r\n\r\n    const io = new IntersectionObserver((entries, observer) => {\r\n      entries.forEach(entry => {\r\n        if (!entry.isIntersecting) return;\r\n        const container = entry.target;\r\n\r\n        // Añadir clase al contenedor para animaciones CSS globales\r\n        container.classList.add('animate-in');\r\n\r\n        // Animar children con stagger si existen\r\n        const staggerChildren = container.querySelectorAll('.feature-card, .recommendation-card');\r\n        if (staggerChildren.length) {\r\n          staggerChildren.forEach((child, i) => {\r\n            // Limpiar cualquier inline style previo\r\n            child.style.transitionDelay = '';\r\n            // Forzar reflow para asegurar que la transición se aplica\r\n            // eslint-disable-next-line no-unused-expressions\r\n            child.offsetHeight;\r\n            child.style.transitionDelay = `${i * 80}ms`;\r\n            child.classList.add('animate-in');\r\n          });\r\n        }\r\n\r\n        // Dejar de observar este contenedor una vez animado\r\n        observer.unobserve(container);\r\n      });\r\n    }, { threshold: 0.12 });\r\n\r\n    // Esperar al siguiente frame para asegurar DOM y tamaños calculados\r\n    requestAnimationFrame(() => els.forEach(el => io.observe(el)));\r\n  } catch (e) {\r\n    // Fallback: si IntersectionObserver no está disponible, revelamos todo inmediatamente\r\n    const all = document.querySelectorAll('.scroll-animation');\r\n    all.forEach(container => {\r\n      container.classList.add('animate-in');\r\n      container.querySelectorAll('.feature-card, .recommendation-card').forEach((child, i) => {\r\n        child.style.transitionDelay = `${i * 80}ms`;\r\n        child.classList.add('animate-in');\r\n      });\r\n    });\r\n  }\r\n};\r\n\r\nexport { setupScrollAnimations };\r\n\r\n</script>\r\n\r\n\r\n<style src=\"../assets/estilosCss/style.css\"></style>\r\n<style src=\"../assets/estilosCss/books.css\"></style>"],"mappings":";;AA0HA;AACA;AACA,MAAMA,qBAAoB,GAAIA,CAAA,KAAM;EAClC,IAAI;IACF,MAAMC,GAAE,GAAIC,KAAK,CAACC,IAAI,CAACC,QAAQ,CAACC,gBAAgB,CAAC,mBAAmB,CAAC,CAAC;IACtE,IAAI,CAACJ,GAAG,CAACK,MAAM,EAAE;IAEjB,MAAMC,EAAC,GAAI,IAAIC,oBAAoB,CAAC,CAACC,OAAO,EAAEC,QAAQ,KAAK;MACzDD,OAAO,CAACE,OAAO,CAACC,KAAI,IAAK;QACvB,IAAI,CAACA,KAAK,CAACC,cAAc,EAAE;QAC3B,MAAMC,SAAQ,GAAIF,KAAK,CAACG,MAAM;;QAE9B;QACAD,SAAS,CAACE,SAAS,CAACC,GAAG,CAAC,YAAY,CAAC;;QAErC;QACA,MAAMC,eAAc,GAAIJ,SAAS,CAACT,gBAAgB,CAAC,qCAAqC,CAAC;QACzF,IAAIa,eAAe,CAACZ,MAAM,EAAE;UAC1BY,eAAe,CAACP,OAAO,CAAC,CAACQ,KAAK,EAAEC,CAAC,KAAK;YACpC;YACAD,KAAK,CAACE,KAAK,CAACC,eAAc,GAAI,EAAE;YAChC;YACA;YACAH,KAAK,CAACI,YAAY;YAClBJ,KAAK,CAACE,KAAK,CAACC,eAAc,GAAI,GAAGF,CAAA,GAAI,EAAE,IAAI;YAC3CD,KAAK,CAACH,SAAS,CAACC,GAAG,CAAC,YAAY,CAAC;UACnC,CAAC,CAAC;QACJ;;QAEA;QACAP,QAAQ,CAACc,SAAS,CAACV,SAAS,CAAC;MAC/B,CAAC,CAAC;IACJ,CAAC,EAAE;MAAEW,SAAS,EAAE;IAAK,CAAC,CAAC;;IAEvB;IACAC,qBAAqB,CAAC,MAAMzB,GAAG,CAACU,OAAO,CAACgB,EAAC,IAAKpB,EAAE,CAACqB,OAAO,CAACD,EAAE,CAAC,CAAC,CAAC;EAChE,EAAE,OAAOE,CAAC,EAAE;IACV;IACA,MAAMC,GAAE,GAAI1B,QAAQ,CAACC,gBAAgB,CAAC,mBAAmB,CAAC;IAC1DyB,GAAG,CAACnB,OAAO,CAACG,SAAQ,IAAK;MACvBA,SAAS,CAACE,SAAS,CAACC,GAAG,CAAC,YAAY,CAAC;MACrCH,SAAS,CAACT,gBAAgB,CAAC,qCAAqC,CAAC,CAACM,OAAO,CAAC,C