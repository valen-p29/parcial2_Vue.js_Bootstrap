{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nexport default {\n  name: 'NavbarComponent',\n  data() {\n    return {\n      searchOpen: false,\n      searchQuery: '',\n      cartCount: 0,\n      loginOpen: false,\n      username: '',\n      password: '',\n      loginError: ''\n    };\n  },\n  mounted() {\n    this.updateCartCount();\n    window.addEventListener('storage', this.updateCartCount);\n  },\n  beforeUnmount() {\n    window.removeEventListener('storage', this.updateCartCount);\n  },\n  methods: {\n    setCategory(category) {\n      window.dispatchEvent(new CustomEvent('set-category', {\n        detail: category\n      }));\n    },\n    toggleSearch() {\n      this.searchOpen = !this.searchOpen;\n      if (!this.searchOpen) {\n        this.searchQuery = '';\n        this.emitSearch();\n      }\n    },\n    closeSearch() {\n      this.searchOpen = false;\n      this.searchQuery = '';\n      this.emitSearch();\n    },\n    emitSearch() {\n      window.dispatchEvent(new CustomEvent('set-search', {\n        detail: this.searchQuery\n      }));\n    },\n    toggleCart() {\n      window.dispatchEvent(new CustomEvent('toggle-cart'));\n    },\n    updateCartCount() {\n      try {\n        const saved = localStorage.getItem('cart');\n        const cart = saved ? JSON.parse(saved) : [];\n        this.cartCount = cart.reduce((acc, it) => acc + (it.quantity || 1), 0);\n      } catch {\n        this.cartCount = 0;\n      }\n    },\n    openLogin() {\n      this.loginOpen = true;\n      this.username = '';\n      this.password = '';\n      this.loginError = '';\n    },\n    login() {\n      this.loginError = '';\n      const admin = {\n        username: 'admin',\n        password: 'admin123'\n      };\n      const user = {\n        username: 'valentina',\n        password: 'vale123'\n      };\n      if (this.username === admin.username && this.password === admin.password) {\n        localStorage.setItem('usuarioActivo', admin.username);\n        localStorage.setItem('userRole', 'admin');\n        this.loginOpen = false;\n        this.$router.push('/admin');\n        return;\n      }\n      if (this.username === user.username && this.password === user.password) {\n        localStorage.setItem('usuarioActivo', user.username);\n        localStorage.setItem('userRole', 'user');\n        this.loginOpen = false;\n        this.$router.push('/productos');\n        return;\n      }\n      this.loginError = 'Usuario o contraseña incorrectos';\n    }\n  }\n};","map":{"version":3,"names":["name","data","searchOpen","searchQuery","cartCount","loginOpen","username","password","loginError","mounted","updateCartCount","window","addEventListener","beforeUnmount","removeEventListener","methods","setCategory","category","dispatchEvent","CustomEvent","detail","toggleSearch","emitSearch","closeSearch","toggleCart","saved","localStorage","getItem","cart","JSON","parse","reduce","acc","it","quantity","openLogin","login","admin","user","setItem","$router","push"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\components\\NavbarComponent.vue"],"sourcesContent":["<template>\r\n\t<aside class=\"sidebar\">\r\n\t\t<div class=\"sidebar-brand\">\r\n\t\t\t<h2>FASHION STORE</h2>\r\n\t\t</div>\r\n\r\n\t\t<button class=\"btn-search\" @click=\"toggleSearch\" :aria-pressed=\"searchOpen\" title=\"Buscar\">\r\n\t\t\t<i class=\"bi bi-search\"></i>\r\n\t\t</button>\r\n\r\n\t\t<nav class=\"sidebar-nav\">\r\n\t\t\t<a href=\"#\" class=\"sidebar-link\" @click.prevent=\"setCategory('all')\">\r\n\t\t\t\t<i class=\"bi bi-grid\"></i>\r\n\t\t\t\t<span class=\"label\">Todos</span>\r\n\t\t\t</a>\r\n\t\t\t<a href=\"#\" class=\"sidebar-link\" @click.prevent=\"setCategory('hombre')\">\r\n\t\t\t\t<i class=\"bi bi-person\"></i>\r\n\t\t\t\t<span class=\"label\">Hombre</span>\r\n\t\t\t</a>\r\n\t\t\t<a href=\"#\" class=\"sidebar-link\" @click.prevent=\"setCategory('mujer')\">\r\n\t\t\t\t<i class=\"bi bi-gender-female\"></i>\r\n\t\t\t\t<span class=\"label\">Mujer</span>\r\n\t\t\t</a>\r\n\t\t\t<a href=\"#\" class=\"sidebar-link\" @click.prevent=\"setCategory('accesorios')\">\r\n\t\t\t\t<i class=\"bi bi-bag\"></i>\r\n\t\t\t\t<span class=\"label\">Accesorios</span>\r\n\t\t\t</a>\r\n\t\t</nav>\r\n\r\n\t\t<button class=\"btn-cart\" @click=\"toggleCart\" title=\"Carrito\">\r\n\t\t\t<i class=\"bi bi-cart3\"></i>\r\n\t\t\t<span class=\"cart-count\">{{ cartCount }}</span>\r\n\t\t\t<span class=\"label\">Carrito</span>\r\n\t\t</button>\r\n\r\n\t\t<button class=\"btn-login\" @click=\"openLogin\" title=\"Login\">\r\n\t\t\t<i class=\"bi bi-person-circle\"></i>\r\n\t\t\t<span class=\"label\">Entrar</span>\r\n\t\t</button>\r\n\r\n\t\t<!-- Search popover -->\r\n\t\t<div v-if=\"searchOpen\" class=\"search-container\" style=\"left: 260px; right: auto;\">\r\n\t\t\t<input v-model=\"searchQuery\" type=\"text\" class=\"search-input\" placeholder=\"Buscar productos, categorías...\"\r\n\t\t\t\t@input=\"emitSearch\" />\r\n\t\t\t<button class=\"search-close\" @click=\"closeSearch\" title=\"Cerrar\"><i class=\"bi bi-x-lg\"></i></button>\r\n\t\t</div>\r\n\r\n\t\t<!-- Login Modal -->\r\n\t\t<div v-if=\"loginOpen\" class=\"quickview-overlay\" @click.self=\"loginOpen = false\">\r\n\t\t\t<div class=\"quickview-card\" style=\"max-width:420px;width:90%\">\r\n\t\t\t\t<button class=\"quickview-close\" @click=\"loginOpen = false\">&times;</button>\r\n\t\t\t\t<div class=\"p-3\">\r\n\t\t\t\t\t<h3 style=\"margin-top:0\">Iniciar Sesión</h3>\r\n\t\t\t\t\t<div class=\"credentials-info\">\r\n\t\t\t\t\t\t<p><strong>Credenciales de prueba</strong></p>\r\n\t\t\t\t\t\t<p>admin / admin123</p>\r\n\t\t\t\t\t\t<p>valentina / vale123</p>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<form @submit.prevent=\"login\">\r\n\t\t\t\t\t\t<div class=\"form-group\">\r\n\t\t\t\t\t\t\t<input v-model.trim=\"username\" type=\"text\" placeholder=\"Usuario\" required />\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"form-group\">\r\n\t\t\t\t\t\t\t<input v-model=\"password\" type=\"password\" placeholder=\"Contraseña\" required />\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<button class=\"btn-primary btn-full\" type=\"submit\">Entrar</button>\r\n\t\t\t\t\t\t<div v-if=\"loginError\" class=\"login-error\" style=\"margin-top:10px\">\r\n\t\t\t\t\t\t\t<p>{{ loginError }}</p>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</form>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</aside>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n\tname: 'NavbarComponent',\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\tsearchOpen: false,\r\n\t\t\tsearchQuery: '',\r\n\t\t\tcartCount: 0,\r\n\t\t\tloginOpen: false,\r\n\t\t\tusername: '',\r\n\t\t\tpassword: '',\r\n\t\t\tloginError: ''\r\n\t\t}\r\n\t},\r\n\tmounted() {\r\n\t\tthis.updateCartCount()\r\n\t\twindow.addEventListener('storage', this.updateCartCount)\r\n\t},\r\n\tbeforeUnmount() {\r\n\t\twindow.removeEventListener('storage', this.updateCartCount)\r\n\t},\r\n\tmethods: {\r\n\t\tsetCategory(category) {\r\n\t\t\twindow.dispatchEvent(new CustomEvent('set-category', { detail: category }))\r\n\t\t},\r\n\t\ttoggleSearch() {\r\n\t\t\tthis.searchOpen = !this.searchOpen\r\n\t\t\tif (!this.searchOpen) {\r\n\t\t\t\tthis.searchQuery = ''\r\n\t\t\t\tthis.emitSearch()\r\n\t\t\t}\r\n\t\t},\r\n\t\tcloseSearch() {\r\n\t\t\tthis.searchOpen = false\r\n\t\t\tthis.searchQuery = ''\r\n\t\t\tthis.emitSearch()\r\n\t\t},\r\n\t\temitSearch() {\r\n\t\t\twindow.dispatchEvent(new CustomEvent('set-search', { detail: this.searchQuery }))\r\n\t\t},\r\n\t\ttoggleCart() {\r\n\t\t\twindow.dispatchEvent(new CustomEvent('toggle-cart'))\r\n\t\t},\r\n\t\tupdateCartCount() {\r\n\t\t\ttry {\r\n\t\t\t\tconst saved = localStorage.getItem('cart')\r\n\t\t\t\tconst cart = saved ? JSON.parse(saved) : []\r\n\t\t\t\tthis.cartCount = cart.reduce((acc, it) => acc + (it.quantity || 1), 0)\r\n\t\t\t} catch {\r\n\t\t\t\tthis.cartCount = 0\r\n\t\t\t}\r\n\t\t},\r\n\t\topenLogin() {\r\n\t\t\tthis.loginOpen = true\r\n\t\t\tthis.username = ''\r\n\t\t\tthis.password = ''\r\n\t\t\tthis.loginError = ''\r\n\t\t},\r\n\t\tlogin() {\r\n\t\t\tthis.loginError = ''\r\n\t\t\tconst admin = { username: 'admin', password: 'admin123' }\r\n\t\t\tconst user = { username: 'valentina', password: 'vale123' }\r\n\t\t\tif (this.username === admin.username && this.password === admin.password) {\r\n\t\t\t\tlocalStorage.setItem('usuarioActivo', admin.username)\r\n\t\t\t\tlocalStorage.setItem('userRole', 'admin')\r\n\t\t\t\tthis.loginOpen = false\r\n\t\t\t\tthis.$router.push('/admin')\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tif (this.username === user.username && this.password === user.password) {\r\n\t\t\t\tlocalStorage.setItem('usuarioActivo', user.username)\r\n\t\t\t\tlocalStorage.setItem('userRole', 'user')\r\n\t\t\t\tthis.loginOpen = false\r\n\t\t\t\tthis.$router.push('/productos')\r\n\t\t\t\treturn\r\n\t\t\t}\r\n\t\t\tthis.loginError = 'Usuario o contraseña incorrectos'\r\n\t\t}\r\n\t}\r\n}\r\n</script>\r\n"],"mappings":";;;AA6EA,eAAe;EACdA,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACN,OAAO;MACNC,UAAU,EAAE,KAAK;MACjBC,WAAW,EAAE,EAAE;MACfC,SAAS,EAAE,CAAC;MACZC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE;IACb;EACD,CAAC;EACDC,OAAOA,CAAA,EAAG;IACT,IAAI,CAACC,eAAe,CAAC;IACrBC,MAAM,CAACC,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACF,eAAe;EACxD,CAAC;EACDG,aAAaA,CAAA,EAAG;IACfF,MAAM,CAACG,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACJ,eAAe;EAC3D,CAAC;EACDK,OAAO,EAAE;IACRC,WAAWA,CAACC,QAAQ,EAAE;MACrBN,MAAM,CAACO,aAAa,CAAC,IAAIC,WAAW,CAAC,cAAc,EAAE;QAAEC,MAAM,EAAEH;MAAS,CAAC,CAAC;IAC3E,CAAC;IACDI,YAAYA,CAAA,EAAG;MACd,IAAI,CAACnB,UAAS,GAAI,CAAC,IAAI,CAACA,UAAS;MACjC,IAAI,CAAC,IAAI,CAACA,UAAU,EAAE;QACrB,IAAI,CAACC,WAAU,GAAI,EAAC;QACpB,IAAI,CAACmB,UAAU,CAAC;MACjB;IACD,CAAC;IACDC,WAAWA,CAAA,EAAG;MACb,IAAI,CAACrB,UAAS,GAAI,KAAI;MACtB,IAAI,CAACC,WAAU,GAAI,EAAC;MACpB,IAAI,CAACmB,UAAU,CAAC;IACjB,CAAC;IACDA,UAAUA,CAAA,EAAG;MACZX,MAAM,CAACO,aAAa,CAAC,IAAIC,WAAW,CAAC,YAAY,EAAE;QAAEC,MAAM,EAAE,IAAI,CAA