{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { signInWithEmailAndPassword } from \"firebase/auth\";\nimport { auth } from \"../firebase/config\";\nexport default {\n  name: \"LoginView\",\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      error: \"\"\n    };\n  },\n  methods: {\n    async login() {\n      this.error = \"\";\n      try {\n        await signInWithEmailAndPassword(auth, this.email, this.password);\n        localStorage.setItem(\"usuarioActivo\", this.email);\n        this.$router.push(\"/dashboard\");\n      } catch (err) {\n        if (err.code === \"auth/user-not-found\" || err.code === \"auth/wrong-password\") {\n          this.error = \"Correo o contraseña incorrectos\";\n        } else {\n          this.error = \"Error al iniciar sesión\";\n        }\n        console.error(err);\n      }\n    }\n  }\n};","map":{"version":3,"names":["signInWithEmailAndPassword","auth","name","data","email","password","error","methods","login","localStorage","setItem","$router","push","err","code","console"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\LoginView.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container d-flex justify-content-center align-items-center vh-100\">\r\n    <div class=\"card shadow p-4\" style=\"width: 22rem;\">\r\n      <h3 class=\"text-center mb-4\">Iniciar Sesión</h3>\r\n\r\n      <form @submit.prevent=\"login\">\r\n        <div class=\"mb-3\">\r\n          <label for=\"email\" class=\"form-label\">Correo electrónico</label>\r\n          <input\r\n            v-model=\"email\"\r\n            type=\"email\"\r\n            class=\"form-control\"\r\n            id=\"email\"\r\n            placeholder=\"Ingrese su correo\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div class=\"mb-3\">\r\n          <label for=\"password\" class=\"form-label\">Contraseña</label>\r\n          <input\r\n            v-model=\"password\"\r\n            type=\"password\"\r\n            class=\"form-control\"\r\n            id=\"password\"\r\n            placeholder=\"Ingrese su contraseña\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div v-if=\"error\" class=\"alert alert-danger py-2 text-center\">\r\n          {{ error }}\r\n        </div>\r\n\r\n        <button type=\"submit\" class=\"btn btn-primary w-100\">Entrar</button>\r\n\r\n        <p class=\"text-center mt-3\">\r\n          ¿No tienes cuenta?\r\n          <router-link to=\"/registro\">Regístrate aquí</router-link>\r\n        </p>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { signInWithEmailAndPassword } from \"firebase/auth\";\r\nimport { auth } from \"../firebase/config\";\r\n\r\nexport default {\r\n  name: \"LoginView\",\r\n  data() {\r\n    return {\r\n      email: \"\",\r\n      password: \"\",\r\n      error: \"\",\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      this.error = \"\";\r\n      try {\r\n        await signInWithEmailAndPassword(auth, this.email, this.password);\r\n        localStorage.setItem(\"usuarioActivo\", this.email);\r\n        this.$router.push(\"/dashboard\");\r\n      } catch (err) {\r\n        if (err.code === \"auth/user-not-found\" || err.code === \"auth/wrong-password\") {\r\n          this.error = \"Correo o contraseña incorrectos\";\r\n        } else {\r\n          this.error = \"Error al iniciar sesión\";\r\n        }\r\n        console.error(err);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  background: linear-gradient(155deg, #0a192f, #064375);\r\n}\r\n.card {\r\n  border-radius: 15px;\r\n}\r\n</style>\r\n"],"mappings":";AA8CA,SAASA,0BAAyB,QAAS,eAAe;AAC1D,SAASC,IAAG,QAAS,oBAAoB;AAEzC,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE;IACT,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,