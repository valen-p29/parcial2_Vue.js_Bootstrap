{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { Modal } from 'bootstrap';\nimport { db, auth } from '../firebase/config';\nimport { collection, getDocs, addDoc, updateDoc, deleteDoc, doc } from 'firebase/firestore';\nimport { signOut } from 'firebase/auth';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'AdminPanelView',\n  data() {\n    return {\n      books: [],\n      modal: null,\n      editMode: false,\n      newBook: {\n        title: '',\n        author: '',\n        stock: 0,\n        price: 0,\n        status: 'available',\n        discountPercentage: 0,\n        releaseDate: null,\n        imageUrl: ''\n      }\n    };\n  },\n  created() {\n    this.loadBooks();\n    this.router = useRouter();\n  },\n  mounted() {\n    this.modal = new Modal(document.getElementById('bookModal'));\n  },\n  methods: {\n    async loadBooks() {\n      try {\n        const booksCollection = collection(db, 'books');\n        const querySnapshot = await getDocs(booksCollection);\n        this.books = querySnapshot.docs.map(doc => ({\n          id: doc.id,\n          ...doc.data()\n        }));\n      } catch (error) {\n        console.error('Error al cargar libros:', error);\n        alert('Error al cargar los libros');\n      }\n    },\n    showAddBookModal() {\n      this.editMode = false;\n      this.newBook = {\n        title: '',\n        author: '',\n        stock: 0,\n        price: 0,\n        status: 'available',\n        discountPercentage: 0,\n        releaseDate: null,\n        imageUrl: ''\n      };\n      this.modal.show();\n    },\n    async updateStock(book) {\n      try {\n        // Actualizar stock en Firebase\n        console.log(`Actualizando stock: ${book.id} -> ${book.stock}`);\n        // await updateDoc(bookRef, { stock: book.stock })\n      } catch (error) {\n        console.error('Error al actualizar stock:', error);\n      }\n    },\n    async updateBook(book) {\n      try {\n        const bookRef = doc(db, 'books', book.id);\n        // Calcular precio con descuento si aplica\n        if (book.discountPercentage > 0) {\n          book.discountedPrice = book.price * (1 - book.discountPercentage / 100);\n        }\n        const bookData = {\n          ...book\n        };\n        delete bookData.id; // Removemos el id ya que es la referencia del documento\n\n        await updateDoc(bookRef, bookData);\n        console.log('Libro actualizado exitosamente');\n      } catch (error) {\n        console.error('Error al actualizar libro:', error);\n        alert('Error al actualizar el libro');\n      }\n    },\n    editBook(book) {\n      this.editMode = true;\n      this.newBook = {\n        ...book\n      };\n      this.modal.show();\n    },\n    async deleteBook(bookId) {\n      if (confirm('¿Estás seguro de que deseas eliminar este libro?')) {\n        try {\n          const bookRef = doc(db, 'books', bookId);\n          await deleteDoc(bookRef);\n          this.books = this.books.filter(b => b.id !== bookId);\n          console.log('Libro eliminado exitosamente');\n        } catch (error) {\n          console.error('Error al eliminar libro:', error);\n          alert('Error al eliminar el libro');\n        }\n      }\n    },\n    async cerrarSesion() {\n      try {\n        await signOut(auth);\n        this.router.push('/login');\n      } catch (error) {\n        console.error('Error al cerrar sesión:', error);\n      }\n    },\n    async saveBook() {\n      try {\n        // Validar precio y stock\n        if (this.newBook.price < 0 || this.newBook.stock < 0) {\n          alert('El precio y el stock no pueden ser negativos');\n          return;\n        }\n        if (this.newBook.id) {\n          // Actualizar libro existente\n          await this.updateBook(this.newBook);\n        } else {\n          // Crear nuevo libro\n          const newBookData = {\n            ...this.newBook,\n            createdAt: new Date().toISOString()\n          };\n          const booksCollection = collection(db, 'books');\n          await addDoc(booksCollection, newBookData);\n          console.log('Nuevo libro creado exitosamente');\n        }\n\n        // Cerrar modal y recargar lista\n        this.modal.hide();\n        await this.loadBooks();\n      } catch (error) {\n        console.error('Error al guardar libro:', error);\n        alert('Error al guardar el libro');\n      }\n    }\n  }\n};","map":{"version":3,"names":["Modal","db","auth","collection","getDocs","addDoc","updateDoc","deleteDoc","doc","signOut","useRouter","name","data","books","modal","editMode","newBook","title","author","stock","price","status","discountPercentage","releaseDate","imageUrl","created","loadBooks","router","mounted","document","getElementById","methods","booksCollection","querySnapshot","docs","map","id","error","console","alert","showAddBookModal","show","updateStock","book","log","updateBook","bookRef","discountedPrice","bookData","editBook","deleteBook","bookId","confirm","filter","b","cerrarSesion","push","saveBook","newBookData","createdAt","Date","toISOString","hide"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\AdminPanelView.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-panel\">\r\n    <!-- Barra de navegación admin -->\r\n    <nav class=\"navbar navbar-expand-lg navbar-dark bg-dark\">\r\n      <div class=\"container\">\r\n        <router-link class=\"navbar-brand\" to=\"/admin\">Panel de Admin</router-link>\r\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#adminNavbar\">\r\n          <span class=\"navbar-toggler-icon\"></span>\r\n        </button>\r\n        <div class=\"collapse navbar-collapse\" id=\"adminNavbar\">\r\n          <ul class=\"navbar-nav me-auto\">\r\n            <li class=\"nav-item\">\r\n              <router-link class=\"nav-link\" to=\"/\">Ver Dashboard</router-link>\r\n            </li>\r\n          </ul>\r\n          <ul class=\"navbar-nav\">\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link text-danger\" href=\"#\" @click.prevent=\"cerrarSesion\">\r\n                <i class=\"bi bi-box-arrow-right\"></i> Cerrar Sesión\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n\r\n    <div class=\"container py-4\">\r\n      <h1 class=\"mb-4\">Panel de Administración</h1>\r\n      \r\n      <!-- Tabla de gestión de libros -->\r\n      <div class=\"card\">\r\n        <div class=\"card-header d-flex justify-content-between align-items-center\">\r\n          <h3 class=\"mb-0\">Gestión de Stock</h3>\r\n          <button class=\"btn btn-primary\" @click=\"showAddBookModal\">\r\n            <i class=\"bi bi-plus-circle\"></i> Añadir Libro\r\n          </button>\r\n        </div>\r\n        <div class=\"card-body\">\r\n          <div class=\"table-responsive\">\r\n            <table class=\"table\">\r\n              <thead>\r\n                <tr>\r\n                  <th>ID</th>\r\n                  <th>Título</th>\r\n                  <th>Autor</th>\r\n                  <th>Stock</th>\r\n                  <th>Precio</th>\r\n                  <th>Estado</th>\r\n                  <th>Descuento</th>\r\n                  <th>Acciones</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr v-for=\"book in books\" :key=\"book.id\">\r\n                  <td>{{ book.id }}</td>\r\n                  <td>{{ book.title }}</td>\r\n                  <td>{{ book.author }}</td>\r\n                  <td>\r\n                    <input \r\n                      type=\"number\" \r\n                      v-model.number=\"book.stock\"\r\n                      class=\"form-control form-control-sm w-75\"\r\n                      min=\"0\"\r\n                      @change=\"updateStock(book)\"\r\n                    >\r\n                  </td>\r\n                  <td>\r\n                    <div class=\"input-group input-group-sm\">\r\n                      <span class=\"input-group-text\">$</span>\r\n                      <input \r\n                        type=\"number\" \r\n                        v-model.number=\"book.price\"\r\n                        class=\"form-control form-control-sm\"\r\n                        min=\"0\"\r\n                        step=\"0.01\"\r\n                        @change=\"updateBook(book)\"\r\n                      >\r\n                    </div>\r\n                  </td>\r\n                  <td>\r\n                    <select \r\n                      v-model=\"book.status\" \r\n                      class=\"form-select form-select-sm\"\r\n                      @change=\"updateBook(book)\"\r\n                    >\r\n                      <option value=\"available\">Disponible</option>\r\n                      <option value=\"upcoming\">Próximamente</option>\r\n                      <option value=\"outOfStock\">Agotado</option>\r\n                    </select>\r\n                  </td>\r\n                  <td>\r\n                    <div class=\"input-group input-group-sm\">\r\n                      <input \r\n                        type=\"number\" \r\n                        v-model.number=\"book.discountPercentage\"\r\n                        class=\"form-control form-control-sm\"\r\n                        min=\"0\"\r\n                        max=\"100\"\r\n                        @change=\"updateBook(book)\"\r\n                      >\r\n                      <span class=\"input-group-text\">%</span>\r\n                    </div>\r\n                  </td>\r\n                  <td>\r\n                    <button class=\"btn btn-sm btn-warning me-2\" @click=\"editBook(book)\">\r\n                      <i class=\"bi bi-pencil\"></i>\r\n                    </button>\r\n                    <button class=\"btn btn-sm btn-danger\" @click=\"deleteBook(book.id)\">\r\n                      <i class=\"bi bi-trash\"></i>\r\n                    </button>\r\n                  </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Modal para añadir/editar libro -->\r\n    <div class=\"modal fade\" id=\"bookModal\" tabindex=\"-1\" ref=\"bookModal\">\r\n      <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\">\r\n          <div class=\"modal-header\">\r\n            <h5 class=\"modal-title\">{{ editMode ? 'Editar' : 'Añadir' }} Libro</h5>\r\n            <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\"></button>\r\n          </div>\r\n          <div class=\"modal-body\">\r\n            <form @submit.prevent=\"saveBook\">\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Título</label>\r\n                <input v-model=\"newBook.title\" type=\"text\" class=\"form-control\" required>\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Autor</label>\r\n                <input v-model=\"newBook.author\" type=\"text\" class=\"form-control\" required>\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Precio</label>\r\n                <div class=\"input-group\">\r\n                  <span class=\"input-group-text\">$</span>\r\n                  <input v-model.number=\"newBook.price\" type=\"number\" step=\"0.01\" class=\"form-control\" required>\r\n                </div>\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Stock</label>\r\n                <input v-model.number=\"newBook.stock\" type=\"number\" class=\"form-control\" required>\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Estado</label>\r\n                <select v-model=\"newBook.status\" class=\"form-select\" required>\r\n                  <option value=\"available\">Disponible</option>\r\n                  <option value=\"upcoming\">Próximamente</option>\r\n                  <option value=\"outOfStock\">Agotado</option>\r\n                </select>\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">URL de la imagen</label>\r\n                <input v-model=\"newBook.imageUrl\" type=\"url\" class=\"form-control\" required>\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Descuento (%)</label>\r\n                <input v-model.number=\"newBook.discountPercentage\" type=\"number\" min=\"0\" max=\"100\" class=\"form-control\">\r\n              </div>\r\n              <div v-if=\"newBook.status === 'upcoming'\" class=\"mb-3\">\r\n                <label class=\"form-label\">Fecha de lanzamiento</label>\r\n                <input v-model=\"newBook.releaseDate\" type=\"date\" class=\"form-control\" required>\r\n              </div>\r\n              <div class=\"text-end\">\r\n                <button type=\"button\" class=\"btn btn-secondary me-2\" data-bs-dismiss=\"modal\">Cancelar</button>\r\n                <button type=\"submit\" class=\"btn btn-primary\">{{ editMode ? 'Actualizar' : 'Guardar' }}</button>\r\n              </div>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Modal } from 'bootstrap'\r\nimport { db, auth } from '../firebase/config'\r\nimport { collection, getDocs, addDoc, updateDoc, deleteDoc, doc } from 'firebase/firestore'\r\nimport { signOut } from 'firebase/auth'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'AdminPanelView',\r\n  data() {\r\n    return {\r\n      books: [],\r\n      modal: null,\r\n      editMode: false,\r\n      newBook: {\r\n        title: '',\r\n        author: '',\r\n        stock: 0,\r\n        price: 0,\r\n        status: 'available',\r\n        discountPercentage: 0,\r\n        releaseDate: null,\r\n        imageUrl: ''\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n    this.loadBooks()\r\n    this.router = useRouter()\r\n  },\r\n  mounted() {\r\n    this.modal = new Modal(document.getElementById('bookModal'))\r\n  },\r\n  methods: {\r\n    async loadBooks() {\r\n      try {\r\n        const booksCollection = collection(db, 'books')\r\n        const querySnapshot = await getDocs(booksCollection)\r\n        this.books = querySnapshot.docs.map(doc => ({\r\n          id: doc.id,\r\n          ...doc.data()\r\n        }))\r\n      } catch (error) {\r\n        console.error('Error al cargar libros:', error)\r\n        alert('Error al cargar los libros')\r\n      }\r\n    },\r\n    showAddBookModal() {\r\n      this.editMode = false;\r\n      this.newBook = {\r\n        title: '',\r\n        author: '',\r\n        stock: 0,\r\n        price: 0,\r\n        status: 'available',\r\n        discountPercentage: 0,\r\n        releaseDate: null,\r\n        imageUrl: ''\r\n      }\r\n      this.modal.show()\r\n    },\r\n    async updateStock(book) {\r\n      try {\r\n        // Actualizar stock en Firebase\r\n        console.log(`Actualizando stock: ${book.id} -> ${book.stock}`)\r\n        // await updateDoc(bookRef, { stock: book.stock })\r\n      } catch (error) {\r\n        console.error('Error al actualizar stock:', error)\r\n      }\r\n    },\r\n    async updateBook(book) {\r\n      try {\r\n        const bookRef = doc(db, 'books', book.id)\r\n        // Calcular precio con descuento si aplica\r\n        if (book.discountPercentage > 0) {\r\n          book.discountedPrice = book.price * (1 - book.discountPercentage / 100)\r\n        }\r\n        \r\n        const bookData = { ...book }\r\n        delete bookData.id // Removemos el id ya que es la referencia del documento\r\n        \r\n        await updateDoc(bookRef, bookData)\r\n        console.log('Libro actualizado exitosamente')\r\n      } catch (error) {\r\n        console.error('Error al actualizar libro:', error)\r\n        alert('Error al actualizar el libro')\r\n      }\r\n    },\r\n    editBook(book) {\r\n      this.editMode = true\r\n      this.newBook = { ...book }\r\n      this.modal.show()\r\n    },\r\n    async deleteBook(bookId) {\r\n      if (confirm('¿Estás seguro de que deseas eliminar este libro?')) {\r\n        try {\r\n          const bookRef = doc(db, 'books', bookId)\r\n          await deleteDoc(bookRef)\r\n          this.books = this.books.filter(b => b.id !== bookId)\r\n          console.log('Libro eliminado exitosamente')\r\n        } catch (error) {\r\n          console.error('Error al eliminar libro:', error)\r\n          alert('Error al eliminar el libro')\r\n        }\r\n      }\r\n    },\r\n\r\n    async cerrarSesion() {\r\n      try {\r\n        await signOut(auth)\r\n        this.router.push('/login')\r\n      } catch (error) {\r\n        console.error('Error al cerrar sesión:', error)\r\n      }\r\n    },\r\n    async saveBook() {\r\n      try {\r\n        // Validar precio y stock\r\n        if (this.newBook.price < 0 || this.newBook.stock < 0) {\r\n          alert('El precio y el stock no pueden ser negativos')\r\n          return\r\n        }\r\n\r\n        if (this.newBook.id) {\r\n          // Actualizar libro existente\r\n          await this.updateBook(this.newBook)\r\n        } else {\r\n          // Crear nuevo libro\r\n          const newBookData = {\r\n            ...this.newBook,\r\n            createdAt: new Date().toISOString()\r\n          }\r\n          const booksCollection = collection(db, 'books')\r\n          await addDoc(booksCollection, newBookData)\r\n          console.log('Nuevo libro creado exitosamente')\r\n        }\r\n\r\n        // Cerrar modal y recargar lista\r\n        this.modal.hide()\r\n        await this.loadBooks()\r\n      } catch (error) {\r\n        console.error('Error al guardar libro:', error)\r\n        alert('Error al guardar el libro')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.admin-panel {\r\n  background-color: #f8f9fa;\r\n  min-height: calc(100vh - 60px);\r\n}\r\n\r\n.table th {\r\n  background-color: #f1f1f1;\r\n}\r\n\r\n.form-control-sm {\r\n  width: 80px;\r\n}\r\n</style>"],"mappings":";;;;AAqLA,SAASA,KAAI,QAAS,WAAU;AAChC,SAASC,EAAE,EAAEC,IAAG,QAAS,oBAAmB;AAC5C,SAASC,UAAU,EAAEC,OAAO,EAAEC,MAAM,EAAEC,SAAS,EAAEC,SAAS,EAAEC,GAAE,QAAS,oBAAmB;AAC1F,SAASC,OAAM,QAAS,eAAc;AACtC,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,IAAI;MACXC,QAAQ,EAAE,KAAK;MACfC,OAAO,EAAE;QACPC,KAAK,EAAE,EAAE;QACTC,MAAM,EAAE,EAAE;QACVC,KAAK,EAAE,CAAC;QACRC,KAAK,EAAE,CAAC;QACRC,MAAM,EAAE,WAAW;QACnBC,kBAAkB,EAAE,CAAC;QACrBC,WAAW,EAAE,IAAI;QACjBC,QAAQ,EAAE;MACZ;IACF;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC;IACf,IAAI,CAACC,MAAK,GAAIjB,SAAS,CAAC;EAC1B,CAAC;EACDkB,OAAOA,CAAA,EAAG;IACR,IAAI,CAACd,KAAI,GAAI,IAAId,KAAK,CAAC6B,QAAQ,CAACC,cAAc,CAAC,WAAW,CAAC;EAC7D,CAAC;EACDC,OAAO,EAAE;IACP,MAAML,SAASA,CAAA,EAAG;MAChB,IAAI;QACF,MAAMM,eAAc,GAAI7B,UAAU,CAACF,EAAE,EAAE,OAAO;QAC9C,MAAMgC,aAAY,GAAI,MAAM7B,OAAO,CAAC4B,eAAe;QACnD,IAAI,CAACnB,KAAI,GAAIoB,aAAa,CAACC,IAAI,CAACC,GAAG,CAAC3B,GAAE,KAAM;UAC1C4B,EAAE,EAAE5B,GAAG,CAAC4B,EAAE;UACV,GAAG5B,GAAG,CAACI,IAAI,CAAC;QACd,CAAC,CAAC;MACJ,EAAE,OAAOyB,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK;QAC9CE,KAAK,CAAC,4BAA4B;MACpC;IACF,CAAC;IACDC,gBAAgBA,CAAA,EAAG;MACjB,IAAI,CAACzB,QAAO,GAAI,KAAK;MACrB,IAAI,CAACC,OAAM,GAAI;QACbC,KAAK,EAAE,EAAE;QACTC,MAAM,EAAE,EAAE;QACVC,KAAK,EAAE,CAAC;QACRC,KAAK,EAAE,CAAC;QACRC,MAAM,EAAE,WAAW;QACnBC,kBAAkB,EAAE,CAAC;QACrBC,WAAW,EAAE,IAAI;QACjBC,QAAQ,EAAE;MACZ;MACA,IAAI,CAACV,KAAK,CAAC2B,IAAI,CAAC;IAClB,CAAC;IACD,MAAMC,WAAWA,C