{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { analytics } from '../firebase/config';\nimport { logEvent } from 'firebase/analytics';\nexport default {\n  name: 'AdminPanelView',\n  data() {\n    return {\n      items: [],\n      formOpen: false,\n      editing: false,\n      showAnalytics: false,\n      analyticsData: {\n        pageViews: 0,\n        activeUsers: 0,\n        cartItems: 0\n      },\n      measurementId: 'G-GVM0JKHXDB',\n      form: {\n        id: '',\n        name: '',\n        category: 'hombre',\n        description: '',\n        price: 0,\n        stock: 0,\n        discount: 0,\n        image: ''\n      }\n    };\n  },\n  created() {\n    this.loadItems();\n  },\n  mounted() {\n    this.loadAnalyticsData();\n    // Registrar vista del panel de admin\n    if (analytics) {\n      logEvent(analytics, 'admin_panel_view');\n    }\n  },\n  methods: {\n    async loadItems() {\n      try {\n        const res = await fetch('/product.json');\n        if (!res.ok) throw new Error('No se pudo cargar /product.json');\n        const data = await res.json();\n        const products = data.products || [];\n        this.items = products.map(p => ({\n          id: String(p.id ?? Date.now() + Math.random()),\n          name: p.name || p.title || 'Sin nombre',\n          category: p.category || 'hombre',\n          description: p.description || '',\n          price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\n          stock: Number(p.stock ?? 10),\n          discount: Number(p.discount ?? 0),\n          image: p.image || ''\n        }));\n        this.saveItems();\n      } catch (err) {\n        console.error('Error al cargar productos en admin:', err);\n        // Fallback a localStorage si no se puede cargar el JSON\n        const saved = localStorage.getItem('admin_products');\n        if (saved) {\n          this.items = JSON.parse(saved);\n        } else {\n          this.items = [];\n        }\n      }\n    },\n    saveItems() {\n      // Guardar en localStorage como respaldo\n      localStorage.setItem('admin_products', JSON.stringify(this.items));\n    },\n    exportToJSON() {\n      // Convertir productos al formato del JSON original\n      const productsForJSON = this.items.map(p => ({\n        id: Number(p.id) || Date.now(),\n        name: p.name,\n        category: p.category,\n        price: Math.round(Number(p.price) * 100),\n        // Convertir a centavos como en el JSON original\n        image: p.image || '',\n        description: p.description || '',\n        stock: Number(p.stock) || 0,\n        discount: Number(p.discount) || 0\n      }));\n      const jsonData = {\n        products: productsForJSON\n      };\n\n      // Crear y descargar el archivo JSON\n      const dataStr = JSON.stringify(jsonData, null, 2);\n      const dataBlob = new Blob([dataStr], {\n        type: 'application/json'\n      });\n      const url = URL.createObjectURL(dataBlob);\n      const link = document.createElement('a');\n      link.href = url;\n      link.download = 'product.json';\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      URL.revokeObjectURL(url);\n      alert('JSON exportado exitosamente. Reemplaza el archivo public/product.json con el descargado.');\n    },\n    openForm(item) {\n      if (item) {\n        this.editing = true;\n        this.form = {\n          ...item\n        };\n      } else {\n        this.editing = false;\n        this.form = {\n          id: '',\n          name: '',\n          category: 'hombre',\n          description: '',\n          price: 0,\n          stock: 0,\n          discount: 0,\n          image: ''\n        };\n      }\n      this.formOpen = true;\n    },\n    closeForm() {\n      this.formOpen = false;\n    },\n    saveForm() {\n      if (!this.form.name) return;\n      if (this.editing) {\n        const idx = this.items.findIndex(i => i.id === this.form.id);\n        if (idx > -1) this.items.splice(idx, 1, {\n          ...this.form\n        });\n        if (analytics) {\n          logEvent(analytics, 'product_updated', {\n            product_id: this.form.id\n          });\n        }\n      } else {\n        this.form.id = String(Date.now());\n        this.items.push({\n          ...this.form\n        });\n        if (analytics) {\n          logEvent(analytics, 'product_created', {\n            product_id: this.form.id\n          });\n        }\n      }\n      this.saveItems();\n      this.formOpen = false;\n    },\n    removeItem(id) {\n      if (!confirm('¿Eliminar este producto?')) return;\n      this.items = this.items.filter(i => i.id !== id);\n      this.saveItems();\n      if (analytics) {\n        logEvent(analytics, 'product_deleted', {\n          product_id: id\n        });\n      }\n    },\n    loadAnalyticsData() {\n      // Obtener datos del carrito para analytics\n      try {\n        const cart = localStorage.getItem('cart');\n        if (cart) {\n          const cartItems = JSON.parse(cart);\n          this.analyticsData.cartItems = cartItems.reduce((acc, item) => acc + (item.quantity || 1), 0);\n        }\n      } catch (err) {\n        console.error('Error cargando datos del carrito:', err);\n      }\n\n      // Obtener usuarios activos (simulado - en producción usarías la API de Analytics)\n      const activeUsers = localStorage.getItem('activeUsers') || 0;\n      this.analyticsData.activeUsers = activeUsers;\n\n      // Obtener vistas de página (simulado)\n      const pageViews = parseInt(localStorage.getItem('pageViews') || '0') + 1;\n      localStorage.setItem('pageViews', pageViews.toString());\n      this.analyticsData.pageViews = pageViews;\n\n      // Registrar evento en Firebase Analytics\n      if (analytics) {\n        logEvent(analytics, 'analytics_viewed', {\n          cart_items: this.analyticsData.cartItems,\n          page_views: this.analyticsData.pageViews\n        });\n      }\n    },\n    cerrarSesion() {\n      localStorage.removeItem('usuarioActivo');\n      localStorage.removeItem('userRole');\n      if (analytics) {\n        logEvent(analytics, 'admin_logout');\n      }\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["analytics","logEvent","name","data","items","formOpen","editing","showAnalytics","analyticsData","pageViews","activeUsers","cartItems","measurementId","form","id","category","description","price","stock","discount","image","created","loadItems","mounted","loadAnalyticsData","methods","res","fetch","ok","Error","json","products","map","p","String","Date","now","Math","random","title","parseFloat","Number","saveItems","err","console","error","saved","localStorage","getItem","JSON","parse","setItem","stringify","exportToJSON","productsForJSON","round","jsonData","dataStr","dataBlob","Blob","type","url","URL","createObjectURL","link","document","createElement","href","download","body","appendChild","click","removeChild","revokeObjectURL","alert","openForm","item","closeForm","saveForm","idx","findIndex","i","splice","product_id","push","removeItem","confirm","filter","cart","reduce","acc","quantity","parseInt","toString","cart_items","page_views","cerrarSesion","$router"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\views\\AdminPanelView.vue"],"sourcesContent":["<template class=\"adminp\">\r\n\t<div class=\"admin-panel container py-4\">\r\n\t\t<nav class=\"d-flex justify-content-between align-items-center mb-4\"\r\n\t\t\tstyle=\"border-bottom:1px solid var(--border-color);padding-bottom:0.75rem\">\r\n\t\t\t<h2\r\n\t\t\t\tstyle=\"background:var(--gradient);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin:0\">\r\n\t\t\t\tPanel de Administración</h2>\r\n\t\t\t<div>\r\n\t\t\t\t<button class=\"btn btn-outline-info me-2\" @click=\"showAnalytics = !showAnalytics\">\r\n\t\t\t\t\t<i class=\"bi bi-graph-up me-1\"></i> Analytics\r\n\t\t\t\t</button>\r\n\t\t\t\t<button class=\"btn btn-outline-secondary me-2\" @click=\"$router.push('/productos')\"><i\r\n\t\t\t\t\t\tclass=\"bi bi-shop me-1\"></i> Ir a tienda</button>\r\n\t\t\t\t<button class=\"btn btn-danger\" @click=\"cerrarSesion\"><i class=\"bi bi-box-arrow-right me-1\"></i> Cerrar\r\n\t\t\t\t\tsesión</button>\r\n\t\t\t</div>\r\n\t\t</nav>\r\n\r\n\t\t<!-- Panel De Analytics View User -->\r\n\t\t<div v-if=\"showAnalytics\" class=\"analytics-panel mb-4\">\r\n\t\t\t<div class=\"card\">\r\n\t\t\t\t<div class=\"card-header bg-primary text-white\">\r\n\t\t\t\t\t<h5 class=\"mb-0\"><i class=\"bi bi-graph-up me-2\"></i>Firebase Analytics</h5>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"card-body\">\r\n\t\t\t\t\t<div class=\"row g-3\">\r\n\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t<div class=\"stat-card\">\r\n\t\t\t\t\t\t\t\t<div class=\"stat-icon bg-primary\">\r\n\t\t\t\t\t\t\t\t\t<i class=\"bi bi-eye\"></i>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div class=\"stat-info\">\r\n\t\t\t\t\t\t\t\t\t<h6>Vistas de Página</h6>\r\n\t\t\t\t\t\t\t\t\t<p class=\"stat-value\">{{ analyticsData.pageViews || 'N/A' }}</p>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t<div class=\"stat-card\">\r\n\t\t\t\t\t\t\t\t<div class=\"stat-icon bg-success\">\r\n\t\t\t\t\t\t\t\t\t<i class=\"bi bi-people\"></i>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div class=\"stat-info\">\r\n\t\t\t\t\t\t\t\t\t<h6>Usuarios Activos</h6>\r\n\t\t\t\t\t\t\t\t\t<p class=\"stat-value\">{{ analyticsData.activeUsers || 'N/A' }}</p>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t<div class=\"stat-card\">\r\n\t\t\t\t\t\t\t\t<div class=\"stat-icon bg-warning\">\r\n\t\t\t\t\t\t\t\t\t<i class=\"bi bi-cart-check\"></i>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div class=\"stat-info\">\r\n\t\t\t\t\t\t\t\t\t<h6>Productos en Carrito</h6>\r\n\t\t\t\t\t\t\t\t\t<p class=\"stat-value\">{{ analyticsData.cartItems || 0 }}</p>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"mt-4\">\r\n\t\t\t\t\t\t<h6>Información de Analytics</h6>\r\n\t\t\t\t\t\t<p class=\"text-muted small\">\r\n\t\t\t\t\t\t\tPara ver datos detallados de Firebase Analytics, visita el \r\n\t\t\t\t\t\t\t<a href=\"https://console.firebase.google.com/project/dexapp-8e56c/analytics\" \r\n\t\t\t\t\t\t\ttarget=\"_blank\" class=\"text-primary\">Firebase Console</a>.\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t<p class=\"text-muted small mb-0\">\r\n\t\t\t\t\t\t\t<strong>Measurement ID:</strong> {{ measurementId }}\r\n\t\t\t\t\t\t</p>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2\">\r\n\t\t\t<div class=\"d-flex gap-2\">\r\n\t\t\t\t<button class=\"btn btn-primary\" @click=\"openForm()\"><i class=\"bi bi-plus-circle me-1\"></i> Añadir\r\n\t\t\t\t\tproducto</button>\r\n\t\t\t\t<button class=\"btn btn-success\" @click=\"exportToJSON\"><i class=\"bi bi-download me-1\"></i> Exportar JSON</button>\r\n\t\t\t</div>\r\n\t\t\t<small class=\"text-muted\">Gestiona stock, precio y descuentos</small>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"table-responsive\">\r\n\t\t\t<table class=\"table table-dark table-striped align-middle\" style=\"border:1px solid var(--border-color)\">\r\n\t\t\t\t<thead>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<th>ID</th>\r\n\t\t\t\t\t\t<th>Nombre</th>\r\n\t\t\t\t\t\t<th>Categoría</th>\r\n\t\t\t\t\t\t<th>Stock</th>\r\n\t\t\t\t\t\t<th>Precio</th>\r\n\t\t\t\t\t\t<th>Descuento (%)</th>\r\n\t\t\t\t\t\t<th>Precio Final</th>\r\n\t\t\t\t\t\t<th>Acciones</th>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</thead>\r\n\t\t\t\t<tbody>\r\n\t\t\t\t\t<tr v-for=\"p in items\" :key=\"p.id\">\r\n\t\t\t\t\t\t<td>{{ p.id }}</td>\r\n\t\t\t\t\t\t<td>{{ p.name }}</td>\r\n\t\t\t\t\t\t<td>{{ p.category }}</td>\r\n\t\t\t\t\t\t<td>{{ p.stock }}</td>\r\n\t\t\t\t\t\t<td>${{ Number(p.price).toFixed(2) }}</td>\r\n\t\t\t\t\t\t<td>{{ p.discount }}</td>\r\n\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t${{ (Number(p.price) * (1 - (Number(p.discount || 0) / 100))).toFixed(2) }}\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t<button class=\"btn btn-sm btn-warning me-2\" @click=\"openForm(p)\"><i\r\n\t\t\t\t\t\t\t\t\tclass=\"bi bi-pencil-square\"></i></button>\r\n\t\t\t\t\t\t\t<button class=\"btn btn-sm btn-danger\" @click=\"removeItem(p.id)\"><i\r\n\t\t\t\t\t\t\t\t\tclass=\"bi bi-trash3\"></i></button>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</tbody>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\r\n\t\t<!-- Fo -->\r\n\t\t<div v-if=\"formOpen\" class=\"quickview-overlay\" @click.self=\"closeForm\">\r\n\t\t\t<div class=\"quickview-card\" style=\"max-width:640px;width:90%\">\r\n\t\t\t\t<button class=\"quickview-close\" @click=\"closeForm\"><i class=\"bi bi-x-lg\"></i></button>\r\n\t\t\t\t<div class=\"p-3\">\r\n\t\t\t\t\t<h4 style=\"margin-top:0\">{{ editing ? 'Editar producto' : 'Añadir producto' }}</h4>\r\n\t\t\t\t\t<form @submit.prevent=\"saveForm\">\r\n\t\t\t\t\t\t<div class=\"row g-3\">\r\n\t\t\t\t\t\t\t<div class=\"col-md-6\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Nombre</label>\r\n\t\t\t\t\t\t\t\t<input v-model.trim=\"form.name\" type=\"text\" class=\"form-control\" required>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-6\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Categoría</label>\r\n\t\t\t\t\t\t\t\t<select v-model=\"form.category\" class=\"form-select\" required>\r\n\t\t\t\t\t\t\t\t\t<option value=\"hombre\">Hombre</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"mujer\">Mujer</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"accesorios\">Accesorios</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Precio</label>\r\n\t\t\t\t\t\t\t\t<input v-model.number=\"form.price\" type=\"number\" step=\"0.01\" min=\"0\"\r\n\t\t\t\t\t\t\t\t\tclass=\"form-control\" required>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Stock</label>\r\n\t\t\t\t\t\t\t\t<input v-model.number=\"form.stock\" type=\"number\" min=\"0\" class=\"form-control\" required>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Descuento (%)</label>\r\n\t\t\t\t\t\t\t\t<input v-model.number=\"form.discount\" type=\"number\" min=\"0\" max=\"100\"\r\n\t\t\t\t\t\t\t\t\tclass=\"form-control\">\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-12\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Imagen (URL)</label>\r\n\t\t\t\t\t\t\t\t<input v-model.trim=\"form.image\" type=\"url\" class=\"form-control\"\r\n\t\t\t\t\t\t\t\t\tplaceholder=\"https://...\">\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"d-flex justify-content-end gap-2 mt-3\">\r\n\t\t\t\t\t\t\t<button type=\"button\" class=\"btn btn-outline-secondary\" @click=\"closeForm\">Cancelar</button>\r\n\t\t\t\t\t\t\t<button type=\"submit\" class=\"btn btn-primary\">Guardar</button>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</form>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nimport { analytics } from '../firebase/config'\r\nimport { logEvent } from 'firebase/analytics'\r\n\r\nexport default {\r\n\tname: 'AdminPanelView',\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\titems: [],\r\n\t\t\tformOpen: false,\r\n\t\t\tediting: false,\r\n\t\t\tshowAnalytics: false,\r\n\t\t\tanalyticsData: {\r\n\t\t\t\tpageViews: 0,\r\n\t\t\t\tactiveUsers: 0,\r\n\t\t\t\tcartItems: 0\r\n\t\t\t},\r\n\t\t\tmeasurementId: 'G-GVM0JKHXDB',\r\n\t\t\tform: {\r\n\t\t\t\tid: '',\r\n\t\t\t\tname: '',\r\n\t\t\t\tcategory: 'hombre',\r\n\t\t\t\tdescription: '',\r\n\t\t\t\tprice: 0,\r\n\t\t\t\tstock: 0,\r\n\t\t\t\tdiscount: 0,\r\n\t\t\t\timage: ''\r\n\t\t\t}\r\n\t\t}\r\n\t},\r\n\tcreated() {\r\n\t\tthis.loadItems()\r\n\t},\r\n\tmounted() {\r\n\t\tthis.loadAnalyticsData()\r\n\t\t// Registrar vista del panel de admin\r\n\t\tif (analytics) {\r\n\t\t\tlogEvent(analytics, 'admin_panel_view')\r\n\t\t}\r\n\t},\r\n\tmethods: {\r\n\t\tasync loadItems() {\r\n\t\t\ttry {\r\n\t\t\t\tconst res = await fetch('/product.json')\r\n\t\t\t\tif (!res.ok) throw new Error('No se pudo cargar /product.json')\r\n\t\t\t\tconst data = await res.json()\r\n\t\t\t\tconst products = data.products || []\r\n\t\t\t\tthis.items = products.map(p => ({\r\n\t\t\t\t\tid: String(p.id ?? Date.now() + Math.random()),\r\n\t\t\t\t\tname: p.name || p.title || 'Sin nombre',\r\n\t\t\t\t\tcategory: p.category || 'hombre',\r\n\t\t\t\t\tdescription: p.description || '',\r\n\t\t\t\t\tprice: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\r\n\t\t\t\t\tstock: Number(p.stock ?? 10),\r\n\t\t\t\t\tdiscount: Number(p.discount ?? 0),\r\n\t\t\t\t\timage: p.image || ''\r\n\t\t\t\t}))\r\n\t\t\t\tthis.saveItems()\r\n\t\t\t} catch (err) {\r\n\t\t\t\tconsole.error('Error al cargar productos en admin:', err)\r\n\t\t\t\t// Fallback a localStorage si no se puede cargar el JSON\r\n\t\t\t\tconst saved = localStorage.getItem('admin_products')\r\n\t\t\t\tif (saved) {\r\n\t\t\t\t\tthis.items = JSON.parse(saved)\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.items = []\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\tsaveItems() {\r\n\t\t\t// Guardar en localStorage como respaldo\r\n\t\t\tlocalStorage.setItem('admin_products', JSON.stringify(this.items))\r\n\t\t},\r\n\t\texportToJSON() {\r\n\t\t\t// Convertir productos al formato del J