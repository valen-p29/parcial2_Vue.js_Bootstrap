{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { onAuthStateChanged, signOut } from \"firebase/auth\";\nimport { auth } from \"../firebase/config\";\nimport NavbarComponent from \"../components/NavbarComponent.vue\";\nimport NexusComponent from \"@/components/NexusComponent.vue\";\nimport FooterComponent from \"../components/FooterComponent.vue\";\nexport default {\n  name: \"DashboardView\",\n  components: {\n    NavbarComponent,\n    NexusComponent,\n    FooterComponent\n  },\n  data() {\n    return {\n      isAuthenticated: false,\n      isAdmin: false,\n      user: null\n    };\n  },\n  mounted() {\n    // Observa cambios en la autenticación\n    onAuthStateChanged(auth, user => {\n      this.isAuthenticated = !!user;\n      if (user) {\n        this.user = user;\n        // Aquí puedes verificar si es admin (mismo criterio que en el router)\n        this.isAdmin = user.email === \"admin@nexuslibrary.com\";\n      } else {\n        this.user = null;\n        this.isAdmin = false;\n      }\n    });\n  },\n  methods: {\n    async logout() {\n      await signOut(auth);\n      localStorage.removeItem(\"usuarioActivo\");\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["onAuthStateChanged","signOut","auth","NavbarComponent","NexusComponent","FooterComponent","name","components","data","isAuthenticated","isAdmin","user","mounted","email","methods","logout","localStorage","removeItem","$router","push"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\DashboardView.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard d-flex\">\r\n    <!-- Contenido principal -->\r\n    <div class=\"main-content flex-grow-1\">\r\n      <NavbarComponent />\r\n      <NexusComponent />\r\n\r\n      <div>\r\n        <router-view />\r\n       <FooterComponent />\r\n      </div>\r\n    </div>\r\n\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { onAuthStateChanged, signOut } 