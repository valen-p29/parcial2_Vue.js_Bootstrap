{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nexport default {\n  name: 'MainComponent',\n  data() {\n    return {\n      products: [],\n      showQuickView: false,\n      selectedProduct: null,\n      currentFilter: 'all',\n      searchQuery: '',\n      showDiscountsModal: false,\n      cart: []\n    };\n  },\n  mounted() {\n    this.loadProducts();\n    window.addEventListener('set-category', this.onSetCategory);\n    window.addEventListener('set-search', this.onSetSearch);\n    window.addEventListener('toggle-cart', this.onToggleCart);\n    window.addEventListener('cart-updated', this.loadCart);\n    window.addEventListener('storage', this.loadCart);\n    this.loadCart();\n  },\n  beforeUnmount() {\n    window.removeEventListener('set-category', this.onSetCategory);\n    window.removeEventListener('set-search', this.onSetSearch);\n    window.removeEventListener('toggle-cart', this.onToggleCart);\n    window.removeEventListener('cart-updated', this.loadCart);\n    window.removeEventListener('storage', this.loadCart);\n  },\n  computed: {\n    visibleProducts() {\n      const q = (this.searchQuery || '').toLowerCase().trim();\n      return this.products.filter(p => {\n        const matchesCategory = this.currentFilter === 'all' || (p.author || p.category || '').toLowerCase() === this.currentFilter;\n        const matchesQuery = !q || [p.title, p.name, p.author, p.category, p.description].filter(Boolean).some(v => String(v).toLowerCase().includes(q));\n        return matchesCategory && matchesQuery;\n      });\n    },\n    discountedProducts() {\n      return this.products.filter(p => Number(p.discount || 0) > 0);\n    }\n  },\n  methods: {\n    async loadProducts() {\n      try {\n        const savedAdmin = localStorage.getItem('admin_products');\n        if (savedAdmin) {\n          const items = JSON.parse(savedAdmin);\n          this.products = items.map(p => ({\n            id: String(p.id),\n            title: p.name,\n            author: p.category,\n            description: p.description || '',\n            price: Number(p.price) || 0,\n            image: p.image || null,\n            stock: Number(p.stock ?? 0),\n            discount: Number(p.discount ?? 0)\n          }));\n        } else {\n          const res = await fetch('/product.json');\n          if (!res.ok) throw new Error('No se pudo cargar /product.json');\n          const data = await res.json();\n          const products = data.products || [];\n          this.products = products.map(p => ({\n            id: String(p.id),\n            title: p.name || p.title || 'Sin título',\n            author: p.category || 'Desconocido',\n            description: p.description || '',\n            price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\n            image: p.image || null,\n            stock: Number(p.stock ?? 0),\n            discount: Number(p.discount ?? 0)\n          }));\n        }\n      } catch (err) {\n        console.error('Error cargando productos en MainComponent:', err);\n      }\n    },\n    openDiscountsModal() {\n      this.showDiscountsModal = true;\n    },\n    closeDiscountsModal() {\n      this.showDiscountsModal = false;\n    },\n    setFilter(f) {\n      this.currentFilter = f;\n    },\n    onSetCategory(e) {\n      this.currentFilter = e.detail || 'all';\n      const el = document.querySelectorAll('.filter-btn');\n      if (el && el.length) {\n        // visual state handled by :class, nothing to do\n      }\n    },\n    onSetSearch(e) {\n      this.searchQuery = e.detail || '';\n    },\n    onToggleCart() {\n      const sidebar = document.getElementById('cartSidebar');\n      if (sidebar) {\n        sidebar.classList.toggle('active');\n      }\n    },\n    formatPrice(val) {\n      if (typeof val !== 'number') return val;\n      return val.toFixed(2);\n    },\n    getPlaceholder() {\n      return 'data:image/svg+xml;base64,';\n    },\n    discountedPrice(p) {\n      const d = Number(p.discount || 0);\n      if (!d) return Number(p.price || 0);\n      return Number(p.price || 0) * (1 - d / 100);\n    },\n    viewProduct() {\n      this.$router.push({\n        name: 'Products'\n      });\n    },\n    openQuickView(p) {\n      this.selectedProduct = p;\n      this.showQuickView = true;\n    },\n    closeQuickView() {\n      this.showQuickView = false;\n      this.selectedProduct = null;\n    },\n    addToCart(product) {\n      try {\n        const saved = localStorage.getItem('cart');\n        const cart = saved ? JSON.parse(saved) : [];\n        const idx = cart.findIndex(i => i.id === product.id);\n        if (idx > -1) {\n          cart[idx].quantity = (cart[idx].quantity || 1) + 1;\n        } else {\n          cart.push({\n            ...product,\n            quantity: 1\n          });\n        }\n        localStorage.setItem('cart', JSON.stringify(cart));\n        // notify others in same tab\n        window.dispatchEvent(new CustomEvent('cart-updated'));\n        // also trigger native storage event by writing to localStorage (already did)\n        // small feedback\n        alert(`\"${product.title}\" agregado al carrito`);\n      } catch (err) {\n        console.error('Error al agregar al carrito:', err);\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","products","showQuickView","selectedProduct","currentFilter","searchQuery","showDiscountsModal","cart","mounted","loadProducts","window","addEventListener","onSetCategory","onSetSearch","onToggleCart","loadCart","beforeUnmount","removeEventListener","computed","visibleProducts","q","toLowerCase","trim","filter","p","matchesCategory","author","category","matchesQuery","title","description","Boolean","some","v","String","includes","discountedProducts","Number","discount","methods","savedAdmin","localStorage","getItem","items","JSON","parse","map","id","price","image","stock","res","fetch","ok","Error","json","parseFloat","err","console","error","openDiscountsModal","closeDiscountsModal","setFilter","f","e","detail","el","document","querySelectorAll","length","sidebar","getElementById","classList","toggle","formatPrice","val","toFixed","getPlaceholder","discountedPrice","d","viewProduct","$router","push","openQuickView","closeQuickView","addToCart","product","saved","idx","findIndex","i","quantity","setItem","stringify","dispatchEvent","CustomEvent","alert"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\components\\MainComponent.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <section class=\"hero\">\r\n      <div class=\"hero-background\">\r\n        <img\r\n          src=\"https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80\"\r\n          alt=\"Fashion Store\" class=\"hero-bg-image\">\r\n        <div class=\"hero-overlay\"></div>\r\n      </div>\r\n      <div class=\"hero-content\">\r\n        <h2 class=\"hero-title\">Nueva Colección</h2>\r\n        <p class=\"hero-subtitle\">Descubre las últimas tendencias en moda</p>\r\n        <button class=\"btn-primary\" id=\"viewCollectionBtn\" @click=\"openDiscountsModal\">Ver Colección</button>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"products-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section-header\">\r\n          <h3>Productos Destacados</h3>\r\n          <div class=\"filters\">\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'all' }\" @click=\"setFilter('all')\">Todos</button>\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'hombre' }\"\r\n              @click=\"setFilter('hombre')\">Hombre</button>\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'mujer' }\"\r\n              @click=\"setFilter('mujer')\">Mujer</button>\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'accesorios' }\"\r\n              @click=\"setFilter('accesorios')\">Accesorios</button>\r\n          </div>\r\n        </div>\r\n        <div class=\"products-grid\" id=\"productsGrid\">\r\n          <div class=\"product-card\" v-for=\"p in visibleProducts\" :key=\"p.id\">\r\n            <div class=\"product-image\">\r\n              <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n              <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n            </div>\r\n            <div class=\"product-info\">\r\n              <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n              <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n              <p class=\"product-price\">\r\n                <span v-if=\"p.discount && p.discount > 0\"\r\n                  style=\"color:#b8b8b8;text-decoration:line-through;margin-right:8px\">\r\n                  ${{ formatPrice(p.price) }}\r\n                </span>\r\n                <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n              </p>\r\n              <p class=\"product-desc\">{{ p.description }}</p>\r\n              <div class=\"product-actions\">\r\n                <button class=\"btn btn-outline-secondary me-2\" @click=\"openQuickView(p)\">Ver detalle</button>\r\n                <button class=\"btn btn-primary\" @click=\"addToCart(p)\">Añadir al carrito</button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- Login Modal -->\r\n    <div class=\"modal\" id=\"loginModal\">\r\n      <div class=\"modal-content\">\r\n        <span class=\"close\">&times;</span>\r\n        <div class=\"auth-container\">\r\n          <form class=\"auth-form\" id=\"loginForm\">\r\n            <h3>Iniciar Sesión</h3>\r\n            <div class=\"credentials-info\">\r\n              <p><strong>Credenciales de prueba:</strong></p>\r\n              <p>Email: <code>admin@fashionstore.com</code></p>\r\n              <p>Contraseña: <code>admin123</code></p>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <input type=\"email\" id=\"loginEmail\" placeholder=\"Correo electrónico\" required>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <input type=\"password\" id=\"loginPassword\" placeholder=\"Contraseña\" required>\r\n            </div>\r\n            <button type=\"submit\" class=\"btn-primary btn-full\">Ingresar</button>\r\n            <div class=\"login-error\" id=\"loginError\" style=\"display: none;\">\r\n              <p>Credenciales incorrectas. Usa las credenciales de prueba.</p>\r\n            </div>\r\n          </form>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Quick View Modal (reactive) -->\r\n    <div v-if=\"showQuickView\" class=\"quickview-overlay\" @click.self=\"closeQuickView\">\r\n      <div class=\"quickview-card\">\r\n        <button class=\"quickview-close\" @click=\"closeQuickView\"><i class=\"bi bi-x-lg\"></i></button>\r\n        <div class=\"quickview-body\">\r\n          <div class=\"quickview-left\">\r\n            <img :src=\"selectedProduct.image || getPlaceholder()\" :alt=\"selectedProduct.title\" />\r\n          </div>\r\n          <div class=\"quickview-right\">\r\n            <h3>{{ selectedProduct.title }}</h3>\r\n            <p class=\"text-muted\">{{ selectedProduct.author }}</p>\r\n            <p class=\"quickview-price\">${{ formatPrice(selectedProduct.price) }}</p>\r\n            <p>{{ selectedProduct.description }}</p>\r\n            <div class=\"mt-3\" style=\"display:flex;justify-content:center;gap:0.75rem\">\r\n              <button class=\"btn btn-primary\" @click=\"addToCart(selectedProduct)\"><i class=\"bi bi-bag-plus me-1\"></i>\r\n                Añadir al carrito</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Collection Modal -->\r\n    <div v-if=\"showDiscountsModal\" class=\"quickview-overlay\" @click.self=\"closeDiscountsModal\">\r\n      <div class=\"quickview-card collection-modal-content\" style=\"max-width:1000px\">\r\n        <button class=\"quickview-close\" @click=\"closeDiscountsModal\"><i class=\"bi bi-x-lg\"></i></button>\r\n        <div class=\"collection-container\">\r\n          <h2>Productos con Descuento</h2>\r\n          <div class=\"products-grid\">\r\n            <div class=\"product-card\" v-for=\"p in discountedProducts\" :key=\"p.id\">\r\n              <div class=\"product-image\">\r\n                <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n                <img :src=\"p.image || getPlaceholder()\" :alt=\"p.title\" />\r\n              </div>\r\n              <div class=\"product-info\">\r\n                <h4 class=\"product-title\">{{ p.title }}</h4>\r\n                <p class=\"product-category\">{{ p.author }}</p>\r\n                <p class=\"product-price\">\r\n                  <span style=\"color:#b8b8b8;text-decoration:line-through;margin-right:8px\">\r\n                    ${{ formatPrice(p.price) }}\r\n                  </span>\r\n                  <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n                </p>\r\n                <div class=\"product-actions\" style=\"justify-content:center\">\r\n                  <button class=\"btn btn-primary\" @click=\"addToCart(p)\"><i class=\"bi bi-bag-plus me-1\"></i>\r\n                    Añadir</button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Cart Sidebar -->\r\n    <div class=\"cart-sidebar\" id=\"cartSidebar\">\r\n      <div class=\"cart-header\">\r\n        <h3>Carrito de Compras</h3>\r\n        <button class=\"close-cart\">&times;</button>\r\n      </div>\r\n      <div class=\"cart-items\" id=\"cartItems\">\r\n        <!-- Cart items will be dynamically loaded here -->\r\n      </div>\r\n      <div class=\"cart-footer\">\r\n        <div class=\"cart-total\">\r\n          <span>Total:</span>\r\n          <span id=\"cartTotal\">$0.00</span>\r\n        </div>\r\n        <button class=\"btn-primary btn-full\">Proceder al Pago</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MainComponent',\r\n  data() {\r\n    return {\r\n      products: []\r\n      , showQuickView: false\r\n      , selectedProduct: null\r\n      , currentFilter: 'all'\r\n      , searchQuery: ''\r\n      , showDiscountsModal: false\r\n      , cart: []\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadProducts()\r\n    window.addEventListener('set-category', this.onSetCategory)\r\n    window.addEventListener('set-search', this.onSetSearch)\r\n    window.addEventListener('toggle-cart', this.onToggleCart)\r\n    window.addEventListener('cart-updated', this.loadCart)\r\n    window.addEventListener('storage', this.loadCart)\r\n    this.loadCart()\r\n  },\r\n  beforeUnmount() {\r\n    window.removeEventListener('set-category', this.onSetCategory)\r\n    window.removeEventListener('set-search', this.onSetSearch)\r\n    window.removeEventListener('toggle-cart', this.onToggleCart)\r\n    window.removeEventListener('cart-updated', this.loadCart)\r\n    window.removeEventListener('storage', this.loadCart)\r\n  },\r\n  computed: {\r\n    visibleProducts() {\r\n      const q = (this.searchQuery || '').toLowerCase().trim()\r\n      return this.products.filter(p => {\r\n        const matchesCategory = this.currentFilter === 'all' || (p.author || p.category || '').toLowerCase() === this.currentFilter\r\n        const matchesQuery = !q || [\r\n          p.title, p.name, p.author, p.category, p.description\r\n        ].filter(Boolean).some(v => String(v).toLowerCase().includes(q))\r\n        return matchesCategory && matchesQuery\r\n      })\r\n    },\r\n    discountedProducts() {\r\n      return this.products.filter(p => Number(p.discount || 0) > 0)\r\n    }\r\n  },\r\n  methods: {\r\n    async loadProducts() {\r\n      try {\r\n        const savedAdmin = localStorage.getItem('admin_products')\r\n        if (savedAdmin) {\r\n          const items = JSON.parse(savedAdmin)\r\n          this.products = items.map(p => ({\r\n            id: String(p.id),\r\n            title: p.name,\r\n            author: p.category,\r\n            description: p.description || '',\r\n            price: Number(p.price) || 0,\r\n            image: p.image || null,\r\n            stock: Number(p.stock ?? 0),\r\n            discount: Number(p.discount ?? 0)\r\n          }))\r\n        } else {\r\n          const res = await fetch('/product.json')\r\n          if (!res.ok) throw new Error('No se pudo cargar /product.json')\r\n          const data = await res.json()\r\n          const products = data.products || []\r\n          this.products = products.map(p => ({\r\n            id: String(p.id),\r\n            title: p.name || p.title || 'Sin título',\r\n            author: p.category || 'Desconocido',\r\n            description: p.description || '',\r\n            price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\r\n            image: p.image || null,\r\n            stock: Number(p.stock ?? 0),\r\n            discount: Number(p.discount ?? 0)\r\n          }))\r\n        }\r\n      } catch (err) {\r\n        console.error('Error cargando productos en MainComponent:', err)\r\n      }\r\n    },\r\n    openDiscountsModal() {\r\n      this.showDiscountsModal = true\r\n    },\r\n    closeDiscountsModal() {\r\n      this.showDiscountsModal = false\r\n    },\r\n    setFilter(f) {\r\n      this.currentFilter = f\r\n    },\r\n    onSetCategory(e) {\r\n      this.currentFilter = e.detail || 'all'\r\n      const el = document.querySelectorAll('.filter-btn')\r\n      if (el && el.length) {\r\n        // visual state handled by :class, nothing to do\r\n      }\r\n    },\r\n    onSetSearch(e) {\r\n      this.searchQuery = e.detail || ''\r\n    },\r\n    onToggleCart() {\r\n      const sidebar = document.getElementById('cartSidebar')\r\n      if (sidebar) {\r\n        sidebar.classList.toggle('active')\r\n      }\r\n    },\r\n    formatPrice(val) {\r\n      if (typeof val !== 'number') return val\r\n      return val.toFixed(2)\r\n    },\r\n    getPlaceholder() {\r\n      return 'data:image/svg+xml;base64,'\r\n    },\r\n    discountedPrice(p) {\r\n      const d = Number(p.discount || 0)\r\n      if (!d) return Number(p.price || 0)\r\n      return Number(p.price || 0) * (1 - d / 100)\r\n    },\r\n    viewProduct() {\r\n      this.$router.push({ name: 'Products' })\r\n    },\r\n    openQuickView(p) {\r\n      this.selectedProduct = p\r\n      this.showQuickView = true\r\n    },\r\n    closeQuickView() {\r\n      this.showQuickView = false\r\n      this.selectedProduct = null\r\n    },\r\n    addToCart(product) {\r\n      try {\r\n        const saved = localStorage.getItem('cart')\r\n        const cart = saved ? JSON.parse(saved) : []\r\n        const idx = cart.findIndex(i => i.id === product.id)\r\n        if (idx > -1) {\r\n          cart[idx].quantity = (cart[idx].quantity || 1) + 1\r\n        } else {\r\n          cart.push({ ...product, quantity: 1 })\r\n        }\r\n        localStorage.setItem('cart', JSON.stringify(cart))\r\n        // notify others in same tab\r\n        window.dispatchEvent(new CustomEvent('cart-updated'))\r\n        // also trigger native storage event by writing to localStorage (already did)\r\n        // small feedback\r\n        alert(`\"${product.title}\" agregado al carrito`)\r\n      } catch (err) {\r\n        console.error('Error al agregar al carrito:', err)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;AA+JA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAC;MACTC,aAAa,EAAE,KAAI;MACnBC,eAAe,EAAE,IAAG;MACpBC,aAAa,EAAE,KAAI;MACnBC,WAAW,EAAE,EAAC;MACdC,kBAAkB,EAAE,KAAI;MACxBC,IAAI,EAAE;IACV;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC;IAClBC,MAAM,CAACC,gBAAgB,CAAC,cAAc,EAAE,IAAI,CAACC,aAAa;IAC1DF,MAAM,CAACC,gBAAgB,CAAC,YAAY,EAAE,IAAI,CAACE,WAAW;IACtDH,MAAM,CAACC,gBAAgB,CAAC,aAAa,EAAE,IAAI,CAACG,YAAY;IACxDJ,MAAM,CAACC,gBAAgB,CAAC,cAAc,EAAE,IAAI,CAACI,QAAQ;IACrDL,MAAM,CAACC,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACI,QAAQ;IAChD,IAAI,CAACA,QAAQ,CAAC;EAChB,CAAC;EACDC,aAAaA,CAAA,EAAG;IACdN,MAAM,CAACO,mBAAmB,CAAC,cAAc,EAAE,IAAI,CAACL,aAAa;IAC7DF,MAAM,CAACO,mBAAmB,CAAC,YAAY,EAAE,IAAI,CAACJ,WAAW;IACzDH,MAAM,CAACO,mBAAmB,CAAC,aAAa,EAAE,IAAI,CAACH,YAAY;IAC3DJ,MAAM,CAACO,mBAAmB,CAAC,cAAc,EAAE,IAAI,CAACF,QAAQ;IACxDL,MAAM,CAACO,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACF,QAAQ;EACrD,CAAC;EACDG,QAAQ,EAAE;IACRC,eAAeA,CAAA,EAAG;MAChB,MAAMC,CAAA,GAAI,CAAC,IAAI,CAACf,WAAU,IAAK,EAAE,EAAEgB,WAAW,CAAC,CAAC,CAACC,IAAI,CAAC;MACtD,OAAO,IAAI,CAACrB,QAAQ,CAACsB,MAAM,CAACC,CAAA,IAAK;QAC/B,MAAMC,eAAc,GAAI,IAAI,CAACrB,aAAY,KAAM,KAAI,IAAK,CAACoB,CAAC,CAACE,MAAK,IAAKF,CAAC,CAACG,QAAO,IAAK,EAAE,EAAEN,WAAW,CAAC,MAAM,IAAI,CAACjB,aAAY;QAC1H,MAAMwB,YAAW,GAAI,CAACR,CAAA,IAAK,CACzBI,CAAC,CAACK,KAAK,EAAEL,CAAC,CAACzB,IAAI,EAAEyB,CAAC,CAACE,MAAM,EAAEF,CAAC,CAACG,QAAQ,EAAEH,CAAC,CAACM,WAAU,CACpD,CAACP,MAAM,CAACQ,OAAO,CAAC,CAACC,IAAI,CAACC,CAAA,IAAKC,MAAM,CAACD,CAAC,CAAC,CAACZ,WAAW,CAAC,CAAC,CAACc,QAAQ,CAACf,CAAC,CAAC;QAC/D,OAAOK,eAAc,IAAKG,YAAW;MACvC,CAAC;IACH,CAAC;IACDQ,kBAAkBA,CAAA,EAAG;MACnB,OAAO,IAAI,CAACnC,QAAQ,CAACsB,MAAM,CAACC,CAAA,IAAKa,MAAM,CAACb,CAAC,CAACc,QAAO,IAAK,CAAC,IAAI,CAAC;IAC9D;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAM9B,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAM+B,UAAS,GAAIC,YAAY,CAACC,OAAO,CAAC,gBAAgB;QACxD,IAAIF,UAAU,EAAE;UACd,MAAMG,KAAI,GAAIC,IAAI,CAACC,KAAK,CAACL,UAAU;UACnC,IAAI,CAACvC,QAAO,GAAI0C,KAAK,CAACG,GAAG,CAAC