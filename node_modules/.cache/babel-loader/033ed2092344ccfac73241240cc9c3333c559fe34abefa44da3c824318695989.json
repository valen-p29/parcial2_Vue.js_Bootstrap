\", _hoisted_14, \"$\" + _toDisplayString(book.discountedPrice), 1 /* TEXT */)])), _createElementVNode(\"button\", {\n      class: \"btn btn-primary w-100\",\n      onClick: $event => $options.addToCart(book)\n    }, \" Añadir al carrito \", 8 /* PROPS */, _hoisted_15)])])]);\n  }), 128 /* KEYED_FRAGMENT */))])]), _createCommentVNode(\" Sección de próximos lanzamientos \"), $options.upcomingBooks.length ? (_openBlock(), _createElementBlock(\"section\", _hoisted_16, [_cache[2] || (_cache[2] = _createElementVNode(\"h2\", {\n    class: \"section-title\"\n  }, \"Próximamente\", -1 /* CACHED */)), _createElementVNode(\"div\", _hoisted_17, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($options.upcomingBooks, book => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: book.id,\n      class: \"col-md-3\"\n    }, [_createElementVNode(\"div\", _hoisted_18, [_cache[1] || (_cache[1] = _createElementVNode(\"div\", {\n      class: \"coming-soon-badge\"\n    }, \"Próximamente\", -1 /* CACHED */)), _createElementVNode(\"img\", {\n      src: book.imageUrl || 'placeholder.jpg',\n      class: \"card-img-top\",\n      alt: book.title\n    }, null, 8 /* PROPS */, _hoisted_19), _createElementVNode(\"div\", _hoisted_20, [_createElementVNode(\"h5\", _hoisted_21, _toDisplayString(book.title), 1 /* TEXT */), _createElementVNode(\"p\", _hoisted_22, _toDisplayString(book.author), 1 /* TEXT */), _createElementVNode(\"p\", _hoisted_23, [_createElementVNode(\"small\", _hoisted_24, \"Disponible: \" + _toDisplayString($options.formatDate(book.releaseDate)), 1 /* TEXT */)]), _createElementVNode(\"button\", {\n      class: \"btn btn-outline-primary w-100\",\n      onClick: $event => $options.notifyMe(book)\n    }, \" Notificarme \", 8 /* PROPS */, _hoisted_25)])])]);\n  }), 128 /* KEYED_FRAGMENT */))])])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" Sección de ofertas \"), $options.discountedBooks.length ? (_openBlock(), _createElementBlock(\"section\", _hoisted_26, [_cache[3] || (_cache[3] = _createElementVNode(\"h2\", {\n    class: \"section-title\"\n  }, \"Ofertas Especiales\", -1 /* CACHED */)), _createElementVNode(\"div\", _hoisted_27, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($options.discountedBooks, book => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: book.id,\n      class: \"col-md-3\"\n    }, [_createElementVNode(\"div\", _hoisted_28, [_createElementVNode(\"div\", _hoisted_29, \"-\" + _toDisplayString(book.discountPercentage) + \"%\", 1 /* TEXT */), _createElementVNode(\"img\", {\n      src: book.imageUrl || 'placeholder.jpg',\n      class: \"card-img-top\",\n      alt: book.title\n    }, null, 8 /* PROPS */, _hoisted_30), _createElementVNode(\"div\", _hoisted_31, [_createElementVNode(\"h5\", _hoisted_32, _toDisplayString(book.title), 1 /* TEXT */), _createElementVNode(\"p\", _hoisted_33, _toDisplayString(book.author), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_34, [_createElementVNode(\"span\", _hoisted_35, \"$\" + _toDisplayString(book.price), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_36, \"$\" + _toDisplayString(book.discountedPrice), 1 /* TEXT */)]), _createElementVNode(\"button\", {\n      class: \"btn btn-primary w-100\",\n      onClick: $event => $options.addToCart(book)\n    }, \" Añadir al carrito \", 8 /* PROPS */, _hoisted_37)])])]);\n  }), 128 /* KEYED_FRAGMENT */))])])) : _createCommentVNode(\"v-if\", true)]), _createVNode(_component_FooterComponent)])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_createVNode","_component_NavbarComponent","_hoisted_3","_hoisted_4","_hoisted_5","_Fragment","_renderList","$options","availableBooks","book","key","id","_hoisted_6","src","imageUrl","alt","title","_hoisted_8","_hoisted_9","_toDisplayString","_hoisted_10","author","discountPercentage","_hoisted_11","price","_hoisted_12","_hoisted_13","_hoisted_14","discountedPrice","onClick","$event","addToCart","_hoisted_15","upcomingBooks","length","_hoisted_16","_hoisted_17","_hoisted_18","_hoisted_20","_hoisted_21","_hoisted_22","_hoisted_23","_hoisted_24","formatDate","releaseDate","notifyMe","_hoisted_25","discountedBooks","_hoisted_26","_hoisted_27","_hoisted_28","_hoisted_29","_hoisted_31","_hoisted_32","_hoisted_33","_hoisted_34","_hoisted_35","_hoisted_36","_hoisted_37","_component_FooterComponent"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\ProductsView.vue"],"sourcesContent":["<template>\r\n  <div class=\"products-view d-flex\">\r\n    <!-- Contenido principal -->\r\n    <div class=\"main-content flex-grow-1\">\r\n      <NavbarComponent />\r\n      \r\n      <div class=\"products-container container py-4\">\r\n        <!-- Sección de libros disponibles -->\r\n        <section class=\"mb-5\">\r\n          <h2 class=\"section-title\">Libros Disponibles</h2>\r\n          <div class=\"row g-4\">\r\n            <div v-for=\"book in availableBooks\" :key=\"book.id\" class=\"col-md-3\">\r\n              <div class=\"card h-100\">\r\n                <img :src=\"book.imageUrl || 'placeholder.jpg'\" class=\"card-img-top\" :alt=\"book.title\">\r\n                <div class=\"card-body\">\r\n                  <h5 class=\"card-title\">{{ book.title }}</h5>\r\n                  <p class=\"card-text\">{{ book.author }}</p>\r\n                  <p v-if=\"!book.discountPercentage\" class=\"card-text fw-bold\">${{ book.price }}</p>\r\n                  <div v-else class=\"price-container\">\r\n                    <span class=\"original-price\">${{ book.price }}</span>\r\n                    <span class=\"discounted-price\">${{ book.discountedPrice }}</span>\r\n                  </div>\r\n                  <button class=\"btn btn-primary w-100\" @click=\"addToCart(book)\">\r\n                    Añadir al carrito\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- Sección de próximos lanzamientos -->\r\n        <section v-if=\"upcomingBooks.length\" class=\"mb-5\">\r\n          <h2 class=\"section-title\">Próximamente</h2>\r\n          <div class=\"row g-4\">\r\n            <div v-for=\"book in upcomingBooks\" :key=\"book.id\" class=\"col-md-3\">\r\n              <div class=\"card h-100\">\r\n                <div class=\"coming-soon-badge\">Próximamente</div>\r\n                <img :src=\"book.imageUrl || 'placeholder.jpg'\" class=\"card-img-top\" :alt=\"book.title\">\r\n                <div class=\"card-body\">\r\n                  <h5 class=\"card-title\">{{ book.title }}</h5>\r\n                  <p class=\"card-text\">{{ book.author }}</p>\r\n                  <p class=\"card-text\">\r\n                    <small class=\"text-muted\">Disponible: {{ formatDate(book.releaseDate) }}</small>\r\n                  </p>\r\n                  <button class=\"btn btn-outline-primary w-100\" @click=\"notifyMe(book)\">\r\n                    Notificarme\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- Sección de ofertas -->\r\n        <section v-if=\"discountedBooks.length\" class=\"mb-5\">\r\n          <h2 class=\"section-title\">Ofertas Especiales</h2>\r\n          <div class=\"row g-4\">\r\n            <div v-for=\"book in discountedBooks\" :key=\"book.id\" class=\"col-md-3\">\r\n              <div class=\"card h-100\">\r\n                <div class=\"discount-badge\">-{{ book.discountPercentage }}%</div>\r\n                <img :src=\"book.imageUrl || 'placeholder.jpg'\" class=\"card-img-top\" :alt=\"book.title\">\r\n                <div class=\"card-body\">\r\n                  <h5 class=\"card-title\">{{ book.title }}</h5>\r\n                  <p class=\"card-text\">{{ book.author }}</p>\r\n                  <div class=\"price-container\">\r\n                    <span class=\"original-price\">${{ book.price }}</span>\r\n                    <span class=\"discounted-price\">${{ book.discountedPrice }}</span>\r\n                  </div>\r\n                  <button class=\"btn btn-primary w-100\" @click=\"addToCart(book)\">\r\n                    Añadir al carrito\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </section>\r\n      </div>\r\n      \r\n      <FooterComponent />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport NavbarComponent from \"../components/NavbarComponent.vue\";\r\nimport FooterComponent from \"../components/FooterComponent.vue\";\r\nimport { db } from \"../firebase/config\";\r\nimport { collection, getDocs } from \"firebase/firestore\";\r\n\r\nexport default {\r\n  name: \"ProductsView\",\r\n  components: {\r\n    NavbarComponent,\r\n    FooterComponent,\r\n  },\r\n  data() {\r\n    return {\r\n      books: [],\r\n      cart: [],\r\n      notifications: []\r\n    };\r\n  },\r\n  computed: {\r\n    availableBooks() {\r\n      return this.books.filter(book => \r\n        book.status === 'available' && \r\n        book.stock > 0 && \r\n        book.discountPercentage === 0\r\n      );\r\n    },\r\n    upcomingBooks() {\r\n      return this.books.filter(book => book.status === 'upcoming');\r\n    },\r\n    discountedBooks() {\r\n      return this.books.filter(book => \r\n        book.status === 'available' && \r\n        book.stock > 0 && \r\n        book.discountPercentage > 0\r\n      );\r\n    }\r\n  },\r\n  created() {\r\n    this.loadBooks();\r\n  },\r\n  methods: {\r\n    async loadBooks() {\r\n      try {\r\n        const booksCollection = collection(db, 'books');\r\n        const querySnapshot = await getDocs(booksCollection);\r\n        \r\n        this.books = querySnapshot.docs.map(doc => {\r\n          const data = doc.data();\r\n          const bookData = {\r\n            id: doc.id,\r\n            ...data\r\n          };\r\n          \r\n          // Convertir Timestamp de Firestore a Date si es necesario\r\n          if (bookData.releaseDate && bookData.releaseDate.toDate) {\r\n            bookData.releaseDate = bookData.releaseDate.toDate();\r\n          } else if (bookData.releaseDate && typeof bookData.releaseDate === 'string') {\r\n            bookData.releaseDate = new Date(bookData.releaseDate);\r\n          }\r\n          \r\n          // Calcular precio con descuento si existe\r\n          if (bookData.discountPercentage && bookData.discountPercentage > 0) {\r\n            bookData.discountedPrice = parseFloat(\r\n              (bookData.price * (1 - bookData.discountPercentage / 100)).toFixed(2)\r\n            );\r\n          } else {\r\n            bookData.discountedPrice = bookData.price;\r\n          }\r\n          \r\n          // Asegurar que discountPercentage tenga un valor por defecto\r\n          if (!bookData.discountPercentage) {\r\n            bookData.discountPercentage = 0;\r\n          }\r\n          \r\n          // Asegurar que stock tenga un valor por defecto\r\n          if (bookData.stock === undefined || bookData.stock === null) {\r\n            bookData.stock = 0;\r\n          }\r\n          \r\n          return bookData;\r\n        });\r\n        \r\n        console.log('Libros cargados desde Firestore:', this.books.length);\r\n      } catch (error) {\r\n        console.error('Error al cargar los libros desde Firestore:', error);\r\n        // Mostrar mensaje de error al usuario\r\n        alert('Error al cargar los libros. Por favor, intenta de nuevo más tarde.');\r\n      }\r\n    },\r\n    formatDate(date) {\r\n      return new Date(date).toLocaleDateString('es-ES', {\r\n        year: 'numeric',\r\n        month: 'long',\r\n        day: 'numeric'\r\n      });\r\n    },\r\n    addToCart(book) {\r\n      // Implementar lógica del carrito\r\n      this.cart.push(book);\r\n      console.log('Libro añadido al carrito:', book.title);\r\n    },\r\n    notifyMe(book) {\r\n      // Implementar sistema de notificaciones\r\n      this.notifications.push({\r\n        bookId: book.id,\r\n        userId: 'currentUserId', // Obtener del estado de autenticación\r\n        email: 'user@email.com' // Obtener del estado de autenticación\r\n      });\r\n      console.log('Te notificaremos cuando esté disponible:', book.title);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.products-view {\r\n  width: 100%;\r\n  min-height: 100vh;\r\n}\r\n\r\n.main-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: 100%;\r\n}\r\n\r\n.products-container {\r\n  flex: 1;\r\n  width: 100%;\r\n  padding: 2rem 1rem;\r\n}\r\n\r\n.section-title {\r\n  font-family: \"Orbitron\", \"Montserrat\", sans-serif;\r\n  font-weight: 700;\r\n  font-size: 2.5rem;\r\n  background: linear-gradient(135deg, var(--text-primary), var(--accent-color));\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  margin-bottom: 2rem;\r\n  position: relative;\r\n  text-align: center;\r\n}\r\n\r\n.section-title::after {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: -10px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 100px;\r\n  height: 3px;\r\n  background: linear-gradient(90deg, var(--accent-color), var(--accent-secondary));\r\n  border-radius: 2px;\r\n}\r\n\r\n.card {\r\n  background: var(--glass-effect);\r\n  border: 2px solid var(--glass-border);\r\n  border-radius: 12px;\r\n  backdrop-filter: blur(10px);\r\n  transition: all 0.3s ease;\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.card:hover {\r\n  transform: translateY(-8px);\r\n  box-shadow: 0 15px 40px rgba(76, 201, 240, 0.3);\r\n  border-color: var(--accent-color);\r\n}\r\n\r\n.card-img-top {\r\n  max-height: 250px;\r\n  object-fit: contain;\r\n  width: 100%;\r\n  padding: 1rem;\r\n}\r\n\r\n.card-body {\r\n  padding: 1.5rem;\r\n}\r\n\r\n.card-title {\r\n  color: var(--text-primary);\r\n  font-weight: 600;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.card-text {\r\n  color: var(--text-secondary);\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.price-container {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 1rem;\r\n  margin: 1rem 0;\r\n}\r\n\r\n.original-price {\r\n  color: var(--text-secondary);\r\n  text-decoration: line-through;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n.discounted-price {\r\n  color: var(--accent-color);\r\n  font-weight: 700;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.coming-soon-badge {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  background: linear-gradient(135deg, var(--accent-color), var(--hover-btn));\r\n  color: var(--primary-bg);\r\n  padding: 0.5rem 1rem;\r\n  border-radius: 20px;\r\n  font-size: 0.8rem;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n  z-index: 1;\r\n}\r\n\r\n.discount-badge {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  background: linear-gradient(135deg, var(--accent-secondary), #8b2fc9);\r\n  color: white;\r\n  padding: 0.5rem 1rem;\r\n  border-radius: 20px;\r\n  font-size: 0.9rem;\r\n  font-weight: 700;\r\n  z-index: 1;\r\n}\r\n\r\n.btn-primary {\r\n  background: linear-gradient(135deg, var(--accent-color), var(--hover-btn));\r\n  color: var(--primary-bg);\r\n  border: none;\r\n  box-shadow: 0 4px 15px rgba(76, 201, 240, 0.3);\r\n}\r\n\r\n.btn-primary:hover {\r\n  background: linear-gradient(135deg, var(--hover-btn), var(--accent-color));\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 8px 25px rgba(76, 201, 240, 0.5);\r\n  color: var(--primary-bg);\r\n}\r\n\r\n.btn-outline-primary {\r\n  background: transparent;\r\n  color: var(--accent-color);\r\n  border: 2px solid var(--accent-color);\r\n  backdrop-filter: blur(10px);\r\n}\r\n\r\n.btn-outline-primary:hover {\r\n  background: rgba(76, 201, 240, 0.15);\r\n  transform: translateY(-2px);\r\n  b