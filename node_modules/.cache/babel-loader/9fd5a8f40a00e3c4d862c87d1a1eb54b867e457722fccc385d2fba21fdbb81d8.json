{"ast":null,"code":"","map":{"version":3,"names":[],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\components\\NexusComponent.vue"],"sourcesContent":["<template>\r\n  <main class=\"nexus-main container\" role=\"main\">\r\n\r\n    <section class=\"hero-section\" role=\"region\" aria-label=\"Presentación principal\">\r\n\r\n      <div class=\"hero-content\">\r\n\r\n        <h1 class=\"hero-title\">\r\n          Descubre el <span class=\"highlight\">futuro</span> de la lectura\r\n        </h1>\r\n        <p class=\"hero-subtitle\">\r\n          Una experiencia inmersiva donde la tecnología y la literatura\r\n          convergen\r\n        </p>\r\n\r\n        <div class=\"hero-actions\">\r\n          <button class=\"primary-btn btn\" onclick=\"showCollectionModal()\">\r\n            <i class=\"bi bi-collection\"></i> Explorar colección\r\n          </button>\r\n\r\n          <button class=\"secondary-btn btn\" onclick=\"showEventsModal()\">\r\n            <i class=\"bi bi-calendar-check\"></i> Próximos eventos\r\n          </button>\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </section>\r\n\r\n    <section class=\"carousel-section scroll-animation\">\r\n      <div class=\"section-header\">\r\n        <h2>Colección destacada</h2>\r\n      </div>\r\n      <div class=\"nexus-carousel position-relative overflow-hidden\">\r\n        <div class=\"recommendations-container\">\r\n          <!-- Libros generados dinámicamente con JS -->\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <template id=\"cards-template\">\r\n      <div class=\"recommendation-card\">\r\n        <img src=\"\" alt=\"Portada del libro\" class=\"book-cover\" />\r\n        <div class=\"book-info\">\r\n          <h3 class=\"book-title\">Título del libro</h3>\r\n          <p class=\"book-author\">Autor del libro</p>\r\n          <div class=\"book-meta\">\r\n            <span class=\"book-category\">Categoría</span>\r\n            <span class=\"book-rating\">⭐⭐⭐⭐⭐</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </template>\r\n\r\n    <section class=\"features-section scroll-animation \" role=\"region\" aria-label=\"Características principales\">\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-telephone-plus fs-3\"></i>\r\n        </div>\r\n        <h3>Contacto</h3>\r\n        <p>Comunicate con nosotros a traves del correo: <a class=\"info-Correo\" href=\"#\">info@nexuslibrary.com</a> o deja\r\n          un comentario</p>\r\n      </div>\r\n\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-person-vcard fs-3\"></i>\r\n        </div>\r\n        <h3>Membresia <span class=\"premium\">VIP</span></h3>\r\n        <p>\r\n          Accede a contenido exclusivo, eventos privados y ofertas exclusivas.\r\n        </p>\r\n        <button class=\"btn primary-btn\" style=\"margin-top: 1.3rem;\" onclick=\"showMembershipModal()\">Únete ahora</button>\r\n      </div>\r\n\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-chat-left-dots fs-3\"></i>\r\n        </div>\r\n        <h3>Comunidad Nexus</h3>\r\n        <p>\r\n          Únete a nuestra comunidad de lectores y comparte tus opiniones y recomendaciones.\r\n        </p>\r\n\r\n        <button class=\"btn primary-btn\" onclick=\"showDiscordModal()\"> <i class=\"bi bi-discord\"></i> Unirte</button>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"newsletter-section scroll-animation\" role=\"region\" aria-label=\"Suscríbete a nuestro newsletter\">\r\n      <div class=\"newsletter-container\">\r\n        <div class=\"text\">\r\n          <p id=\"two\" class=\"fw-semibold\">Tu curiosidad nos inspira</p>\r\n          <p id=\"three\">Escríbenos sin temor para resolver tus dudas.</p>\r\n        </div>\r\n        <form class=\"newsletter-form\" action=\"#\" method=\"post\" novalidate>\r\n          <div>\r\n            <label for=\"nombre\" class=\"form-label visually-hidden\">Nombre</label>\r\n            <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Nombre\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa tu nombre.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"email\" class=\"form-label visually-hidden\">Email</label>\r\n            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Correo electrónico\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa un correo válido.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"telefono\" class=\"form-label visually-hidden\">Teléfono</label>\r\n            <input type=\"tel\" id=\"telefono\" name=\"telefono\" placeholder=\"Teléfono\" pattern=\"[0-9]{10,15}\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa un teléfono válido.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"mensaje\" class=\"form-label visually-hidden\">Mensaje</label>\r\n            <textarea id=\"mensaje\" name=\"mensaje\" placeholder=\"Mensaje\" rows=\"1\" required></textarea>\r\n            <div class=\"invalid-feedback\">Por favor, escribe tu mensaje.</div>\r\n          </div>\r\n          <div>\r\n            <button type=\"submit\" class=\"btn primary-btn px-4\" id=\"contact-btn\">¡Háblanos!</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </section>\r\n\r\n  </main>\r\n</template>\r\n\r\n<!-- <script>\r\nexport default {\r\n  name: 'NexusComponent',\r\n  mounted() {\r\n    // Activate scroll animations: add .animate-in when element enters viewport\r\n    try {\r\n      const io = new IntersectionObserver((entries, observer) => {\r\n        entries.forEach(entry => {\r\n          if (entry.isIntersecting) {\r\n            entry.target.classList.add('animate-in');\r\n            observer.unobserve(entry.target);\r\n          }\r\n        });\r\n      }, { threshold: 0.12 });\r\n\r\n      document.querySelectorAll('.scroll-animation').forEach(el => io.observe(el));\r\n    } catch (e) {\r\n      // Fallback: if IntersectionObserver not supported, reveal elements immediately\r\n      document.querySelectorAll('.scroll-animation').forEach(el => el.classList.add('animate-in'));\r\n    }\r\n  }\r\n};\r\n</script> -->\r\n\r\n<script src=\"\"></script>\r\n\r\n<style src=\"../assets/estilosCss/style.css\"></style>"],"mappings":"","ignoreList":[]},"metadata":{},"sourceType":"script","externalDependencies":[]}