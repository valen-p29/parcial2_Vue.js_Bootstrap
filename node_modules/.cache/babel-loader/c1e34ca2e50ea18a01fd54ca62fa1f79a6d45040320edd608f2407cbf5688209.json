{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'AdminPanelView',\n  data() {\n    return {\n      items: [],\n      formOpen: false,\n      editing: false,\n      form: {\n        id: '',\n        name: '',\n        category: 'hombre',\n        description: '',\n        price: 0,\n        stock: 0,\n        discount: 0,\n        image: ''\n      }\n    };\n  },\n  created() {\n    this.loadItems();\n  },\n  methods: {\n    async loadItems() {\n      try {\n        const saved = localStorage.getItem('admin_products');\n        if (saved) {\n          this.items = JSON.parse(saved);\n          return;\n        }\n        const res = await fetch('/product.json');\n        if (!res.ok) throw new Error('No se pudo cargar /product.json');\n        const data = await res.json();\n        const products = data.products || [];\n        this.items = products.map(p => ({\n          id: String(p.id ?? Date.now() + Math.random()),\n          name: p.name || p.title || 'Sin nombre',\n          category: p.category || 'hombre',\n          description: p.description || '',\n          price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\n          stock: Number(p.stock ?? 10),\n          discount: Number(p.discount ?? 0),\n          image: p.image || ''\n        }));\n        this.saveItems();\n      } catch (err) {\n        console.error('Error al cargar productos en admin:', err);\n        this.items = [];\n      }\n    },\n    saveItems() {\n      localStorage.setItem('admin_products', JSON.stringify(this.items));\n    },\n    openForm(item) {\n      if (item) {\n        this.editing = true;\n        this.form = {\n          ...item\n        };\n      } else {\n        this.editing = false;\n        this.form = {\n          id: '',\n          name: '',\n          category: 'hombre',\n          description: '',\n          price: 0,\n          stock: 0,\n          discount: 0,\n          image: ''\n        };\n      }\n      this.formOpen = true;\n    },\n    closeForm() {\n      this.formOpen = false;\n    },\n    saveForm() {\n      if (!this.form.name) return;\n      if (this.editing) {\n        const idx = this.items.findIndex(i => i.id === this.form.id);\n        if (idx > -1) this.items.splice(idx, 1, {\n          ...this.form\n        });\n      } else {\n        this.form.id = String(Date.now());\n        this.items.push({\n          ...this.form\n        });\n      }\n      this.saveItems();\n      this.formOpen = false;\n    },\n    removeItem(id) {\n      if (!confirm('¿Eliminar este producto?')) return;\n      this.items = this.items.filter(i => i.id !== id);\n      this.saveItems();\n    },\n    cerrarSesion() {\n      localStorage.removeItem('usuarioActivo');\n      localStorage.removeItem('userRole');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["name","data","items","formOpen","editing","form","id","category","description","price","stock","discount","image","created","loadItems","methods","saved","localStorage","getItem","JSON","parse","res","fetch","ok","Error","json","products","map","p","String","Date","now","Math","random","title","parseFloat","Number","saveItems","err","console","error","setItem","stringify","openForm","item","closeForm","saveForm","idx","findIndex","i","splice","push","removeItem","confirm","filter","cerrarSesion","$router"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\views\\AdminPanelView.vue"],"sourcesContent":["<template>\r\n\t<div class=\"admin-panel container py-4\">\r\n\t\t<nav class=\"d-flex justify-content-between align-items-center mb-4\"\r\n\t\t\tstyle=\"border-bottom:1px solid var(--border-color);padding-bottom:0.75rem\">\r\n\t\t\t<h2\r\n\t\t\t\tstyle=\"background:var(--gradient);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin:0\">\r\n\t\t\t\tPanel de Administración</h2>\r\n\t\t\t<div>\r\n\t\t\t\t<button class=\"btn btn-outline-secondary me-2\" @click=\"$router.push('/productos')\"><i\r\n\t\t\t\t\t\tclass=\"bi bi-shop me-1\"></i> Ir a tienda</button>\r\n\t\t\t\t<button class=\"btn btn-danger\" @click=\"cerrarSesion\"><i class=\"bi bi-box-arrow-right me-1\"></i> Cerrar\r\n\t\t\t\t\tsesión</button>\r\n\t\t\t</div>\r\n\t\t</nav>\r\n\r\n\t\t<div class=\"mb-3 d-flex justify-content-between align-items-center\">\r\n\t\t\t<button class=\"btn btn-primary\" @click=\"openForm()\"><i class=\"bi bi-plus-circle me-1\"></i> Añadir\r\n\t\t\t\tproducto</button>\r\n\t\t\t<small class=\"text-muted\">Gestiona stock, precio y descuentos</small>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"table-responsive\">\r\n\t\t\t<table class=\"table table-dark table-striped align-middle\" style=\"border:1px solid var(--border-color)\">\r\n\t\t\t\t<thead>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<th>ID</th>\r\n\t\t\t\t\t\t<th>Nombre</th>\r\n\t\t\t\t\t\t<th>Categoría</th>\r\n\t\t\t\t\t\t<th>Stock</th>\r\n\t\t\t\t\t\t<th>Precio</th>\r\n\t\t\t\t\t\t<th>Descuento (%)</th>\r\n\t\t\t\t\t\t<th>Precio Final</th>\r\n\t\t\t\t\t\t<th>Acciones</th>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</thead>\r\n\t\t\t\t<tbody>\r\n\t\t\t\t\t<tr v-for=\"p in items\" :key=\"p.id\">\r\n\t\t\t\t\t\t<td>{{ p.id }}</td>\r\n\t\t\t\t\t\t<td>{{ p.name }}</td>\r\n\t\t\t\t\t\t<td>{{ p.category }}</td>\r\n\t\t\t\t\t\t<td>{{ p.stock }}</td>\r\n\t\t\t\t\t\t<td>${{ Number(p.price).toFixed(2) }}</td>\r\n\t\t\t\t\t\t<td>{{ p.discount }}</td>\r\n\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t${{ (Number(p.price) * (1 - (Number(p.discount || 0) / 100))).toFixed(2) }}\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t<button class=\"btn btn-sm btn-warning me-2\" @click=\"openForm(p)\"><i\r\n\t\t\t\t\t\t\t\t\tclass=\"bi bi-pencil-square\"></i></button>\r\n\t\t\t\t\t\t\t<button class=\"btn btn-sm btn-danger\" @click=\"removeItem(p.id)\"><i\r\n\t\t\t\t\t\t\t\t\tclass=\"bi bi-trash3\"></i></button>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</tbody>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\r\n\t\t<!-- Form modal -->\r\n\t\t<div v-if=\"formOpen\" class=\"quickview-overlay\" @click.self=\"closeForm\">\r\n\t\t\t<div class=\"quickview-card\" style=\"max-width:640px;width:90%\">\r\n\t\t\t\t<button class=\"quickview-close\" @click=\"closeForm\"><i class=\"bi bi-x-lg\"></i></button>\r\n\t\t\t\t<div class=\"p-3\">\r\n\t\t\t\t\t<h4 style=\"margin-top:0\">{{ editing ? 'Editar producto' : 'Añadir producto' }}</h4>\r\n\t\t\t\t\t<form @submit.prevent=\"saveForm\">\r\n\t\t\t\t\t\t<div class=\"row g-3\">\r\n\t\t\t\t\t\t\t<div class=\"col-md-6\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Nombre</label>\r\n\t\t\t\t\t\t\t\t<input v-model.trim=\"form.name\" type=\"text\" class=\"form-control\" required>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-6\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Categoría</label>\r\n\t\t\t\t\t\t\t\t<select v-model=\"form.category\" class=\"form-select\" required>\r\n\t\t\t\t\t\t\t\t\t<option value=\"hombre\">Hombre</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"mujer\">Mujer</option>\r\n\t\t\t\t\t\t\t\t\t<option value=\"accesorios\">Accesorios</option>\r\n\t\t\t\t\t\t\t\t</select>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Precio</label>\r\n\t\t\t\t\t\t\t\t<input v-model.number=\"form.price\" type=\"number\" step=\"0.01\" min=\"0\"\r\n\t\t\t\t\t\t\t\t\tclass=\"form-control\" required>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Stock</label>\r\n\t\t\t\t\t\t\t\t<input v-model.number=\"form.stock\" type=\"number\" min=\"0\" class=\"form-control\" required>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-md-4\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Descuento (%)</label>\r\n\t\t\t\t\t\t\t\t<input v-model.number=\"form.discount\" type=\"number\" min=\"0\" max=\"100\"\r\n\t\t\t\t\t\t\t\t\tclass=\"form-control\">\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col-12\">\r\n\t\t\t\t\t\t\t\t<label class=\"form-label\">Imagen (URL)</label>\r\n\t\t\t\t\t\t\t\t<input v-model.trim=\"form.image\" type=\"url\" class=\"form-control\"\r\n\t\t\t\t\t\t\t\t\tplaceholder=\"https://...\">\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"d-flex justify-content-end gap-2 mt-3\">\r\n\t\t\t\t\t\t\t<button type=\"button\" class=\"btn btn-outline-secondary\" @click=\"closeForm\">Cancelar</button>\r\n\t\t\t\t\t\t\t<button type=\"submit\" class=\"btn btn-primary\">Guardar</button>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</form>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n\tname: 'AdminPanelView',\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\titems: [],\r\n\t\t\tformOpen: false,\r\n\t\t\tediting: false,\r\n\t\t\tform: {\r\n\t\t\t\tid: '',\r\n\t\t\t\tname: '',\r\n\t\t\t\tcategory: 'hombre',\r\n\t\t\t\tdescription: '',\r\n\t\t\t\tprice: 0,\r\n\t\t\t\tstock: 0,\r\n\t\t\t\tdiscount: 0,\r\n\t\t\t\timage: ''\r\n\t\t\t}\r\n\t\t}\r\n\t},\r\n\tcreated() {\r\n\t\tthis.loadItems()\r\n\t},\r\n\tmethods: {\r\n\t\tasync loadItems() {\r\n\t\t\ttry {\r\n\t\t\t\tconst saved = localStorage.getItem('admin_products')\r\n\t\t\t\tif (saved) {\r\n\t\t\t\t\tthis.items = JSON.parse(saved)\r\n\t\t\t\t\treturn\r\n\t\t\t\t}\r\n\t\t\t\tconst res = await fetch('/product.json')\r\n\t\t\t\tif (!res.ok) throw new Error('No se pudo cargar /product.json')\r\n\t\t\t\tconst data = await res.json()\r\n\t\t\t\tconst products = data.products || []\r\n\t\t\t\tthis.items = products.map(p => ({\r\n\t\t\t\t\tid: String(p.id ?? Date.now() + Math.random()),\r\n\t\t\t\t\tname: p.name || p.title || 'Sin nombre',\r\n\t\t\t\t\tcategory: p.category || 'hombre',\r\n\t\t\t\t\tdescription: p.description || '',\r\n\t\t\t\t\tprice: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\r\n\t\t\t\t\tstock: Number(p.stock ?? 10),\r\n\t\t\t\t\tdiscount: Number(p.discount ?? 0),\r\n\t\t\t\t\timage: p.image || ''\r\n\t\t\t\t}))\r\n\t\t\t\tthis.saveItems()\r\n\t\t\t} catch (err) {\r\n\t\t\t\tconsole.error('Error al cargar productos en admin:', err)\r\n\t\t\t\tthis.items = []\r\n\t\t\t}\r\n\t\t},\r\n\t\tsaveItems() {\r\n\t\t\tlocalStorage.setItem('admin_products', JSON.stringify(this.items))\r\n\t\t},\r\n\t\topenForm(item) {\r\n\t\t\tif (item) {\r\n\t\t\t\tthis.editing = true\r\n\t\t\t\tthis.form = { ...item }\r\n\t\t\t} else {\r\n\t\t\t\tthis.editing = false\r\n\t\t\t\tthis.form = {\r\n\t\t\t\t\tid: '',\r\n\t\t\t\t\tname: '',\r\n\t\t\t\t\tcategory: 'hombre',\r\n\t\t\t\t\tdescription: '',\r\n\t\t\t\t\tprice: 0,\r\n\t\t\t\t\tstock: 0,\r\n\t\t\t\t\tdiscount: 0,\r\n\t\t\t\t\timage: ''\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.formOpen = true\r\n\t\t},\r\n\t\tcloseForm() {\r\n\t\t\tthis.formOpen = false\r\n\t\t},\r\n\t\tsaveForm() {\r\n\t\t\tif (!this.form.name) return\r\n\t\t\tif (this.editing) {\r\n\t\t\t\tconst idx = this.items.findIndex(i => i.id === this.form.id)\r\n\t\t\t\tif (idx > -1) this.items.splice(idx, 1, { ...this.form })\r\n\t\t\t} else {\r\n\t\t\t\tthis.form.id = String(Date.now())\r\n\t\t\t\tthis.items.push({ ...this.form })\r\n\t\t\t}\r\n\t\t\tthis.saveItems()\r\n\t\t\tthis.formOpen = false\r\n\t\t},\r\n\t\tremoveItem(id) {\r\n\t\t\tif (!confirm('¿Eliminar este producto?')) return\r\n\t\t\tthis.items = this.items.filter(i => i.id !== id)\r\n\t\t\tthis.saveItems()\r\n\t\t},\r\n\t\tcerrarSesion() {\r\n\t\t\tlocalStorage.removeItem('usuarioActivo')\r\n\t\t\tlocalStorage.removeItem('userRole')\r\n\t\t\tthis.$router.push('/login')\r\n\t\t}\r\n\t}\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.admin-panel {\r\n\tbackground: ;\r\n\tmin-height: 100vh;\r\n}\r\n\r\n.admin-panel h2 {\r\n\tmargin: 0;\r\n\r\n}\r\n\r\n\r\n</style>\r\n"],"mappings":";;;;AA6GA,eAAe;EACdA,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACN,OAAO;MACNC,KAAK,EAAE,