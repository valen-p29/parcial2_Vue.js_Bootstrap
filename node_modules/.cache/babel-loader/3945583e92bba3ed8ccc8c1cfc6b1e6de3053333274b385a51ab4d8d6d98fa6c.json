{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { auth } from \"../firebase/config\";\nimport { onAuthStateChanged, signOut } from \"firebase/auth\";\nexport default {\n  name: \"NavbarComponent\",\n  data() {\n    return {\n      isAuthenticated: false,\n      isAdmin: false,\n      userData: null\n    };\n  },\n  mounted() {\n    // Observar cambios en el estado de autenticación\n    onAuthStateChanged(auth, user => {\n      this.isAuthenticated = !!user;\n      if (user) {\n        this.userData = user;\n        this.isAdmin = user.email === \"admin@nexuslibrary.com\";\n      } else {\n        this.userData = null;\n        this.isAdmin = false;\n      }\n    });\n  },\n  methods: {\n    async logout() {\n      try {\n        await signOut(auth);\n        this.$router.push(\"/login\");\n      } catch (error) {\n        console.error(\"Error al cerrar sesión:\", error);\n      }\n    },\n    showProfile() {\n      // Implementar lógica para mostrar perfil\n      console.log(\"Mostrar perfil del usuario\");\n    }\n  }\n};","map":{"version":3,"names":["auth","onAuthStateChanged","signOut","name","data","isAuthenticated","isAdmin","userData","mounted","user","email","methods","logout","$router","push","error","console","showProfile","log"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\components\\NavbarComponent.vue"],"sourcesContent":["<template>\r\n  <header>\r\n    <nav class=\"navbar navbar-expand-lg\">\r\n      <div class=\"container\">\r\n        <div class=\"logo\" >\r\n          <span class=\"logo-part\">NEXUS</span>\r\n          <span class=\"logo-part\">LIBRARY</span>\r\n        </div>\r\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarNav\">\r\n          <span class=\"navbar-toggler-icon\"></span>\r\n        </button>\r\n        <div class=\"collapse navbar-collapse justify-content-end\" id=\"navbarNav\">\r\n          <div class=\"d-flex align-items-center gap-3\">\r\n            <!-- Si NO está autenticado, solo muestra el botón de inicio de sesión -->\r\n            <template v-if=\"!isAuthenticated\">\r\n              <router-link to=\"/login\" class=\"btn btn-light\">\r\n                <i class=\"bi bi-person-circle\"></i> Iniciar Sesión\r\n              </router-link>\r\n            </template>\r\n\r\n            <!-- Si está autenticado, muestra los botones de perfil y cerrar sesión -->\r\n            <template v-else>\r\n              <!-- Panel Admin (solo si es administrador) -->\r\n              <router-link v-if=\"isAdmin\" to=\"/admin\" class=\"btn btn-warning\">\r\n                <i class=\"bi bi-gear-fill\"></i> Panel Admin\r\n              </router-link>\r\n\r\n              <!-- Botón de perfil -->\r\n              <button class=\"btn btn-light\" @click=\"showProfile\">\r\n                <i class=\"bi bi-person-circle\"></i> Mi Perfil\r\n              </button>\r\n\r\n              <!-- Botón de cerrar sesión -->\r\n              <button class=\"btn btn-outline-danger\" @click=\"logout\">\r\n                <i class=\"bi bi-box-arrow-right\"></i> Cerrar Sesión\r\n              </button>\r\n            </template>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n  </header>\r\n</template>\r\n\r\n<script>\r\nimport { auth } from \"../firebase/config\";\r\nimport { onAuthStateChanged, signOut } from \"firebase/auth\";\r\n\r\nexport default {\r\n  name: \"NavbarComponent\",\r\n  data() {\r\n    return {\r\n      isAuthenticated: false,\r\n      isAdmin: false,\r\n      userData: null\r\n    };\r\n  },\r\n  mounted() {\r\n    // Observar cambios en el estado de autenticación\r\n    onAuthStateChanged(auth, (user) => {\r\n      this.isAuthenticated = !!user;\r\n      if (user) {\r\n        this.userData = user;\r\n        this.isAdmin = user.email === \"admin@nexuslibrary.com\";\r\n      } else {\r\n        this.userData = null;\r\n        this.isAdmin = false;\r\n      }\r\n    });\r\n  },\r\n  methods: {\r\n    async logout() {\r\n      try {\r\n        await signOut(auth);\r\n        this.$router.push(\"/login\");\r\n      } catch (error) {\r\n        console.error(\"Error al cerrar sesión:\", error);\r\n      }\r\n    },\r\n    showProfile() {\r\n      // Implementar lógica para mostrar perfil\r\n      console.log(\"Mostrar perfil del usuario\");\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style src=\"../assets/estilosCss/navbar.css\"></style>\r\n"],"mappings":";AA6CA,SAASA,IAAG,QAAS,oBAAoB;AACzC,SAASC,kBAAkB,EAAEC,OAAM,QAAS,eAAe;AAE3D,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,KAAK;MACtBC,OAAO,EAAE,KAAK;MACdC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACAP,kBAAkB,CAACD,IAAI,EAAGS,IAAI,IAAK;MACjC,IAAI,CAACJ,eAAc,GAAI,CAAC,CAACI,IAAI;MAC7B,IAAIA,IAAI,EAAE;QACR,IAAI,CAACF,QAAO,GAAIE,IAAI;QACpB,IAAI,CAACH,OAAM,GAAIG,IAAI,CAACC,KAAI,KAAM,wBAAwB;MACxD,OAAO;QACL,IAAI,CAACH,QAAO,GAAI,IAAI;QACpB,IAAI,CAACD,OAAM,GAAI,KAAK;MACtB;IACF,CAAC,CAAC;EACJ,CAAC;EACDK,OAAO,EAAE;IACP,MAAMC,MAAMA,CAAA,EAAG;MACb,IAAI;QACF,MAAMV,OAAO,CAACF,IAAI,CAAC;QACnB,IAAI,CAACa,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;MAC7B,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;MACjD;IACF,CAAC;IACDE,WAAWA,CAAA,EAAG;MACZ;MACAD,OAAO,CAACE,GAAG,CAAC,4BAA4B,CAAC;IAC3C;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}