{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { db } from '../firebase/config';\nimport { collection, getDocs } from 'firebase/firestore';\nexport default {\n  name: 'MainComponent',\n  data() {\n    return {\n      products: [],\n      showQuickView: false,\n      selectedProduct: null,\n      currentFilter: 'all',\n      searchQuery: '',\n      showDiscountsModal: false,\n      cartOpen: false,\n      cartItems: [],\n      isMobile: false,\n      categoryScrollPositions: {},\n      filteredScrollPosition: 0\n    };\n  },\n  mounted() {\n    this.loadProducts();\n    this.loadCart();\n    this.checkMobile();\n    window.addEventListener('set-category', this.onSetCategory);\n    window.addEventListener('set-search', this.onSetSearch);\n    window.addEventListener('toggle-cart', this.onToggleCart);\n    window.addEventListener('storage', this.loadCart);\n    window.addEventListener('resize', this.checkMobile);\n  },\n  beforeUnmount() {\n    window.removeEventListener('set-category', this.onSetCategory);\n    window.removeEventListener('set-search', this.onSetSearch);\n    window.removeEventListener('toggle-cart', this.onToggleCart);\n    window.removeEventListener('storage', this.loadCart);\n  },\n  computed: {\n    cartTotal() {\n      return this.cartItems.reduce((total, item) => {\n        const price = this.discountedPrice(item);\n        const quantity = item.quantity || 1;\n        return total + price * quantity;\n      }, 0);\n    },\n    visibleProducts() {\n      const q = (this.searchQuery || '').toLowerCase().trim();\n      return this.products.filter(p => {\n        const matchesCategory = this.currentFilter === 'all' || (p.author || p.category || '').toLowerCase() === this.currentFilter;\n        const matchesQuery = !q || [p.title, p.name, p.author, p.category, p.description].filter(Boolean).some(v => String(v).toLowerCase().includes(q));\n        return matchesCategory && matchesQuery;\n      });\n    },\n    discountedProducts() {\n      return this.products.filter(p => Number(p.discount || 0) > 0);\n    }\n  },\n  methods: {\n    async loadProducts() {\n      try {\n        // Cargar productos desde Firestore (colección: 'products')\n        const col = collection(db, 'products');\n        const snapshot = await getDocs(col);\n        if (!snapshot.empty) {\n          this.products = snapshot.docs.map(d => {\n            const p = d.data();\n            return {\n              id: d.id,\n              title: p.name || p.title || 'Sin título',\n              author: p.category || 'Desconocido',\n              description: p.description || '',\n              price: typeof p.price === 'number' ? p.price : parseFloat(p.price) || 0,\n              image: p.image || null,\n              stock: Number(p.stock ?? 0),\n              discount: Number(p.discount ?? 0)\n            };\n          });\n          return;\n        }\n        // Si no hay documentos en Firestore, usar respaldo local si existe\n        const savedAdmin = localStorage.getItem('admin_products');\n        if (savedAdmin) {\n          const items = JSON.parse(savedAdmin);\n          this.products = items.map(p => ({\n            id: String(p.id),\n            title: p.name,\n            author: p.category,\n            description: p.description || '',\n            price: Number(p.price) || 0,\n            image: p.image || null,\n            stock: Number(p.stock ?? 0),\n            discount: Number(p.discount ?? 0)\n          }));\n        } else {\n          this.products = [];\n        }\n      } catch (err) {\n        console.error('Error cargando productos en MainComponent:', err);\n        // Fallback a localStorage si falla la conexión a Firestore\n        try {\n          const savedAdmin = localStorage.getItem('admin_products');\n          if (savedAdmin) {\n            const items = JSON.parse(savedAdmin);\n            this.products = items.map(p => ({\n              id: String(p.id),\n              title: p.name,\n              author: p.category,\n              description: p.description || '',\n              price: Number(p.price) || 0,\n              image: p.image || null,\n              stock: Number(p.stock ?? 0),\n              discount: Number(p.discount ?? 0)\n            }));\n          } else {\n            this.products = [];\n          }\n        } catch (fallbackErr) {\n          console.error('Error en fallback:', fallbackErr);\n          this.products = [];\n        }\n      }\n    },\n    openDiscountsModal() {\n      this.showDiscountsModal = true;\n    },\n    closeDiscountsModal() {\n      this.showDiscountsModal = false;\n    },\n    setFilter(f) {\n      this.currentFilter = f;\n    },\n    onSetCategory(e) {\n      this.currentFilter = e.detail || 'all';\n      const el = document.querySelectorAll('.filter-btn');\n      if (el && el.length) {\n        // visual state handled by :class, nothing to do\n      }\n    },\n    onSetSearch(e) {\n      this.searchQuery = e.detail || '';\n    },\n    onToggleCart() {\n      this.cartOpen = !this.cartOpen;\n    },\n    closeCart() {\n      this.cartOpen = false;\n    },\n    loadCart() {\n      try {\n        const saved = localStorage.getItem('cart');\n        this.cartItems = saved ? JSON.parse(saved) : [];\n      } catch (err) {\n        console.error('Error cargando carrito:', err);\n        this.cartItems = [];\n      }\n    },\n    increaseQuantity(productId) {\n      const item = this.cartItems.find(i => i.id === productId);\n      if (item) {\n        item.quantity = (item.quantity || 1) + 1;\n        this.saveCart();\n      }\n    },\n    decreaseQuantity(productId) {\n      const item = this.cartItems.find(i => i.id === productId);\n      if (item) {\n        if (item.quantity > 1) {\n          item.quantity = item.quantity - 1;\n        } else {\n          this.removeFromCart(productId);\n          return;\n        }\n        this.saveCart();\n      }\n    },\n    removeFromCart(productId) {\n      this.cartItems = this.cartItems.filter(i => i.id !== productId);\n      this.saveCart();\n    },\n    saveCart() {\n      try {\n        localStorage.setItem('cart', JSON.stringify(this.cartItems));\n        window.dispatchEvent(new Event('storage'));\n      } catch (err) {\n        console.error('Error guardando carrito:', err);\n      }\n    },\n    proceedToCheckout() {\n      alert('Funcionalidad de pago próximamente disponible');\n    },\n    formatPrice(val) {\n      if (typeof val !== 'number') return val;\n      return val.toFixed(2);\n    },\n    getPlaceholder() {\n      return 'data:image/svg+xml;base64,';\n    },\n    discountedPrice(p) {\n      const d = Number(p.discount || 0);\n      if (!d) return Number(p.price || 0);\n      return Number(p.price || 0) * (1 - d / 100);\n    },\n    viewProduct() {\n      this.$router.push({\n        name: 'Products'\n      });\n    },\n    openQuickView(p) {\n      this.selectedProduct = p;\n      this.showQuickView = true;\n    },\n    closeQuickView() {\n      this.showQuickView = false;\n      this.selectedProduct = null;\n    },\n    addToCart(product) {\n      try {\n        const idx = this.cartItems.findIndex(i => i.id === product.id);\n        if (idx > -1) {\n          this.cartItems[idx].quantity = (this.cartItems[idx].quantity || 1) + 1;\n        } else {\n          this.cartItems.push({\n            ...product,\n            quantity: 1\n          });\n        }\n        this.saveCart();\n        // Open cart sidebar when item is added\n        this.cartOpen = true;\n        // Small feedback (you can replace this with a toast notification)\n        const productName = product.title || product.name;\n        console.log(`\"${productName}\" agregado al carrito`);\n      } catch (err) {\n        console.error('Error al agregar al carrito:', err);\n      }\n    }\n  }\n};","map":{"version":3,"names":["db","collection","getDocs","name","data","products","showQuickView","selectedProduct","currentFilter","searchQuery","showDiscountsModal","cartOpen","cartItems","isMobile","categoryScrollPositions","filteredScrollPosition","mounted","loadProducts","loadCart","checkMobile","window","addEventListener","onSetCategory","onSetSearch","onToggleCart","beforeUnmount","removeEventListener","computed","cartTotal","reduce","total","item","price","discountedPrice","quantity","visibleProducts","q","toLowerCase","trim","filter","p","matchesCategory","author","category","matchesQuery","title","description","Boolean","some","v","String","includes","discountedProducts","Number","discount","methods","col","snapshot","empty","docs","map","d","id","parseFloat","image","stock","savedAdmin","localStorage","getItem","items","JSON","parse","err","console","error","fallbackErr","openDiscountsModal","closeDiscountsModal","setFilter","f","e","detail","el","document","querySelectorAll","length","closeCart","saved","increaseQuantity","productId","find","i","saveCart","decreaseQuantity","removeFromCart","setItem","stringify","dispatchEvent","Event","proceedToCheckout","alert","formatPrice","val","toFixed","getPlaceholder","viewProduct","$router","push","openQuickView","closeQuickView","addToCart","product","idx","findIndex","productName","log"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\components\\MainComponent.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <section class=\"hero\">\r\n      <div class=\"hero-background\">\r\n        <img\r\n          src=\"https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80\"\r\n          alt=\"Fashion Store\" class=\"hero-bg-image\">\r\n        <div class=\"hero-overlay\"></div>\r\n      </div>\r\n      <div class=\"hero-content\">\r\n        <h2 class=\"hero-title\">Nueva Colección</h2>\r\n        <p class=\"hero-subtitle\">Descubre las últimas tendencias en moda</p>\r\n        <button class=\"btn-primary\" id=\"viewCollectionBtn\" @click=\"openDiscountsModal\">Ver Colección</button>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"products-section\">\r\n      <div class=\"container\">\r\n        <div class=\"section-header\">\r\n          <h3>Productos Destacados</h3>\r\n          <div class=\"filters\">\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'all' }\" @click=\"setFilter('all')\">Todos</button>\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'hombre' }\"\r\n              @click=\"setFilter('hombre')\">Hombre</button>\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'mujer' }\"\r\n              @click=\"setFilter('mujer')\">Mujer</button>\r\n            <button class=\"filter-btn\" :class=\"{ active: currentFilter === 'accesorios' }\"\r\n              @click=\"setFilter('accesorios')\">Accesorios</button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Vista por categorías (Desktop) -->\r\n        <template v-if=\"currentFilter === 'all'\">\r\n          <div v-for=\"category in categories\" :key=\"category.name\" class=\"category-section\">\r\n            <h4 class=\"category-title\">{{ category.label }}</h4>\r\n            <div class=\"products-grid\" :class=\"{ 'carousel-container': isMobile }\">\r\n              <div class=\"carousel-wrapper\" v-if=\"isMobile\">\r\n                <div class=\"carousel-track\" :style=\"{ transform: `translateX(-${categoryScrollPositions[category.name] || 0}px)` }\">\r\n                  <div class=\"product-card\" v-for=\"p in category.products\" :key=\"p.id\">\r\n                    <div class=\"product-image\">\r\n                      <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n                      <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n                    </div>\r\n                    <div class=\"product-info\">\r\n                      <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n                      <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n                      <p class=\"product-price\">\r\n                        <span v-if=\"p.discount && p.discount > 0\"\r\n                          style=\"color: #6B6B9B;text-decoration:line-through;margin-right:8px\">\r\n                          ${{ formatPrice(p.price) }}\r\n                        </span>\r\n                        <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n                      </p>\r\n                      <p class=\"product-desc\">{{ p.description }}</p>\r\n                      <div class=\"product-actions\">\r\n                        <button class=\"btn btn-outline-secondary me-2\" @click=\"openQuickView(p)\">Ver detalle</button>\r\n                        <button class=\"btn btn-primary\" @click=\"addToCart(p)\">Añadir al carrito</button>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <button class=\"carousel-btn carousel-btn-prev\" @click=\"scrollCategory(category.name, 'prev')\" v-if=\"category.products.length > 1\">\r\n                  <i class=\"bi bi-chevron-left\"></i>\r\n                </button>\r\n                <button class=\"carousel-btn carousel-btn-next\" @click=\"scrollCategory(category.name, 'next')\" v-if=\"category.products.length > 1\">\r\n                  <i class=\"bi bi-chevron-right\"></i>\r\n                </button>\r\n              </div>\r\n              <template v-else>\r\n                <div class=\"product-card\" v-for=\"p in category.products\" :key=\"p.id\">\r\n                  <div class=\"product-image\">\r\n                    <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n                    <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n                  </div>\r\n                  <div class=\"product-info\">\r\n                    <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n                    <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n                    <p class=\"product-price\">\r\n                      <span v-if=\"p.discount && p.discount > 0\"\r\n                        style=\"color: #6B6B9B;text-decoration:line-through;margin-right:8px\">\r\n                        ${{ formatPrice(p.price) }}\r\n                      </span>\r\n                      <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n                    </p>\r\n                    <p class=\"product-desc\">{{ p.description }}</p>\r\n                    <div class=\"product-actions\">\r\n                      <button class=\"btn btn-outline-secondary me-2\" @click=\"openQuickView(p)\">Ver detalle</button>\r\n                      <button class=\"btn btn-primary\" @click=\"addToCart(p)\">Añadir al carrito</button>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </template>\r\n            </div>\r\n          </div>\r\n        </template>\r\n\r\n        <!-- Vista filtrada (cuando se selecciona una categoría específica) -->\r\n        <template v-else>\r\n          <div class=\"products-grid\" :class=\"{ 'carousel-container': isMobile }\">\r\n            <div class=\"carousel-wrapper\" v-if=\"isMobile\">\r\n              <div class=\"carousel-track\" :style=\"{ transform: `translateX(-${filteredScrollPosition || 0}px)` }\">\r\n                <div class=\"product-card\" v-for=\"p in visibleProducts\" :key=\"p.id\">\r\n                  <div class=\"product-image\">\r\n                    <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n                    <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n                  </div>\r\n                  <div class=\"product-info\">\r\n                    <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n                    <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n                    <p class=\"product-price\">\r\n                      <span v-if=\"p.discount && p.discount > 0\"\r\n                        style=\"color: #6B6B9B;text-decoration:line-through;margin-right:8px\">\r\n                        ${{ formatPrice(p.price) }}\r\n                      </span>\r\n                      <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n                    </p>\r\n                    <p class=\"product-desc\">{{ p.description }}</p>\r\n                    <div class=\"product-actions\">\r\n                      <button class=\"btn btn-outline-secondary me-2\" @click=\"openQuickView(p)\">Ver detalle</button>\r\n                      <button class=\"btn btn-primary\" @click=\"addToCart(p)\">Añadir al carrito</button>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <button class=\"carousel-btn carousel-btn-prev\" @click=\"scrollFiltered('prev')\" v-if=\"visibleProducts.length > 1\">\r\n                <i class=\"bi bi-chevron-left\"></i>\r\n              </button>\r\n              <button class=\"carousel-btn carousel-btn-next\" @click=\"scrollFiltered('next')\" v-if=\"visibleProducts.length > 1\">\r\n                <i class=\"bi bi-chevron-right\"></i>\r\n              </button>\r\n            </div>\r\n            <template v-else>\r\n              <div class=\"product-card\" v-for=\"p in visibleProducts\" :key=\"p.id\">\r\n                <div class=\"product-image\">\r\n                  <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n                  <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n                </div>\r\n                <div class=\"product-info\">\r\n                  <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n                  <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n                  <p class=\"product-price\">\r\n                    <span v-if=\"p.discount && p.discount > 0\"\r\n                      style=\"color: #6B6B9B;text-decoration:line-through;margin-right:8px\">\r\n                      ${{ formatPrice(p.price) }}\r\n                    </span>\r\n                    <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n                  </p>\r\n                  <p class=\"product-desc\">{{ p.description }}</p>\r\n                  <div class=\"product-actions\">\r\n                    <button class=\"btn btn-outline-secondary me-2\" @click=\"openQuickView(p)\">Ver detalle</button>\r\n                    <button class=\"btn btn-primary\" @click=\"addToCart(p)\">Añadir al carrito</button>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </template>\r\n          </div>\r\n        </template>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- Login Modal -->\r\n    <div class=\"modal\" id=\"loginModal\">\r\n      <div class=\"modal-content\">\r\n        <span class=\"close\">&times;</span>\r\n        <div class=\"auth-container\">\r\n          <form class=\"auth-form\" id=\"loginForm\">\r\n            <h3>Iniciar Sesión</h3>\r\n            <div class=\"credentials-info\">\r\n              <p><strong>Credenciales de prueba:</strong></p>\r\n              <p>Email: <code>admin@fashionstore.com</code></p>\r\n              <p>Contraseña: <code>admin123</code></p>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <input type=\"email\" id=\"loginEmail\" placeholder=\"Correo electrónico\" required>\r\n            </div>\r\n            <div class=\"form-group\">\r\n              <input type=\"password\" id=\"loginPassword\" placeholder=\"Contraseña\" required>\r\n            </div>\r\n            <button type=\"submit\" class=\"btn-primary btn-full\">Ingresar</button>\r\n            <div class=\"login-error\" id=\"loginError\" style=\"display: none;\">\r\n              <p>Credenciales incorrectas. Usa las credenciales de prueba.</p>\r\n            </div>\r\n          </form>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Quick View Modal (reactive) -->\r\n    <div v-if=\"showQuickView\" class=\"quickview-overlay\" @click.self=\"closeQuickView\">\r\n      <div class=\"quickview-card\">\r\n        <button class=\"quickview-close\" @click=\"closeQuickView\"><i class=\"bi bi-x-lg\"></i></button>\r\n        <div class=\"quickview-body\">\r\n          <div class=\"quickview-left\">\r\n            <img :src=\"selectedProduct.image || getPlaceholder()\" :alt=\"selectedProduct.title\" />\r\n          </div>\r\n          <div class=\"quickview-right\">\r\n            <h3>{{ selectedProduct.title }}</h3>\r\n            <p class=\"text-muted\">{{ selectedProduct.author }}</p>\r\n            <p class=\"quickview-price\">${{ formatPrice(selectedProduct.price) }}</p>\r\n            <p>{{ selectedProduct.description }}</p>\r\n            <div class=\"mt-3\" style=\"display:flex;justify-content:center;gap:0.75rem\">\r\n              <button class=\"btn btn-primary\" @click=\"addToCart(selectedProduct)\"><i class=\"bi bi-bag-plus me-1\"></i>\r\n                Añadir al carrito</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Collection Modal -->\r\n    <div v-if=\"showDiscountsModal\" class=\"quickview-overlay\" @click.self=\"closeDiscountsModal\">\r\n      <div class=\"quickview-card collection-modal-content\" style=\"max-width:1000px\">\r\n        <button class=\"quickview-close\" @click=\"closeDiscountsModal\"><i class=\"bi bi-x-lg\"></i></button>\r\n        <div class=\"collection-container\">\r\n          <h2>Productos con Descuento</h2>\r\n          <div class=\"products-grid\">\r\n            <div class=\"product-card\" v-for=\"p in discountedProducts\" :key=\"p.id\">\r\n              <div class=\"product-image\">\r\n                <div v-if=\"p.discount && p.discount > 0\" class=\"discount-badge\">-{{ Math.round(p.discount) }}%</div>\r\n                <img :src=\"p.image || getPlaceholder()\" :alt=\"p.title\" />\r\n              </div>\r\n              <div class=\"product-info\">\r\n                <h4 class=\"product-title\">{{ p.title }}</h4>\r\n                <p class=\"product-category\">{{ p.author }}</p>\r\n                <p class=\"product-price\">\r\n                  <span style=\"color:#b8b8b8;text-decoration:line-through;margin-right:8px\">\r\n                    ${{ formatPrice(p.price) }}\r\n                  </span>\r\n                  <span>${{ formatPrice(discountedPrice(p)) }}</span>\r\n                </p>\r\n                <div class=\"product-actions\" style=\"justify-content:center\">\r\n                  <button class=\"btn btn-primary\" @click=\"addToCart(p)\"><i class=\"bi bi-bag-plus me-1\"></i>\r\n                    Añadir</button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Cart Sidebar -->\r\n    <div class=\"cart-sidebar\" :class=\"{ active: cartOpen }\">\r\n      <div class=\"cart-header\">\r\n        <h3>Carrito de Compras</h3>\r\n        <button class=\"close-cart\" @click=\"closeCart\">&times;</button>\r\n      </div>\r\n      <div class=\"cart-items\">\r\n        <div v-if=\"cartItems.length === 0\" class=\"cart-empty\">\r\n          <i class=\"bi bi-cart-x\"></i>\r\n          <p>Tu carrito está vacío</p>\r\n          <p class=\"cart-empty-subtitle\">Agrega productos para comenzar</p>\r\n        </div>\r\n        <div v-else>\r\n          <div class=\"cart-item\" v-for=\"item in cartItems\" :key=\"item.id\">\r\n            <div class=\"cart-item-image\">\r\n              <img :src=\"item.image || getPlaceholder()\" :alt=\"item.title || item.name\" />\r\n            </div>\r\n            <div class=\"cart-item-info\">\r\n              <h4 class=\"cart-item-title\">{{ item.title || item.name }}</h4>\r\n              <p class=\"cart-item-category\">{{ item.author || item.category }}</p>\r\n              <div class=\"cart-item-price-row\">\r\n                <span class=\"cart-item-price\">${{ formatPrice(discountedPrice(item)) }}</span>\r\n                <div class=\"cart-item-quantity\">\r\n                  <button class=\"qty-btn\" @click=\"decreaseQuantity(item.id)\">-</button>\r\n                  <span class=\"qty-value\">{{ item.quantity || 1 }}</span>\r\n                  <button class=\"qty-btn\" @click=\"increaseQuantity(item.id)\">+</button>\r\n                </div>\r\n              </div>\r\n              <div class=\"cart-item-subtotal\">\r\n                Subtotal: ${{ formatPrice((discountedPrice(item) * (item.quantity || 1))) }}\r\n              </div>\r\n            </div>\r\n            <button class=\"cart-item-remove\" @click=\"removeFromCart(item.id)\" title=\"Eliminar\">\r\n              <i class=\"bi bi-trash\"></i>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"cart-footer\" v-if=\"cartItems.length > 0\">\r\n        <div class=\"cart-total\">\r\n          <span>Total:</span>\r\n          <span class=\"cart-total-amount\">${{ formatPrice(cartTotal) }}</span>\r\n        </div>\r\n        <button class=\"btn-primary btn-full\" @click=\"proceedToCheckout\">Proceder al Pago</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { db } from '../firebase/config'\r\nimport { collection, getDocs } from 'firebase/firestore'\r\n\r\nexport default {\r\n  name: 'MainComponent',\r\n  data() {\r\n    return {\r\n      products: []\r\n      , showQuickView: false\r\n      , selectedProduct: null\r\n      , currentFilter: 'all'\r\n      , searchQuery: ''\r\n      , showDiscountsModal: false\r\n      , cartOpen: false\r\n      , cartItems: []\r\n      , isMobile: false\r\n      , categoryScrollPositions: {}\r\n      , filteredScrollPosition: 0\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadProducts()\r\n    this.loadCart()\r\n    this.checkMobile()\r\n    window.addEventListener('set-category', this.onSetCategory)\r\n    window.addEventListener('set-search', this.onSetSearch)\r\n    window.addEventListener('toggle-cart', this.onToggleCart)\r\n    window.addEventListener('storage', this.loadCart)\r\n    window.addEventListener('resize', this.checkMobile)\r\n  },\r\n  beforeUnmount() {\r\n    window.removeEventListener('set-category', this.onSetCategory)\r\n    window.removeEventListener('set-search', this.onSetSearch)\r\n    window.removeEventListener('toggle-cart', this.onToggleCart)\r\n    window.removeEventListener('storage', this.loadCart)\r\n  },\r\n  computed: {\r\n    cartTotal() {\r\n      return this.cartItems.reduce((total, item) => {\r\n        const price = this.discountedPrice(item)\r\n        const quantity = item.quantity || 1\r\n        return total + (price * quantity)\r\n      }, 0)\r\n    },\r\n    visibleProducts() {\r\n      const q = (this.searchQuery || '').toLowerCase().trim()\r\n      return this.products.filter(p => {\r\n        const matchesCategory = this.currentFilter === 'all' || (p.author || p.category || '').toLowerCase() === this.currentFilter\r\n        const matchesQuery = !q || [\r\n          p.title, p.name, p.author, p.category, p.description\r\n        ].filter(Boolean).some(v => String(v).toLowerCase().includes(q))\r\n        return matchesCategory && matchesQuery\r\n      })\r\n    },\r\n    discountedProducts() {\r\n      return this.products.filter(p => Number(p.discount || 0) > 0)\r\n    }\r\n  },\r\n  methods: {\r\n    async loadProducts() {\r\n      try {\r\n        // Cargar productos desde Firestore (colección: 'products')\r\n        const col = collection(db, 'products')\r\n        const snapshot = await getDocs(col)\r\n        if (!snapshot.empty) {\r\n          this.products = snapshot.docs.map(d => {\r\n            const p = d.data()\r\n            return {\r\n              id: d.id,\r\n              title: p.name || p.title || 'Sin título',\r\n              author: p.category || 'Desconocido',\r\n              description: p.description || '',\r\n              price: typeof p.price === 'number' ? p.price : parseFloat(p.price) || 0,\r\n              image: p.image || null,\r\n              stock: Number(p.stock ?? 0),\r\n              discount: Number(p.discount ?? 0)\r\n            }\r\n          })\r\n          return\r\n        }\r\n        // Si no hay documentos en Firestore, usar respaldo local si existe\r\n        const savedAdmin = localStorage.getItem('admin_products')\r\n        if (savedAdmin) {\r\n          const items = JSON.parse(savedAdmin)\r\n          this.products = items.map(p => ({\r\n            id: String(p.id),\r\n            title: p.name,\r\n            author: p.category,\r\n            description: p.description || '',\r\n            price: Number(p.price) || 0,\r\n            image: p.image || null,\r\n            stock: Number(p.stock ?? 0),\r\n            discount: Number(p.discount ?? 0)\r\n          }))\r\n        } else {\r\n          this.products = []\r\n        }\r\n      } catch (err) {\r\n        console.error('Error cargando productos en MainComponent:', err)\r\n        // Fallback a localStorage si falla la conexión a Firestore\r\n        try {\r\n          const savedAdmin = localStorage.getItem('admin_products')\r\n          if (savedAdmin) {\r\n            const items = JSON.parse(savedAdmin)\r\n            this.products = items.map(p => ({\r\n              id: String(p.id),\r\n              title: p.name,\r\n              author: p.category,\r\n              description: p.description || '',\r\n              price: Number(p.price) || 0,\r\n              image: p.image || null,\r\n              stock: Number(p.stock ?? 0),\r\n              discount: Number(p.discount ?? 0)\r\n            }))\r\n          } else {\r\n            this.products = []\r\n          }\r\n        } catch (fallbackErr) {\r\n          console.error('Error en fallback:', fallbackErr)\r\n          this.products = []\r\n        }\r\n      }\r\n    },\r\n    openDiscountsModal() {\r\n      this.showDiscountsModal = true\r\n    },\r\n    closeDiscountsModal() {\r\n      this.showDiscountsModal = false\r\n    },\r\n    setFilter(f) {\r\n      this.currentFilter = f\r\n    },\r\n    onSetCategory(e) {\r\n      this.currentFilter = e.detail || 'all'\r\n      const el = document.querySelectorAll('.filter-btn')\r\n      if (el && el.length) {\r\n        // visual state handled by :class, nothing to do\r\n      }\r\n    },\r\n    onSetSearch(e) {\r\n      this.searchQuery = e.detail || ''\r\n    },\r\n    onToggleCart() {\r\n      this.cartOpen = !this.cartOpen\r\n    },\r\n    closeCart() {\r\n      this.cartOpen = false\r\n    },\r\n    loadCart() {\r\n      try {\r\n        const saved = localStorage.getItem('cart')\r\n        this.cartItems = saved ? JSON.parse(saved) : []\r\n      } catch (err) {\r\n        console.error('Error cargando carrito:', err)\r\n        this.cartItems = []\r\n      }\r\n    },\r\n    increaseQuantity(productId) {\r\n      const item = this.cartItems.find(i => i.id === productId)\r\n      if (item) {\r\n        item.quantity = (item.quantity || 1) + 1\r\n        this.saveCart()\r\n      }\r\n    },\r\n    decreaseQuantity(productId) {\r\n      const item = this.cartItems.find(i => i.id === productId)\r\n      if (item) {\r\n        if (item.quantity > 1) {\r\n          item.quantity = item.quantity - 1\r\n        } else {\r\n          this.removeFromCart(productId)\r\n          return\r\n        }\r\n        this.saveCart()\r\n      }\r\n    },\r\n    removeFromCart(productId) {\r\n      this.cartItems = this.cartItems.filter(i => i.id !== productId)\r\n      this.saveCart()\r\n    },\r\n    saveCart() {\r\n      try {\r\n        localStorage.setItem('cart', JSON.stringify(this.cartItems))\r\n        window.dispatchEvent(new Event('storage'))\r\n      } catch (err) {\r\n        console.error('Error guardando carrito:', err)\r\n      }\r\n    },\r\n    proceedToCheckout() {\r\n      alert('Funcionalidad de pago próximamente disponible')\r\n    },\r\n    formatPrice(val) {\r\n      if (typeof val !== 'number') return val\r\n      return val.toFixed(2)\r\n    },\r\n    getPlaceholder() {\r\n      return 'data:image/svg+xml;base64,'\r\n    },\r\n    discountedPrice(p) {\r\n      const d = Number(p.discount || 0)\r\n      if (!d) return Number(p.price || 0)\r\n      return Number(p.price || 0) * (1 - d / 100)\r\n    },\r\n    viewProduct() {\r\n      this.$router.push({ name: 'Products' })\r\n    },\r\n    openQuickView(p) {\r\n      this.selectedProduct = p\r\n      this.showQuickView = true\r\n    },\r\n    closeQuickView() {\r\n      this.showQuickView = false\r\n      this.selectedProduct = null\r\n    },\r\n    addToCart(product) {\r\n      try {\r\n        const idx = this.cartItems.findIndex(i => i.id === product.id)\r\n        if (idx > -1) {\r\n          this.cartItems[idx].quantity = (this.cartItems[idx].quantity || 1) + 1\r\n        } else {\r\n          this.cartItems.push({ ...product, quantity: 1 })\r\n        }\r\n        this.saveCart()\r\n        // Open cart sidebar when item is added\r\n        this.cartOpen = true\r\n        // Small feedback (you can replace this with a toast notification)\r\n        const productName = product.title || product.name\r\n        console.log(`\"${productName}\" agregado al carrito`)\r\n      } catch (err) {\r\n        console.error('Error al agregar al carrito:', err)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;;;AAmSA,SAASA,EAAC,QAAS,oBAAmB;AACtC,SAASC,UAAU,EAAEC,OAAM,QAAS,oBAAmB;AAEvD,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAC;MACTC,aAAa,EAAE,KAAI;MACnBC,eAAe,EAAE,IAAG;MACpBC,aAAa,EAAE,KAAI;MACnBC,WAAW,EAAE,EAAC;MACdC,kBAAkB,EAAE,KAAI;MACxBC,QAAQ,EAAE,KAAI;MACdC,SAAS,EAAE,EAAC;MACZC,QAAQ,EAAE,KAAI;MACdC,uBAAuB,EAAE,CAAC;MAC1BC,sBAAsB,EAAE;IAC5B;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC;IAClB,IAAI,CAACC,QAAQ,CAAC;IACd,IAAI,CAACC,WAAW,CAAC;IACjBC,MAAM,CAACC,gBAAgB,CAAC,cAAc,EAAE,IAAI,CAACC,aAAa;IAC1DF,MAAM,CAACC,gBAAgB,CAAC,YAAY,EAAE,IAAI,CAACE,WAAW;IACtDH,MAAM,CAACC,gBAAgB,CAAC,aAAa,EAAE,IAAI,CAACG,YAAY;IACxDJ,MAAM,CAACC,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACH,QAAQ;IAChDE,MAAM,CAACC,gBAAgB,CAAC,QAAQ,EAAE,IAAI,CAACF,WAAW;EACpD,CAAC;EACDM,aAAaA,CAAA,EAAG;IACdL,MAAM,CAACM,mBAAmB,CAAC,cAAc,EAAE,IAAI,CAACJ,aAAa;IAC7DF,MAAM,CAACM,mBAAmB,CAAC,YAAY,EAAE,IAAI,CAACH,WAAW;IACzDH,MAAM,CAACM,mBAAmB,CAAC,aAAa,EAAE,IAAI,CAACF,YAAY;IAC3DJ,MAAM,CAACM,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACR,QAAQ;EACrD,CAAC;EACDS,QAAQ,EAAE;IACRC,SAASA,CAAA,EAAG;MACV,OAAO,IAAI,CAAChB,SAAS,CAACiB,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC5C,MAAMC,KAAI,GAAI,IAAI,CAACC,eAAe,CAACF,IAAI;QACvC,MAAMG,QAAO,GAAIH,IAAI,CAACG,QAAO,IAAK;QAClC,OAAOJ,KAAI,GAAKE,KAAI,GAAIE,QAAQ;MAClC,CAAC,EAAE,CAAC;IACN,CAAC;IACDC,eAAeA,CAAA,EAAG;MAChB,MAAMC,CAAA,GAAI,CAAC,IAAI,CAAC3B,WAAU,IAAK,EAAE,EAAE4B,WAAW,CAAC,CAAC,CAACC,IAAI,CAAC;MACtD,OAAO,IAAI,CAACjC,QAAQ,CAACkC,MAAM,CAACC,CAAA,IAAK;QAC/B,MAAMC,eAAc,GAAI,IAAI,CAACjC,aAAY,KAAM,KAAI,IAAK,CAACgC,CAAC,CAACE,MAAK,IAAKF,CAAC,CAACG,QAAO,IAAK,EAAE,EAAEN,WAAW,CAAC,MAAM,IAAI,CAAC7B,aAAY;QAC1H,MAAMoC,YAAW,GAAI,CAACR,CAAA,IAAK,CACzBI,CAAC,CAACK,KAAK,EAAEL,CAAC,CAACrC,IAAI,EAAEqC,CAAC,CAACE,MAAM,EAAEF,CAAC,CAACG,QAAQ,EAAEH,CAAC,CAACM,WAAU,CACpD,CAACP,MAAM,CAACQ,OAAO,CAAC,CAACC,IAAI,CAACC,CAAA,IAAK