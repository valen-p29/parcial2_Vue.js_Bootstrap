{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'MainComponent',\n  data() {\n    return {\n      products: [],\n      showQuickView: false,\n      selectedProduct: null\n    };\n  },\n  mounted() {\n    this.loadProducts();\n  },\n  methods: {\n    async loadProducts() {\n      try {\n        const res = await fetch('/product.json');\n        if (!res.ok) throw new Error('No se pudo cargar /product.json');\n        const data = await res.json();\n        const products = data.products || [];\n        this.products = products.map(p => ({\n          id: String(p.id),\n          title: p.name || p.title || 'Sin título',\n          author: p.category || 'Desconocido',\n          description: p.description || '',\n          price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\n          image: p.image || null\n        }));\n      } catch (err) {\n        console.error('Error cargando productos en MainComponent:', err);\n      }\n    },\n    formatPrice(val) {\n      if (typeof val !== 'number') return val;\n      return val.toFixed(2);\n    },\n    getPlaceholder() {\n      return 'data:image/svg+xml;base64,';\n    },\n    viewProduct() {\n      this.$router.push({\n        name: 'Products'\n      });\n    },\n    openQuickView(p) {\n      this.selectedProduct = p;\n      this.showQuickView = true;\n    },\n    closeQuickView() {\n      this.showQuickView = false;\n      this.selectedProduct = null;\n    },\n    addToCart(product) {\n      try {\n        const saved = localStorage.getItem('cart');\n        const cart = saved ? JSON.parse(saved) : [];\n        const idx = cart.findIndex(i => i.id === product.id);\n        if (idx > -1) {\n          cart[idx].quantity = (cart[idx].quantity || 1) + 1;\n        } else {\n          cart.push({\n            ...product,\n            quantity: 1\n          });\n        }\n        localStorage.setItem('cart', JSON.stringify(cart));\n        // trigger storage event for other components (navbar)\n        window.dispatchEvent(new Event('storage'));\n        // small feedback\n        alert(`\"${product.title}\" agregado al carrito`);\n      } catch (err) {\n        console.error('Error al agregar al carrito:', err);\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","products","showQuickView","selectedProduct","mounted","loadProducts","methods","res","fetch","ok","Error","json","map","p","id","String","title","author","category","description","price","parseFloat","image","err","console","error","formatPrice","val","toFixed","getPlaceholder","viewProduct","$router","push","openQuickView","closeQuickView","addToCart","product","saved","localStorage","getItem","cart","JSON","parse","idx","findIndex","i","quantity","setItem","stringify","window","dispatchEvent","Event","alert"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\components\\MainComponent.vue"],"sourcesContent":["<template>\r\n  <div class=\"main-with-sidebar\">\r\n    <section class=\"hero\">\r\n    <div class=\"hero-background\">\r\n      <img\r\n        src=\"https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80\"\r\n        alt=\"Fashion Store\" class=\"hero-bg-image\">\r\n      <div class=\"hero-overlay\"></div>\r\n    </div>\r\n    <div class=\"hero-content\">\r\n      <h2 class=\"hero-title\">Nueva Colección</h2>\r\n      <p class=\"hero-subtitle\">Descubre las últimas tendencias en moda</p>\r\n      <button class=\"btn-primary\" id=\"viewCollectionBtn\">Ver Colección</button>\r\n    </div>\r\n  </section>\r\n\r\n  <section class=\"products-section\">\r\n    <div class=\"container\">\r\n      <div class=\"section-header\">\r\n        <h3>Productos Destacados</h3>\r\n        <div class=\"filters\">\r\n          <button class=\"filter-btn active\" data-filter=\"all\">Todos</button>\r\n          <button class=\"filter-btn\" data-filter=\"hombre\">Hombre</button>\r\n          <button class=\"filter-btn\" data-filter=\"mujer\">Mujer</button>\r\n          <button class=\"filter-btn\" data-filter=\"accesorios\">Accesorios</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"products-grid\" id=\"productsGrid\">\r\n        <div class=\"product-card\" v-for=\"p in products\" :key=\"p.id\">\r\n          <div class=\"product-image\">\r\n            <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n          </div>\r\n          <div class=\"product-info\">\r\n            <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n            <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n            <p class=\"product-price\">${{ formatPrice(p.price) }}</p>\r\n            <p class=\"product-desc\">{{ p.description }}</p>\r\n            <div class=\"product-actions\">\r\n              <button class=\"btn btn-outline-secondary me-2\" @click=\"openQuickView(p)\">Ver detalle</button>\r\n              <button class=\"btn btn-primary\" @click=\"addToCart(p)\">Añadir al carrito</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Login Modal -->\r\n  <div class=\"modal\" id=\"loginModal\">\r\n    <div class=\"modal-content\">\r\n      <span class=\"close\">&times;</span>\r\n      <div class=\"auth-container\">\r\n        <form class=\"auth-form\" id=\"loginForm\">\r\n          <h3>Iniciar Sesión</h3>\r\n          <div class=\"credentials-info\">\r\n            <p><strong>Credenciales de prueba:</strong></p>\r\n            <p>Email: <code>admin@fashionstore.com</code></p>\r\n            <p>Contraseña: <code>admin123</code></p>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <input type=\"email\" id=\"loginEmail\" placeholder=\"Correo electrónico\" required>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <input type=\"password\" id=\"loginPassword\" placeholder=\"Contraseña\" required>\r\n          </div>\r\n          <button type=\"submit\" class=\"btn-primary btn-full\">Ingresar</button>\r\n          <div class=\"login-error\" id=\"loginError\" style=\"display: none;\">\r\n            <p>Credenciales incorrectas. Usa las credenciales de prueba.</p>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Quick View Modal (reactive) -->\r\n  <div v-if=\"showQuickView\" class=\"quickview-overlay\" @click.self=\"closeQuickView\">\r\n    <div class=\"quickview-card\">\r\n      <button class=\"quickview-close\" @click=\"closeQuickView\">&times;</button>\r\n      <div class=\"quickview-body\">\r\n        <div class=\"quickview-left\">\r\n          <img :src=\"selectedProduct.image || getPlaceholder()\" :alt=\"selectedProduct.title\" />\r\n        </div>\r\n        <div class=\"quickview-right\">\r\n          <h3>{{ selectedProduct.title }}</h3>\r\n          <p class=\"text-muted\">{{ selectedProduct.author }}</p>\r\n          <p class=\"quickview-price\">${{ formatPrice(selectedProduct.price) }}</p>\r\n          <p>{{ selectedProduct.description }}</p>\r\n          <div class=\"mt-3\">\r\n            <button class=\"btn btn-primary me-2\" @click=\"addToCart(selectedProduct)\">Añadir al carrito</button>\r\n            <button class=\"btn btn-outline-secondary\" @click=\"closeQuickView\">Cerrar</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Collection Modal -->\r\n  <div class=\"modal\" id=\"collectionModal\">\r\n    <div class=\"modal-content collection-modal-content\">\r\n      <span class=\"close\" id=\"closeCollectionModal\">&times;</span>\r\n      <div class=\"collection-container\">\r\n        <h2>Nueva Colección 2024</h2>\r\n        <div class=\"collection-hero\">\r\n          <img\r\n            src=\"https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80\"\r\n            alt=\"Nueva Colección\" class=\"collection-image\">\r\n          <div class=\"collection-overlay\">\r\n            <h3>Tendencias de Temporada</h3>\r\n            <p>Descubre los últimos estilos que están marcando la pauta en el mundo de la moda</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"collection-categories\">\r\n          <div class=\"collection-category\" data-category=\"hombre\">\r\n            <img\r\n              src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80\"\r\n              alt=\"Colección Hombre\">\r\n            <div class=\"category-info\">\r\n              <h4>Hombre</h4>\r\n              <p>Estilo urbano y elegante</p>\r\n              <button class=\"btn-category\">Ver Productos</button>\r\n            </div>\r\n          </div>\r\n          <div class=\"collection-category\" data-category=\"mujer\">\r\n            <img\r\n              src=\"https://images.unsplash.com/photo-1494790108755-2616c669-b6c2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80\"\r\n              alt=\"Colección Mujer\">\r\n            <div class=\"category-info\">\r\n              <h4>Mujer</h4>\r\n              <p>Sofisticación y comodidad</p>\r\n              <button class=\"btn-category\">Ver Productos</button>\r\n            </div>\r\n          </div>\r\n          <div class=\"collection-category\" data-category=\"accesorios\">\r\n            <img\r\n              src=\"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80\"\r\n              alt=\"Accesorios\">\r\n            <div class=\"category-info\">\r\n              <h4>Accesorios</h4>\r\n              <p>Complementos perfectos</p>\r\n              <button class=\"btn-category\">Ver Productos</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Cart Sidebar -->\r\n  <div class=\"cart-sidebar\" id=\"cartSidebar\">\r\n    <div class=\"cart-header\">\r\n      <h3>Carrito de Compras</h3>\r\n      <button class=\"close-cart\">&times;</button>\r\n    </div>\r\n    <div class=\"cart-items\" id=\"cartItems\">\r\n      <!-- Cart items will be dynamically loaded here -->\r\n    </div>\r\n    <div class=\"cart-footer\">\r\n      <div class=\"cart-total\">\r\n        <span>Total:</span>\r\n        <span id=\"cartTotal\">$0.00</span>\r\n      </div>\r\n      <button class=\"btn-primary btn-full\">Proceder al Pago</button>\r\n    </div>\r\n  </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MainComponent',\r\n  data() {\r\n    return {\r\n      products: []\r\n      , showQuickView: false\r\n      , selectedProduct: null\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadProducts()\r\n  },\r\n  methods: {\r\n    async loadProducts() {\r\n      try {\r\n        const res = await fetch('/product.json')\r\n        if (!res.ok) throw new Error('No se pudo cargar /product.json')\r\n        const data = await res.json()\r\n        const products = data.products || []\r\n        this.products = products.map(p => ({\r\n          id: String(p.id),\r\n          title: p.name || p.title || 'Sin título',\r\n          author: p.category || 'Desconocido',\r\n          description: p.description || '',\r\n          price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\r\n          image: p.image || null\r\n        }))\r\n      } catch (err) {\r\n        console.error('Error cargando productos en MainComponent:', err)\r\n      }\r\n    },\r\n    formatPrice(val) {\r\n      if (typeof val !== 'number') return val\r\n      return val.toFixed(2)\r\n    },\r\n    getPlaceholder() {\r\n      return 'data:image/svg+xml;base64,'\r\n    },\r\n    viewProduct() {\r\n      this.$router.push({ name: 'Products' })\r\n    },\r\n    openQuickView(p) {\r\n      this.selectedProduct = p\r\n      this.showQuickView = true\r\n    },\r\n    closeQuickView() {\r\n      this.showQuickView = false\r\n      this.selectedProduct = null\r\n    },\r\n    addToCart(product) {\r\n      try {\r\n        const saved = localStorage.getItem('cart')\r\n        const cart = saved ? JSON.parse(saved) : []\r\n        const idx = cart.findIndex(i => i.id === product.id)\r\n        if (idx > -1) {\r\n          cart[idx].quantity = (cart[idx].quantity || 1) + 1\r\n        } else {\r\n          cart.push({ ...product, quantity: 1 })\r\n        }\r\n        localStorage.setItem('cart', JSON.stringify(cart))\r\n        // trigger storage event for other components (navbar)\r\n        window.dispatchEvent(new Event('storage'))\r\n        // small feedback\r\n        alert(`\"${product.title}\" agregado al carrito`)\r\n      } catch (err) {\r\n        console.error('Error al agregar al carrito:', err)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.main-with-sidebar { margin-left: 240px; }\r\n.products-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(240px,1fr)); gap: 1rem; }\r\n.product-card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 6px 18px rgba(0,0,0,0.08); display: flex; flex-direction: column; }\r\n.product-image img { width: 100%; height: 180px; object-fit: cover; }\r\n.product-info { padding: 0.75rem; display:flex; flex-direction:column; gap:0.5rem; }\r\n.product-actions { margin-top: auto; display:flex; justify-content:flex-end; }\r\n.quickview-overlay { position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; z-index:2000; }\r\n.quickview-card { background:white; width:90%; max-width:900px; border-radius:8px; padding:1rem; position:relative; }\r\n.quickview-close { position:absolute; right:8px; top:8px; border:none; background:transparent; font-size:1.5rem; }\r\n.quickview-body { display:flex; gap:1rem; }\r\n.quickview-left img { width:320px; height:320px; object-fit:cover; border-radius:6px; }\r\n.quickview-right { flex:1; }\r\n@media(max-width:768px){ .main-with-sidebar { margin-left:0; } .quickview-left img { width:160px; height:160px; } }\r\n</style>"],"mappings":";;;AAwKA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAC;MACTC,aAAa,EAAE,KAAI;MACnBC,eAAe,EAAE;IACrB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC;EACpB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAME,GAAE,GAAI,MAAMC,KAAK,CAAC,eAAe;QACvC,IAAI,CAACD,GAAG,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,iCAAiC;QAC9D,MAAMV,IAAG,GAAI,MAAMO,GAAG,CAACI,IAAI,CAAC;QAC5B,MAAMV,QAAO,GAAID,IAAI,CAACC,QAAO,IAAK,EAAC;QACnC,IAAI,CAACA,QAAO,GAAIA,QAAQ,CAACW,GAAG,CAACC,CAAA,KAAM;UACjCC,EAAE,EAAEC,MAAM,CAACF,CAAC,CAACC,EAAE,CAAC;UAChBE,KAAK,EAAEH,CAAC,CAACd,IAAG,IAAKc,CAAC,CAACG,KAAI,IAAK,YAAY;UACxCC,MAAM,EAAEJ,CAAC,CAACK,QAAO,IAAK,aAAa;UACnCC,WAAW,EAAEN,CAAC,CAACM,WAAU,IAAK,EAAE;UAChCC,KAAK,EAAE,OAAOP,CAAC,CAACO,KAAI,KAAM,QAAO,GAAIP,CAAC,CAACO,KAAI,GAAI,GAAE,GAAIC,UAAU,CAACR,CAAC,CAACO,KAAK,KAAK,CAAC;UAC7EE,KAAK,EAAET,CAAC,CAACS,KAAI,IAAK;QACpB,CAAC,CAAC;MACJ,EAAE,OAAOC,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,4CAA4C,EAAEF,GAAG;MACjE;IACF,CAAC;IACDG,WAAWA,CAACC,GAAG,EAAE;MACf,IAAI,OAAOA,GAAE,KAAM,QAAQ,EAAE,OAAOA,GAAE;MACtC,OAAOA,GAAG,CAACC,OAAO,CAAC,CAAC;IACtB,CAAC;IACDC,cAAcA,CAAA,EAAG;MACf,OAAO,4VAA2V;IACpW,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC;QAAEjC,IAAI,EAAE;MAAW,CAAC;IACxC,CAAC;IACDkC,aAAaA,CAACpB,CAAC,EAAE;MACf,IAAI,CAACV,eAAc,GAAIU,CAAA;MACvB,IAAI,CAACX,aAAY,GAAI,IAAG;IAC1B,CAAC;IACDgC,cAAcA,CAAA,EAAG;MACf,IAAI,CAAChC,aAAY,GAAI,KAAI;MACzB,IAAI,CAACC,eAA