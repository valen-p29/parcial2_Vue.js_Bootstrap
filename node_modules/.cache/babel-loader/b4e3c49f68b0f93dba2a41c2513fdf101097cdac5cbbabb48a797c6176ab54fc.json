{"ast":null,"code":"export default {\n  name: 'AdminPanelView',\n  data() {\n    return {\n      books: []\n    };\n  },\n  created() {\n    // Aquí cargarías los libros desde tu API o Firebase\n    this.loadBooks();\n  },\n  methods: {\n    async loadBooks() {\n      try {\n        // Implementar carga de libros desde tu backend\n        // this.books = await fetchBooks();\n      } catch (error) {\n        console.error('Error al cargar libros:', error);\n      }\n    },\n    showAddBookModal() {\n      // Implementar lógica para mostrar modal de añadir libro\n    },\n    async updateStock(book) {\n      try {\n        // Implementar actualización de stock en backend\n        console.log(`Actualizando stock del libro ${book.id} a ${book.stock}`);\n      } catch (error) {\n        console.error('Error al actualizar stock:', error);\n      }\n    },\n    editBook(book) {\n      // Implementar lógica para editar libro\n      console.log('Editando libro:', book);\n    },\n    async deleteBook(bookId) {\n      if (confirm('¿Estás seguro de que deseas eliminar este libro?')) {\n        try {\n          // Implementar eliminación en backend\n          console.log('Eliminando libro:', bookId);\n        } catch (error) {\n          console.error('Error al eliminar libro:', error);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","books","created","loadBooks","methods","error","console","showAddBookModal","updateStock","book","log","id","stock","editBook","deleteBook","bookId","confirm"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\AdminPanelView.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-panel\">\r\n    <div class=\"container py-4\">\r\n      <h1 class=\"mb-4\">Panel de Administración</h1>\r\n      \r\n      <!-- Tabla de gestión de libros -->\r\n      <div class=\"card\">\r\n        <div class=\"card-header d-flex justify-content-between align-items-center\">\r\n          <h3 class=\"mb-0\">Gestión de Stock</h3>\r\n          <button class=\"btn btn-primary\" @click=\"showAddBookModal\">\r\n            <i class=\"bi bi-plus-circle\"></i> Añadir Libro\r\n          </button>\r\n        </div>\r\n        <div class=\"card-body\">\r\n          <div class=\"table-responsive\">\r\n            <table class=\"table\">\r\n              <thead>\r\n                <tr>\r\n                  <th>ID</th>\r\n                  <th>Título</th>\r\n                  <th>Autor</th>\r\n                  <th>Stock</th>\r\n                  <th>Precio</th>\r\n                  <th>Estado</th>\r\n                  <th>Descuento</th>\r\n                  <th>Acciones</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody>\r\n                <tr v-for=\"book in books\" :key=\"book.id\">\r\n                  <td>{{ book.id }}</td>\r\n                  <td>{{ book.title }}</td>\r\n                  <td>{{ book.author }}</td>\r\n                  <td>\r\n                    <input \r\n                      type=\"number\" \r\n                      v-model.number=\"book.stock\"\r\n                      class=\"form-control form-control-sm w-75\"\r\n                      min=\"0\"\r\n                      @change=\"updateStock(book)\"\r\n                    >\r\n                  </td>\r\n                  <td>\r\n                    <div class=\"input-group input-group-sm\">\r\n                      <span class=\"input-group-text\">$</span>\r\n                      <input \r\n                        type=\"number\" \r\n                        v-model.number=\"book.price\"\r\n                        class=\"form-control form-control-sm\"\r\n                        min=\"0\"\r\n                        step=\"0.01\"\r\n                        @change=\"updateBook(book)\"\r\n                      >\r\n                    </div>\r\n                  </td>\r\n                  <td>\r\n                    <select \r\n                      v-model=\"book.status\" \r\n                      class=\"form-select form-select-sm\"\r\n                      @change=\"updateBook(book)\"\r\n                    >\r\n                      <option value=\"available\">Disponible</option>\r\n                      <option value=\"upcoming\">Próximamente</option>\r\n                      <option value=\"outOfStock\">Agotado</option>\r\n                    </select>\r\n                  </td>\r\n                  <td>\r\n                    <div class=\"input-group input-group-sm\">\r\n                      <input \r\n                        type=\"number\" \r\n                        v-model.number=\"book.discountPercentage\"\r\n                        class=\"form-control form-control-sm\"\r\n                        min=\"0\"\r\n                        max=\"100\"\r\n                        @change=\"updateBook(book)\"\r\n                      >\r\n                      <span class=\"input-group-text\">%</span>\r\n                    </div>\r\n                  </td>\r\n                  <td>\r\n                    <button class=\"btn btn-sm btn-warning me-2\" @click=\"editBook(book)\">\r\n                      <i class=\"bi bi-pencil\"></i>\r\n                    </button>\r\n                    <button class=\"btn btn-sm btn-danger\" @click=\"deleteBook(book.id)\">\r\n                      <i class=\"bi bi-trash\"></i>\r\n                    </button>\r\n                  </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'AdminPanelView',\r\n  data() {\r\n    return {\r\n      books: []\r\n    }\r\n  },\r\n  created() {\r\n    // Aquí cargarías los libros desde tu API o Firebase\r\n    this.loadBooks()\r\n  },\r\n  methods: {\r\n    async loadBooks() {\r\n      try {\r\n        // Implementar carga de libros desde tu backend\r\n        // this.books = await fetchBooks();\r\n      } catch (error) {\r\n        console.error('Error al cargar libros:', error)\r\n      }\r\n    },\r\n    showAddBookModal() {\r\n      // Implementar lógica para mostrar modal de añadir libro\r\n    },\r\n    async updateStock(book) {\r\n      try {\r\n        // Implementar actualización de stock en backend\r\n        console.log(`Actualizando stock del libro ${book.id} a ${book.stock}`)\r\n      } catch (error) {\r\n        console.error('Error al actualizar stock:', error)\r\n      }\r\n    },\r\n    editBook(book) {\r\n      // Implementar lógica para editar libro\r\n      console.log('Editando libro:', book)\r\n    },\r\n    async deleteBook(bookId) {\r\n      if (confirm('¿Estás seguro de que deseas eliminar este libro?')) {\r\n        try {\r\n          // Implementar eliminación en backend\r\n          console.log('Eliminando libro:', bookId)\r\n        } catch (error) {\r\n          console.error('Error al eliminar libro:', error)\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.admin-panel {\r\n  background-color: #f8f9fa;\r\n  min-height: calc(100vh - 60px);\r\n}\r\n\r\n.table th {\r\n  background-color: #f1f1f1;\r\n}\r\n\r\n.form-control-sm {\r\n  width: 80px;\r\n}\r\n</style>"],"mappings":"AAkGA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE;IACT;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,CAACC,SAAS,CAAC;EACjB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,SAASA,CAAA,EAAG;MAChB,IAAI;QACF;QACA;MAAA,CACF,CAAE,OAAOE,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK;MAChD;IACF,CAAC;IACDE,gBAAgBA,CAAA,EAAG;MACjB;IAAA,CACD;IACD,MAAMC,WAAWA,CAACC,IAAI,EAAE;MACtB,IAAI;QACF;QACAH,OAAO,CAACI,GAAG,CAAC,gCAAgCD,IAAI,CAACE,EAAE,MAAMF,IAAI,CAACG,KAAK,EAAE;MACvE,EAAE,OAAOP,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK;MACnD;IACF,CAAC;IACDQ,QAAQA,CAACJ,IAAI,EAAE;MACb;MACAH,OAAO,CAACI,GAAG,CAAC,iBAAiB,EAAED,IAAI;IACrC,CAAC;IACD,MAAMK,UAAUA,CAACC,MAAM,EAAE;MACvB,IAAIC,OAAO,CAAC,kDAAkD,C