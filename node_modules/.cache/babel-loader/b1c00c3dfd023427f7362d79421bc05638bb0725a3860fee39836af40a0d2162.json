{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'AdminPanelView',\n  data() {\n    return {\n      books: []\n    };\n  },\n  created() {\n    this.loadBooks();\n  },\n  methods: {\n    async loadBooks() {\n      try {\n        const saved = localStorage.getItem('admin_books');\n        if (saved) {\n          this.books = JSON.parse(saved);\n        } else {\n          const res = await fetch('/product.json');\n          if (!res.ok) throw new Error('No se pudo cargar /product.json');\n          const data = await res.json();\n          const products = data.products || [];\n          this.books = products.map(p => ({\n            id: String(p.id),\n            title: p.name || p.title || 'Sin título',\n            author: p.category || 'Desconocido',\n            description: p.description || '',\n            price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\n            stock: p.stock !== undefined ? p.stock : 10,\n            imageUrl: p.image || null\n          }));\n          localStorage.setItem('admin_books', JSON.stringify(this.books));\n        }\n      } catch (err) {\n        console.error('Error al cargar libros en admin:', err);\n        this.books = [];\n      }\n    },\n    saveBooks() {\n      localStorage.setItem('admin_books', JSON.stringify(this.books));\n    },\n    addBook() {\n      const title = prompt('Título del libro:');\n      if (!title) return;\n      const author = prompt('Autor:', 'Desconocido') || 'Desconocido';\n      const priceStr = prompt('Precio (ej: 19.99):', '0') || '0';\n      const stockStr = prompt('Stock:', '10') || '10';\n      const price = parseFloat(priceStr) || 0;\n      const stock = parseInt(stockStr) || 0;\n      const id = String(Date.now());\n      const newBook = {\n        id,\n        title,\n        author,\n        price,\n        stock\n      };\n      this.books.push(newBook);\n      this.saveBooks();\n    },\n    editBook(book) {\n      const title = prompt('Título del libro:', book.title);\n      if (title === null) return;\n      const author = prompt('Autor:', book.author) || book.author;\n      const priceStr = prompt('Precio (ej: 19.99):', String(book.price)) || String(book.price);\n      const stockStr = prompt('Stock:', String(book.stock)) || String(book.stock);\n      book.title = title;\n      book.author = author;\n      book.price = parseFloat(priceStr) || book.price;\n      book.stock = parseInt(stockStr) || book.stock;\n      this.saveBooks();\n    },\n    deleteBook(bookId) {\n      if (!confirm('¿Seguro que quieres eliminar este libro?')) return;\n      this.books = this.books.filter(b => b.id !== bookId);\n      this.saveBooks();\n    },\n    cerrarSesion() {\n      localStorage.removeItem('usuarioActivo');\n      localStorage.removeItem('userRole');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["name","data","books","created","loadBooks","methods","saved","localStorage","getItem","JSON","parse","res","fetch","ok","Error","json","products","map","p","id","String","title","author","category","description","price","parseFloat","stock","undefined","imageUrl","image","setItem","stringify","err","console","error","saveBooks","addBook","prompt","priceStr","stockStr","parseInt","Date","now","newBook","push","editBook","book","deleteBook","bookId","confirm","filter","b","cerrarSesion","removeItem","$router"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\views\\AdminPanelView.vue"],"sourcesContent":["<template>\r\n\t<div class=\"admin-panel container py-4\">\r\n\t\t<nav class=\"d-flex justify-content-between align-items-center mb-4\">\r\n\t\t\t<h2>Panel de Administración</h2>\r\n\t\t\t<div>\r\n\t\t\t\t<button class=\"btn btn-secondary me-2\" @click=\"$router.push('/productos')\">Ir a tienda</button>\r\n\t\t\t\t<button class=\"btn btn-danger\" @click=\"cerrarSesion\">Cerrar sesión</button>\r\n\t\t\t</div>\r\n\t\t</nav>\r\n\r\n\t\t<div class=\"mb-3\">\r\n\t\t\t<button class=\"btn btn-primary\" @click=\"addBook\">Añadir Libro</button>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"table-responsive\">\r\n\t\t\t<table class=\"table table-striped\">\r\n\t\t\t\t<thead>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<th>ID</th>\r\n\t\t\t\t\t\t<th>Título</th>\r\n\t\t\t\t\t\t<th>Autor</th>\r\n\t\t\t\t\t\t<th>Stock</th>\r\n\t\t\t\t\t\t<th>Precio</th>\r\n\t\t\t\t\t\t<th>Acciones</th>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</thead>\r\n\t\t\t\t<tbody>\r\n\t\t\t\t\t<tr v-for=\"book in books\" :key=\"book.id\">\r\n\t\t\t\t\t\t<td>{{ book.id }}</td>\r\n\t\t\t\t\t\t<td>{{ book.title }}</td>\r\n\t\t\t\t\t\t<td>{{ book.author }}</td>\r\n\t\t\t\t\t\t<td>{{ book.stock }}</td>\r\n\t\t\t\t\t\t<td>{{ book.price }}</td>\r\n\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t<button class=\"btn btn-sm btn-warning me-2\" @click=\"editBook(book)\">Editar</button>\r\n\t\t\t\t\t\t\t<button class=\"btn btn-sm btn-danger\" @click=\"deleteBook(book.id)\">Eliminar</button>\r\n\t\t\t\t\t\t</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</tbody>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n\tname: 'AdminPanelView',\r\n\tdata() {\r\n\t\treturn {\r\n\t\t\tbooks: []\r\n\t\t}\r\n\t},\r\n\tcreated() {\r\n\t\tthis.loadBooks()\r\n\t},\r\n\tmethods: {\r\n\t\tasync loadBooks() {\r\n\t\t\ttry {\r\n\t\t\t\tconst saved = localStorage.getItem('admin_books')\r\n\t\t\t\tif (saved) {\r\n\t\t\t\t\tthis.books = JSON.parse(saved)\r\n\t\t\t\t} else {\r\n\t\t\t\t\tconst res = await fetch('/product.json')\r\n\t\t\t\t\tif (!res.ok) throw new Error('No se pudo cargar /product.json')\r\n\t\t\t\t\tconst data = await res.json()\r\n\t\t\t\t\tconst products = data.products || []\r\n\t\t\t\t\tthis.books = products.map(p => ({\r\n\t\t\t\t\t\tid: String(p.id),\r\n\t\t\t\t\t\ttitle: p.name || p.title || 'Sin título',\r\n\t\t\t\t\t\