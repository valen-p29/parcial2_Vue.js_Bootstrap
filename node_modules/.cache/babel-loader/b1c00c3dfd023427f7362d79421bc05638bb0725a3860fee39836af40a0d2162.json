\n\t\t\tlocalStorage.removeItem('usuarioActivo')\r\n\t\t\tlocalStorage.removeItem('userRole')\r\n\t\t\tthis.$router.push('/login')\r\n\t\t}\r\n\t}\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.admin-panel h2 { margin: 0; }\r\n</style>\r\n"],"mappings":";;;;AA6CA,eAAe;EACdA,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACN,OAAO;MACNC,KAAK,EAAE;IACR;EACD,CAAC;EACDC,OAAOA,CAAA,EAAG;IACT,IAAI,CAACC,SAAS,CAAC;EAChB,CAAC;EACDC,OAAO,EAAE;IACR,MAAMD,SAASA,CAAA,EAAG;MACjB,IAAI;QACH,MAAME,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,aAAa;QAChD,IAAIF,KAAK,EAAE;UACV,IAAI,CAACJ,KAAI,GAAIO,IAAI,CAACC,KAAK,CAACJ,KAAK;QAC9B,OAAO;UACN,MAAMK,GAAE,GAAI,MAAMC,KAAK,CAAC,eAAe;UACvC,IAAI,CAACD,GAAG,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,iCAAiC;UAC9D,MAAMb,IAAG,GAAI,MAAMU,GAAG,CAACI,IAAI,CAAC;UAC5B,MAAMC,QAAO,GAAIf,IAAI,CAACe,QAAO,IAAK,EAAC;UACnC,IAAI,CAACd,KAAI,GAAIc,QAAQ,CAACC,GAAG,CAACC,CAAA,KAAM;YAC/BC,EAAE,EAAEC,MAAM,CAACF,CAAC,CAACC,EAAE,CAAC;YAChBE,KAAK,EAAEH,CAAC,CAAClB,IAAG,IAAKkB,CAAC,CAACG,KAAI,IAAK,YAAY;YACxCC,MAAM,EAAEJ,CAAC,CAACK,QAAO,IAAK,aAAa;YACnCC,WAAW,EAAEN,CAAC,CAACM,WAAU,IAAK,EAAE;YAChCC,KAAK,EAAE,OAAOP,CAAC,CAACO,KAAI,KAAM,QAAO,GAAIP,CAAC,CAACO,KAAI,GAAI,GAAE,GAAIC,UAAU,CAACR,CAAC,CAACO,KAAK,KAAK,CAAC;YAC7EE,KAAK,EAAET,CAAC,CAACS,KAAI,KAAMC,SAAQ,GAAIV,CAAC,CAACS,KAAI,GAAI,EAAE;YAC3CE,QAAQ,EAAEX,CAAC,CAACY,KAAI,IAAK;UACtB,CAAC,CAAC;UACFvB,YAAY,CAACwB,OAAO,CAAC,aAAa,EAAEtB,IAAI,CAACuB,SAAS,CAAC,IAAI,CAAC9B,KAAK,CAAC;QAC/D;MACD,EAAE,OAAO+B,GAAG,EAAE;QACbC,OAAO,CAACC,KAAK,CAAC,kCAAkC,EAAEF,GAAG;QACrD,IAAI,CAAC/B,KAAI,GAAI,EAAC;MACf;IACD,CAAC;IACDkC,SAASA,CAAA,EAAG;MACX7B,YAAY,CAACwB,OAAO,CAAC,aAAa,EAAEtB,IAAI,CAACuB,SAAS,CAAC,IAAI,CAAC9B,KAAK,CAAC;IAC/D,CAAC;IACDmC,OAAOA,CAAA,EAAG;MACT,MAAMhB,KAAI,GAAIiB,MAAM,CAAC,mBAAmB;MACxC,IAAI,CAACjB,KAAK,EAAE;MACZ,MAAMC,MAAK,GAAIgB,MAAM,CAAC,QAAQ,EAAE,aAAa,KAAK,aAAY;MAC9D,MAAMC,QAAO,GAAID,MAAM,CAAC,qBAAqB,EAAE,GAAG,KAAK,GAAE;MACzD,MAAME,QAAO,GAAIF,MAAM,CAAC,QAAQ,EAAE,IAAI,KAAK,IAAG;MAC9C,MAAMb,KAAI,GAAIC,UAAU,CAACa,QAAQ,KAAK;MACtC,MAAMZ,KAAI,GAAIc,QAAQ,C