{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport axios from \"axios\";\nimport * as bootstrap from \"bootstrap\";\nexport default {\n  name: \"ProductsView\",\n  data() {\n    return {\n      productos: [],\n      product: {\n        title: \"\",\n        price: 0,\n        category: \"\",\n        image: \"\"\n      },\n      search: \"\",\n      selectedProduct: null,\n      editMode: false,\n      modalInstance: null,\n      detailsInstance: null\n    };\n  },\n  computed: {\n    filteredProducts() {\n      return this.productos.filter(p => p.title.toLowerCase().includes(this.search.toLowerCase()));\n    }\n  },\n  mounted() {\n    this.fetchProducts();\n  },\n  methods: {\n    async fetchProducts() {\n      const res = await axios.get(\"https://fakestoreapi.com/products\");\n      this.productos = res.data;\n    },\n    openModal() {\n      this.editMode = false;\n      this.product = {\n        title: \"\",\n        price: 0,\n        category: \"\",\n        image: \"\"\n      };\n      this.modalInstance = new bootstrap.Modal(this.$refs.productModal);\n      this.modalInstance.show();\n    },\n    editProduct(producto) {\n      this.editMode = true;\n      this.product = {\n        ...producto\n      };\n      this.modalInstance = new bootstrap.Modal(this.$refs.productModal);\n      this.modalInstance.show();\n    },\n    async saveProduct() {\n      if (this.editMode) {\n        // PUT (actualización simulada)\n        const index = this.productos.findIndex(p => p.id === this.product.id);\n        this.productos[index] = {\n          ...this.product\n        };\n      } else {\n        // POST (agregar simuladamente)\n        const newProduct = {\n          ...this.product,\n          id: Date.now()\n        };\n        this.productos.push(newProduct);\n      }\n      this.modalInstance.hide();\n    },\n    async deleteProduct(id) {\n      if (confirm(\"¿Seguro que deseas eliminar este producto?\")) {\n        this.productos = this.productos.filter(p => p.id !== id);\n      }\n    },\n    viewDetails(producto) {\n      this.selectedProduct = producto;\n      this.detailsInstance = new bootstrap.Modal(this.$refs.detailsModal);\n      this.detailsInstance.show();\n    }\n  }\n};","map":{"version":3,"names":["axios","bootstrap","name","data","productos","product","title","price","category","image","search","selectedProduct","editMode","modalInstance","detailsInstance","computed","filteredProducts","filter","p","toLowerCase","includes","mounted","fetchProducts","methods","res","get","openModal","Modal","$refs","productModal","show","editProduct","producto","saveProduct","index","findIndex","id","newProduct","Date","now","push","hide","deleteProduct","confirm","viewDetails","detailsModal"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\ProductsView.vue"],"sourcesContent":["<template>\r\n  <div class=\"products-view\">\r\n    <h3 class=\"mb-4\">Gestión de Productos</h3>\r\n\r\n    <!-- Botón para agregar -->\r\n    <div class=\"mb-3 d-flex justify-content-between align-items-center\">\r\n      <button @click=\"openModal()\" class=\"btn btn-success\">\r\n        <i class=\"bi bi-plus-circle\"></i> Agregar Producto\r\n      </button>\r\n      <input\r\n        v-model=\"search\"\r\n        type=\"text\"\r\n        class=\"form-control w-25\"\r\n        placeholder=\"Buscar producto...\"\r\n      />\r\n    </div>\r\n\r\n    <!-- Tabla de productos -->\r\n    <table class=\"table table-hover align-middle\">\r\n      <thead class=\"table-primary\">\r\n        <tr>\r\n          <th>ID</th>\r\n          <th>Nombre</th>\r\n          <th>Precio</th>\r\n          <th>Categoría</th>\r\n          <th>Acciones</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"producto in filteredProducts\" :key=\"producto.id\">\r\n          <td>{{ producto.id }}</td>\r\n          <td>{{ producto.title }}</td>\r\n          <td>\\${{ producto.price.toFixed(2) }}</td>\r\n          <td>{{ producto.category }}</td>\r\n          <td>\r\n            <button class=\"btn btn-info btn-sm me-1\" @click=\"viewDetails(producto)\">\r\n              <i class=\"bi bi-eye\"></i>\r\n            </button>\r\n            <button class=\"btn btn-warning btn-sm me-1\" @click=\"editProduct(producto)\">\r\n              <i class=\"bi bi-pencil\"></i>\r\n            </button>\r\n            <button class=\"btn btn-danger btn-sm\" @click=\"deleteProduct(producto.id)\">\r\n              <i class=\"bi bi-trash\"></i>\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n\r\n    <!-- Modal agregar / editar -->\r\n    <div\r\n      class=\"modal fade\"\r\n      id=\"productModal\"\r\n      tabindex=\"-1\"\r\n      aria-hidden=\"true\"\r\n      ref=\"productModal\"\r\n    >\r\n      <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\">\r\n          <div class=\"modal-header\">\r\n            <h5 class=\"modal-title\">{{ editMode ? \"Editar\" : \"Agregar\" }} producto</h5>\r\n            <button\r\n              type=\"button\"\r\n              class=\"btn-close\"\r\n              data-bs-dismiss=\"modal\"\r\n              aria-label=\"Close\"\r\n            ></button>\r\n          </div>\r\n\r\n          <div class=\"modal-body\">\r\n            <form @submit.prevent=\"saveProduct\">\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Nombre</label>\r\n                <input v-model=\"product.title\" class=\"form-control\" required />\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Precio</label>\r\n                <input v-model.number=\"product.price\" type=\"number\" class=\"form-control\" required />\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Categoría</label>\r\n                <input v-model=\"product.category\" class=\"form-control\" required />\r\n              </div>\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label\">Imagen (URL)</label>\r\n                <input v-model=\"product.image\" class=\"form-control\" required />\r\n              </div>\r\n\r\n              <div class=\"text-end\">\r\n                <button type=\"submit\" class=\"btn btn-primary\">\r\n                  {{ editMode ? \"Actualizar\" : \"Guardar\" }}\r\n                </button>\r\n              </div>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Modal Detalles -->\r\n    <div\r\n      class=\"modal fade\"\r\n      id=\"detailsModal\"\r\n      tabindex=\"-1\"\r\n      aria-hidden=\"true\"\r\n      ref=\"detailsModal\"\r\n    >\r\n      <div class=\"modal-dialog modal-dialog-centered\">\r\n        <div class=\"modal-content p-3\">\r\n          <h5 class=\"mb-3 text-center\">{{ selectedProduct?.title }}</h5>\r\n          <img\r\n            :src=\"selectedProduct?.image\"\r\n            alt=\"imagen\"\r\n            class=\"img-fluid rounded mb-3\"\r\n          />\r\n          <p><strong>Precio:</strong> ${{ selectedProduct?.price }}</p>\r\n          <p><strong>Categoría:</strong> {{ selectedProduct?.category }}</p>\r\n          <p><strong>Descripción:</strong> {{ selectedProduct?.description }}</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\nimport * as bootstrap from \"bootstrap\";\r\n\r\nexport default {\r\n  name: \"ProductsView\",\r\n  data() {\r\n    return {\r\n      productos: [],\r\n      product: { title: \"\", price: 0, category: \"\", image: \"\" },\r\n      search: \"\",\r\n      selectedProduct: null,\r\n      editMode: false,\r\n      modalInstance: null,\r\n      detailsInstance: null,\r\n    };\r\n  },\r\n  computed: {\r\n    filteredProducts() {\r\n      return this.productos.filter((p) =>\r\n        p.title.toLowerCase().includes(this.search.toLowerCase())\r\n      );\r\n    },\r\n  },\r\n  mounted() {\r\n    this.fetchProducts();\r\n  },\r\n  methods: {\r\n    async fetchProducts() {\r\n      const res = await axios.get(\"https://fakestoreapi.com/products\");\r\n      this.productos = res.data;\r\n    },\r\n    openModal() {\r\n      this.editMode = false;\r\n      this.product = { title: \"\", price: 0, category: \"\", image: \"\" };\r\n      this.modalInstance = new bootstrap.Modal(this.$refs.productModal);\r\n      this.modalInstance.show();\r\n    },\r\n    editProduct(producto) {\r\n      this.editMode = true;\r\n      this.product = { ...producto };\r\n      this.modalInstance = new bootstrap.Modal(this.$refs.productModal);\r\n      this.modalInstance.show();\r\n    },\r\n    async saveProduct() {\r\n      if (this.editMode) {\r\n        // PUT (actualización simulada)\r\n        const index = this.productos.findIndex((p) => p.id === this.product.id);\r\n        this.productos[index] = { ...this.product };\r\n      } else {\r\n        // POST (agregar simuladamente)\r\n        const newProduct = { ...this.product, id: Date.now() };\r\n        this.productos.push(newProduct);\r\n      }\r\n      this.modalInstance.hide();\r\n    },\r\n    async deleteProduct(id) {\r\n      if (confirm(\"¿Seguro que deseas eliminar este producto?\")) {\r\n        this.productos = this.productos.filter((p) => p.id !== id);\r\n      }\r\n    },\r\n    viewDetails(producto) {\r\n      this.selectedProduct = producto;\r\n      this.detailsInstance = new bootstrap.Modal(this.$refs.detailsModal);\r\n      this.detailsInstance.show();\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.products-view {\r\n  background-color: #fff;\r\n  border-radius: 12px;\r\n  padding: 20px;\r\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);\r\n}\r\nimg {\r\n  max-height: 250px;\r\n  object-fit: contain;\r\n}\r\n</style>\r\n"],"mappings":";;;AA6HA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAO,KAAKC,SAAQ,MAAO,WAAW;AAEtC,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE;QAAEC,KAAK,EAAE,EAAE;QAAEC,KAAK,EAAE,CAAC;QAAEC,QAAQ,EAAE,EAAE;QAAEC,KAAK,EAAE;MAAG,CAAC;MACzDC,MAAM,EAAE,EAAE;MACVC,eAAe,EAAE,IAAI;MACrBC,QAAQ,EAAE,KAAK;MACfC,aAAa,EAAE,IAAI;MACnBC,eAAe,EAAE;IACnB,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,gBAAgBA,CAAA,EAAG;MACjB,OAAO,IAAI,CAACZ,SAAS,CAACa,MAAM,CAAEC,CAAC,IAC7BA,CAAC,CAACZ,KAAK,CAACa,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,IAAI,CAACV,MAAM,CAACS,WAAW,CAAC,CAAC,CAC1D,CAAC;IACH;EACF,CAAC;EACDE,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC,CAAC;EACtB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACpB,MAAME,GAAE,GAAI,MAAMxB,KAAK,CAACyB,GAAG,CAAC,mCAAmC,CAAC;MAChE,IAAI,CAACrB,SAAQ,GAAIoB,GAAG,CAACrB,IAAI;IAC3B,CAAC;IACDuB,SAASA,CAAA,EAAG;MACV,IAAI,CAACd,QAAO,GAAI,KAAK;MACrB,IAAI,CAACP,OAAM,GAAI;QAAEC,KAAK,EAAE,EAAE;QAAEC,KAAK,EAAE,CAAC;QAAEC,QAAQ,EAAE,EAAE;QAAEC,KAAK,EAAE;MAAG,CAAC;MAC/D,IAAI,CAACI,aAAY,GAAI,IAAIZ,SAAS,CAAC0B,KAAK,CAAC,IAAI,CAACC,KAAK,CAACC,YAAY,CAAC;MACjE,IAAI,CAAChB,aAAa,CAACiB,IAAI,CAAC,CAAC;IAC3B,CAAC;IACDC,WAAWA,CAACC,QAAQ,EAAE;MACpB,IAAI,CAACpB,QAAO,GAAI,IAAI;MACpB,IAAI,CAACP,OAAM,GAAI;QAAE,GAAG2B;MAAS,CAAC;MAC9B,IAAI,CAACnB,aAAY,GAAI,IAAIZ,SAAS,CAAC0B,KAAK,CAAC,IAAI,CAACC,KAAK,CAACC,YAAY,CAAC;MACjE,IAAI,CAAChB,aAAa,CAACiB,IAAI,CAAC,CAAC;IAC3B,CAAC;IACD,MAAMG,WAAWA,CAAA,EAAG;MAClB,IAAI,IAAI,CAACrB,QAAQ,EAAE;QACjB;QACA,MAAMsB,KAAI,GAAI,IAAI,CAAC9B,SAAS,CAAC+B,SAAS,CAAEjB,CAAC,IAAKA,CAAC,CAACkB,EAAC,KAAM,IAAI,CAAC/B,OAAO,CAAC+B,EAAE,CAAC;QACvE,IAAI,CAAChC,SAAS,CAAC8B,KAAK,IAAI;UAAE,GAAG,IAAI,CAAC7B;QAAQ,CAAC;MAC7C,OAAO;QACL;QACA,MAAMgC,UAAS,GAAI;UAAE,GAAG,IAAI,CAAChC,OAAO;UAAE+B,EAAE,EAAEE,IAAI,CAACC,GAAG,CAAC;QAAE,CAAC;QACtD,IAAI,CAACnC,SAAS,CAACoC,IAAI,CAACH,UAAU,CAAC;MACjC;MACA,IAAI,CAACxB,aAAa,CAAC4B,IAAI,CAAC,CAAC;IAC3B,CAAC;IACD,MAAMC,aAAaA,CAACN,EAAE,EAAE;MACtB,IAAIO,OAAO,CAAC,4CAA4C,CAAC,EAAE;QACzD,IAAI,CAACvC,SA