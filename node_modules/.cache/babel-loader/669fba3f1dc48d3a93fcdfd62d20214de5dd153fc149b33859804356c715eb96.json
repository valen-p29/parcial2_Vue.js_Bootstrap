{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { onAuthStateChanged, signOut } from \"firebase/auth\";\nimport { auth } from \"../firebase/config\";\nimport NavbarComponent from \"../components/NavbarComponent.vue\";\nimport NexusComponent from \"@/components/NexusComponent.vue\";\nimport FooterComponent from \"../components/FooterComponent.vue\";\nexport default {\n  name: \"DashboardView\",\n  components: {\n    NavbarComponent,\n    NexusComponent,\n    FooterComponent\n  },\n  // Nota: se removió la redirección automática desde mounted() para\n  // permitir que la vista muestre contenido público (como NexusComponent)\n  // incluso cuando no haya un usuario autenticado. Si la intención es\n  // proteger toda la dashboard para usuarios autenticados, es mejor\n  // mover esta lógica al guard de rutas (router) o agregar meta.requiresAuth\n  // a la ruta \"/\".\n  methods: {\n    async logout() {\n      await signOut(auth);\n      localStorage.removeItem(\"usuarioActivo\");\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["onAuthStateChanged","signOut","auth","NavbarComponent","NexusComponent","FooterComponent","name","components","methods","logout","localStorage","removeItem","$router","push"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\views\\DashboardView.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard d-flex\">\r\n    <!-- Contenido principal -->\r\n    <div class=\"main-content flex-grow-1\">\r\n  <NavbarComponent />\r\n  <NexusComponent></NexusComponent>\r\n\r\n      <div>\r\n        <router-view />\r\n       <FooterComponent />\r\n      </div>\r\n    </div>\r\n\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { onAuthStateChanged, signOut } from \"firebase/auth\";\r\nimport { auth } from \"../firebase/config\";\r\nimport NavbarComponent from \"../components/NavbarComponent.vue\";\r\nimport NexusComponent  from \"@/components/NexusComponent.vue\";\r\nimport FooterComponent from \"../components/FooterComponent.vue\";\r\n\r\n\r\nexport default {\r\n  name: \"DashboardView\",\r\n  components: {\r\n    NavbarComponent,\r\n    NexusComponent,\r\n    FooterComponent,\r\n  },\r\n  // Nota: se removió la redirección automática desde mounted() para\r\n  // permitir que la vista muestre contenido público (como NexusComponent)\r\n  // incluso cuando no haya un usuario autenticado. Si la intención es\r\n  // proteger toda la dashboard para usuarios autenticados, es mejor\r\n  // mover esta lógica al guard de rutas (router) o agregar meta.requiresAuth\r\n  // a la ruta \"/\".\r\n  methods: {\r\n    async logout() {\r\n      await signOut(auth);\r\n      localStorage.removeItem(\"usuarioActivo\");\r\n      this.$router.push(\"/login\");\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n"],"mappings":";AAkBA,SAASA,kBAAkB,EAAEC,OAAM,QAAS,eAAe;AAC3D,SAASC,IAAG,QAAS,oBAAoB;AACzC,OAAOC,eAAc,MAAO,mCAAmC;AAC/D,OAAOC,cAAa,MAAQ,iCAAiC;AAC7D,OAAOC,eAAc,MAAO,mCAAmC;AAG/D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IACVJ,eAAe;IACfC,cAAc;IACdC;EACF,CAAC;EACD;EACA;EACA;EACA;EACA;EACA;EACAG,OAAO,EAAE;IACP,MAAMC,MAAMA,CAAA,EAAG;MACb,MAAMR,OAAO,CAACC,IAAI,CAAC;MACnBQ,YAAY,CAACC,UAAU,CAAC,eAAe,CAAC;MACxC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;IAC7B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}