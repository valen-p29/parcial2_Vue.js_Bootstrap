{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nexport default {\n  name: 'NavbarComponent',\n  data() {\n    return {\n      cartCount: 0\n    };\n  },\n  mounted() {\n    this.updateCartCount();\n    window.addEventListener('storage', this.updateCartCount);\n    // also listen for custom events dispatched in code\n    window.addEventListener('cart-updated', this.updateCartCount);\n  },\n  beforeUnmount() {\n    window.removeEventListener('storage', this.updateCartCount);\n    window.removeEventListener('cart-updated', this.updateCartCount);\n  },\n  methods: {\n    updateCartCount() {\n      try {\n        const saved = localStorage.getItem('cart');\n        const cart = saved ? JSON.parse(saved) : [];\n        const total = cart.reduce((s, i) => s + (i.quantity || 1), 0);\n        this.cartCount = total;\n      } catch (e) {\n        this.cartCount = 0;\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","cartCount","mounted","updateCartCount","window","addEventListener","beforeUnmount","removeEventListener","methods","saved","localStorage","getItem","cart","JSON","parse","total","reduce","s","i","quantity","e"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\components\\NavbarComponent.vue"],"sourcesContent":["<template>\r\n  <aside class=\"sidebar\">\r\n    <div class=\"sidebar-brand\">\r\n      <h2>FASHION STORE</h2>\r\n    </div>\r\n    <nav class=\"sidebar-nav\">\r\n      <router-link to=\"/\" class=\"sidebar-link\">Inicio</router-link>\r\n      <router-link to=\"/productos\" class=\"sidebar-link\">Productos</router-link>\r\n      <router-link to=\"/dashboard\" class=\"sidebar-link\">Dashboard</router-link>\r\n      <router-link to=\"/admin\" class=\"sidebar-link\">Admin</router-link>\r\n    </nav>\r\n    <div class=\"sidebar-actions\">\r\n      <button class=\"btn btn-outline-secondary btn-sm\" @click=\"$router.push('/login')\">Iniciar sesión</button>\r\n      <button class=\"btn btn-primary btn-sm\" @click=\"$router.push('/products')\">\r\n        <i class=\"fas fa-shopping-cart\"></i>\r\n        <span class=\"cart-count\">{{ cartCount }}</span>\r\n      </button>\r\n    </div>\r\n  </aside>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'NavbarComponent',\r\n  data() {\r\n    return { cartCount: 0 }\r\n  },\r\n  mounted() {\r\n    this.updateCartCount()\r\n    window.addEventListener('storage', this.updateCartCount)\r\n    // also listen for custom events dispatched in code\r\n    window.addEventListener('cart-updated', this.updateCartCount)\r\n  },\r\n  beforeUnmount() {\r\n    window.removeEventListener('storage', this.updateCartCount)\r\n    window.removeEventListener('cart-updated', this.updateCartCount)\r\n  },\r\n  methods: {\r\n    updateCartCount() {\r\n      try {\r\n        const saved = localStorage.getItem('cart')\r\n        const cart = saved ? JSON.parse(saved) : []\r\n        const total = cart.reduce((s, i) => s + (i.quantity || 1), 0)\r\n        this.cartCount = total\r\n      } catch (e) {\r\n        this.cartCount = 0\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 240px; background:#fff; box-shadow: 2px 0 8px rgba(0,0,0,0.05); padding:1rem; display:flex; flex-direction:column; gap:1rem; z-index:1500 }\r\n.sidebar-brand { font-weight:700; font-size:1.1rem }\r\n.sidebar-nav { display:flex; flex-direction:column; gap:0.5rem; margin-top:0.5rem }\r\n.sidebar-link { color:#333; text-decoration:none; padding:0.5rem; border-radius:6px }\r\n.sidebar-link.router-link-active { background:#f0f0f0 }\r\n.sidebar-actions { margin-top:auto; display:flex; gap:0.5rem; align-items:center }\r\n.cart-count { margin-left:0.5rem; font-weight:600 }\r\n@media(max-width:768px){ .sidebar { position:relative; width:100%; height:auto; box-shadow:none; flex-direction:row; align-items:center } .sidebar-nav { flex-direction:row; gap:0.75rem } }\r\n</style>"],"mappings":";;AAsBA,eAAe;EACbA,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MAAEC,SAAS,EAAE;IAAE;EACxB,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC;IACrBC,MAAM,CAACC,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACF,eAAe;IACvD;IACAC,MAAM,CAACC,gBAAgB,CAAC,cAAc,EAAE,IAAI,CAACF,eAAe;EAC9D,CAAC;EACDG,aAAaA,CAAA,EAAG;IACdF,MAAM,CAACG,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACJ,eAAe;IAC1DC,MAAM,CAACG,mBAAmB,CAAC,cAAc,EAAE,IAAI,CAACJ,eAAe;EACjE,CAAC;EACDK,OAAO,EAAE;IACPL,eAAeA,CAAA,EAAG;MAChB,IAAI;QACF,MAAMM,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;QACzC,MAAMC,IAAG,GAAIH,KAAI,GAAII,IAAI,CAACC,KAAK,CAACL,KAAK,IAAI,EAAC;QAC1C,MAAMM,KAAI,GAAIH,IAAI,CAACI,MAAM,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKD,CAAA,IAAKC,CAAC,CAACC,QAAO,IAAK,CAAC,CAAC,EAAE,CAAC;QAC5D,IAAI,CAAClB,SAAQ,GAAIc,KAAI;MACvB,EAAE,OAAOK,CAAC,EAAE;QACV,IAAI,CAACnB,SAAQ,GAAI;MACnB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}