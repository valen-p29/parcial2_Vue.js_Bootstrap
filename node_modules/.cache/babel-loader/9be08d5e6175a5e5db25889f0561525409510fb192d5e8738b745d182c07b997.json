{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'MainComponent',\n  data() {\n    return {\n      products: []\n    };\n  },\n  mounted() {\n    this.loadProducts();\n  },\n  methods: {\n    async loadProducts() {\n      try {\n        const res = await fetch('/product.json');\n        if (!res.ok) throw new Error('No se pudo cargar /product.json');\n        const data = await res.json();\n        const products = data.products || [];\n        this.products = products.map(p => ({\n          id: String(p.id),\n          title: p.name || p.title || 'Sin título',\n          author: p.category || 'Desconocido',\n          description: p.description || '',\n          price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\n          image: p.image || null\n        }));\n      } catch (err) {\n        console.error('Error cargando productos en MainComponent:', err);\n      }\n    },\n    formatPrice(val) {\n      if (typeof val !== 'number') return val;\n      return val.toFixed(2);\n    },\n    getPlaceholder() {\n      return 'data:image/svg+xml;base64,';\n    },\n    viewProduct(p) {\n      // Dispatch a custom event or navigate to products page\n      this.$router.push({\n        name: 'Products'\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","products","mounted","loadProducts","methods","res","fetch","ok","Error","json","map","p","id","String","title","author","category","description","price","parseFloat","image","err","console","error","formatPrice","val","toFixed","getPlaceholder","viewProduct","$router","push"],"sources":["C:\\Users\\User\\Desktop\\PARCIAL_2\\src\\components\\MainComponent.vue"],"sourcesContent":["<template>\r\n  <section class=\"hero\">\r\n    <div class=\"hero-background\">\r\n      <img\r\n        src=\"https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80\"\r\n        alt=\"Fashion Store\" class=\"hero-bg-image\">\r\n      <div class=\"hero-overlay\"></div>\r\n    </div>\r\n    <div class=\"hero-content\">\r\n      <h2 class=\"hero-title\">Nueva Colección</h2>\r\n      <p class=\"hero-subtitle\">Descubre las últimas tendencias en moda</p>\r\n      <button class=\"btn-primary\" id=\"viewCollectionBtn\">Ver Colección</button>\r\n    </div>\r\n  </section>\r\n\r\n  <section class=\"products-section\">\r\n    <div class=\"container\">\r\n      <div class=\"section-header\">\r\n        <h3>Productos Destacados</h3>\r\n        <div class=\"filters\">\r\n          <button class=\"filter-btn active\" data-filter=\"all\">Todos</button>\r\n          <button class=\"filter-btn\" data-filter=\"hombre\">Hombre</button>\r\n          <button class=\"filter-btn\" data-filter=\"mujer\">Mujer</button>\r\n          <button class=\"filter-btn\" data-filter=\"accesorios\">Accesorios</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"products-grid\" id=\"productsGrid\">\r\n        <div class=\"product-card\" v-for=\"p in products\" :key=\"p.id\">\r\n          <div class=\"product-image\">\r\n            <img :src=\"p.image || getPlaceholder()\" :alt=\"p.name || p.title\" />\r\n          </div>\r\n          <div class=\"product-info\">\r\n            <h4 class=\"product-title\">{{ p.title || p.name }}</h4>\r\n            <p class=\"product-category\">{{ p.author || p.category }}</p>\r\n            <p class=\"product-price\">${{ formatPrice(p.price) }}</p>\r\n            <p class=\"product-desc\">{{ p.description }}</p>\r\n            <button class=\"btn-primary btn-full\" @click=\"viewProduct(p)\">Ver</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Login Modal -->\r\n  <div class=\"modal\" id=\"loginModal\">\r\n    <div class=\"modal-content\">\r\n      <span class=\"close\">&times;</span>\r\n      <div class=\"auth-container\">\r\n        <form class=\"auth-form\" id=\"loginForm\">\r\n          <h3>Iniciar Sesión</h3>\r\n          <div class=\"credentials-info\">\r\n            <p><strong>Credenciales de prueba:</strong></p>\r\n            <p>Email: <code>admin@fashionstore.com</code></p>\r\n            <p>Contraseña: <code>admin123</code></p>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <input type=\"email\" id=\"loginEmail\" placeholder=\"Correo electrónico\" required>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <input type=\"password\" id=\"loginPassword\" placeholder=\"Contraseña\" required>\r\n          </div>\r\n          <button type=\"submit\" class=\"btn-primary btn-full\">Ingresar</button>\r\n          <div class=\"login-error\" id=\"loginError\" style=\"display: none;\">\r\n            <p>Credenciales incorrectas. Usa las credenciales de prueba.</p>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Quick View Modal -->\r\n  <div class=\"modal\" id=\"quickViewModal\">\r\n    <div class=\"modal-content quick-view-modal-content\">\r\n      <span class=\"close\" id=\"closeQuickViewModal\">&times;</span>\r\n      <div class=\"quick-view-container\">\r\n        <div class=\"quick-view-image\">\r\n          <img id=\"quickViewImage\" src=\"\" alt=\"\" class=\"quick-view-img\">\r\n        </div>\r\n        <div class=\"quick-view-info\">\r\n          <div class=\"quick-view-header\">\r\n            <span class=\"quick-view-category\" id=\"quickViewCategory\"></span>\r\n            <button class=\"btn-wishlist-quick\" id=\"quickViewWishlist\">\r\n              <i class=\"fas fa-heart\"></i>\r\n            </button>\r\n          </div>\r\n          <h2 class=\"quick-view-title\" id=\"quickViewTitle\"></h2>\r\n          <p class=\"quick-view-price\" id=\"quickViewPrice\"></p>\r\n\r\n          <div class=\"quick-view-description\">\r\n            <h4>Descripción</h4>\r\n            <p id=\"quickViewDescription\"></p>\r\n          </div>\r\n\r\n          <div class=\"quick-view-details\">\r\n            <h4>Detalles del Producto</h4>\r\n            <ul id=\"quickViewFeatures\"></ul>\r\n          </div>\r\n\r\n          <div class=\"quick-view-sizes\">\r\n            <h4>Tallas Disponibles</h4>\r\n            <div class=\"size-options\" id=\"quickViewSizes\">\r\n              <button class=\"size-btn\" data-size=\"XS\">XS</button>\r\n              <button class=\"size-btn\" data-size=\"S\">S</button>\r\n              <button class=\"size-btn active\" data-size=\"M\">M</button>\r\n              <button class=\"size-btn\" data-size=\"L\">L</button>\r\n              <button class=\"size-btn\" data-size=\"XL\">XL</button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"quick-view-quantity\">\r\n            <h4>Cantidad</h4>\r\n            <div class=\"quantity-controls\">\r\n              <button class=\"quantity-btn\" id=\"decreaseQty\">-</button>\r\n              <input type=\"number\" class=\"quantity-input\" id=\"quickViewQty\" value=\"1\" min=\"1\" max=\"10\">\r\n              <button class=\"quantity-btn\" id=\"increaseQty\">+</button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"quick-view-actions\">\r\n            <button class=\"btn-add-cart-quick\" id=\"addToCartQuick\">\r\n              <i class=\"fas fa-shopping-cart\"></i>\r\n              Añadir al Carrito\r\n            </button>\r\n            <button class=\"btn-buy-now\" id=\"buyNowBtn\">\r\n              Comprar Ahora\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Collection Modal -->\r\n  <div class=\"modal\" id=\"collectionModal\">\r\n    <div class=\"modal-content collection-modal-content\">\r\n      <span class=\"close\" id=\"closeCollectionModal\">&times;</span>\r\n      <div class=\"collection-container\">\r\n        <h2>Nueva Colección 2024</h2>\r\n        <div class=\"collection-hero\">\r\n          <img\r\n            src=\"https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80\"\r\n            alt=\"Nueva Colección\" class=\"collection-image\">\r\n          <div class=\"collection-overlay\">\r\n            <h3>Tendencias de Temporada</h3>\r\n            <p>Descubre los últimos estilos que están marcando la pauta en el mundo de la moda</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"collection-categories\">\r\n          <div class=\"collection-category\" data-category=\"hombre\">\r\n            <img\r\n              src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80\"\r\n              alt=\"Colección Hombre\">\r\n            <div class=\"category-info\">\r\n              <h4>Hombre</h4>\r\n              <p>Estilo urbano y elegante</p>\r\n              <button class=\"btn-category\">Ver Productos</button>\r\n            </div>\r\n          </div>\r\n          <div class=\"collection-category\" data-category=\"mujer\">\r\n            <img\r\n              src=\"https://images.unsplash.com/photo-1494790108755-2616c669-b6c2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80\"\r\n              alt=\"Colección Mujer\">\r\n            <div class=\"category-info\">\r\n              <h4>Mujer</h4>\r\n              <p>Sofisticación y comodidad</p>\r\n              <button class=\"btn-category\">Ver Productos</button>\r\n            </div>\r\n          </div>\r\n          <div class=\"collection-category\" data-category=\"accesorios\">\r\n            <img\r\n              src=\"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=400&q=80\"\r\n              alt=\"Accesorios\">\r\n            <div class=\"category-info\">\r\n              <h4>Accesorios</h4>\r\n              <p>Complementos perfectos</p>\r\n              <button class=\"btn-category\">Ver Productos</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Cart Sidebar -->\r\n  <div class=\"cart-sidebar\" id=\"cartSidebar\">\r\n    <div class=\"cart-header\">\r\n      <h3>Carrito de Compras</h3>\r\n      <button class=\"close-cart\">&times;</button>\r\n    </div>\r\n    <div class=\"cart-items\" id=\"cartItems\">\r\n      <!-- Cart items will be dynamically loaded here -->\r\n    </div>\r\n    <div class=\"cart-footer\">\r\n      <div class=\"cart-total\">\r\n        <span>Total:</span>\r\n        <span id=\"cartTotal\">$0.00</span>\r\n      </div>\r\n      <button class=\"btn-primary btn-full\">Proceder al Pago</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MainComponent',\r\n  data() {\r\n    return {\r\n      products: []\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadProducts()\r\n  },\r\n  methods: {\r\n    async loadProducts() {\r\n      try {\r\n        const res = await fetch('/product.json')\r\n        if (!res.ok) throw new Error('No se pudo cargar /product.json')\r\n        const data = await res.json()\r\n        const products = data.products || []\r\n        this.products = products.map(p => ({\r\n          id: String(p.id),\r\n          title: p.name || p.title || 'Sin título',\r\n          author: p.category || 'Desconocido',\r\n          description: p.description || '',\r\n          price: typeof p.price === 'number' ? p.price / 100 : parseFloat(p.price) || 0,\r\n          image: p.image || null\r\n        }))\r\n      } catch (err) {\r\n        console.error('Error cargando productos en MainComponent:', err)\r\n      }\r\n    },\r\n    formatPrice(val) {\r\n      if (typeof val !== 'number') return val\r\n      return val.toFixed(2)\r\n    },\r\n    getPlaceholder() {\r\n      return 'data:image/svg+xml;base64,'\r\n    },\r\n    viewProduct(p) {\r\n      // Dispatch a custom event or navigate to products page\r\n      this.$router.push({ name: 'Products' })\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";;;AA2MA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC;EACpB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAME,GAAE,GAAI,MAAMC,KAAK,CAAC,eAAe;QACvC,IAAI,CAACD,GAAG,CAACE,EAAE,EAAE,MAAM,IAAIC,KAAK,CAAC,iCAAiC;QAC9D,MAAMR,IAAG,GAAI,MAAMK,GAAG,CAACI,IAAI,CAAC;QAC5B,MAAMR,QAAO,GAAID,IAAI,CAACC,QAAO,IAAK,EAAC;QACnC,IAAI,CAACA,QAAO,GAAIA,QAAQ,CAACS,GAAG,CAACC,CAAA,KAAM;UACjCC,EAAE,EAAEC,MAAM,CAACF,CAAC,CAACC,EAAE,CAAC;UAChBE,KAAK,EAAEH,CAAC,CAACZ,IAAG,IAAKY,CAAC,CAACG,KAAI,IAAK,YAAY;UACxCC,MAAM,EAAEJ,CAAC,CAACK,QAAO,IAAK,aAAa;UACnCC,WAAW,EAAEN,CAAC,CAACM,WAAU,IAAK,EAAE;UAChCC,KAAK,EAAE,OAAOP,CAAC,CAACO,KAAI,KAAM,QAAO,GAAIP,CAAC,CAACO,KAAI,GAAI,GAAE,GAAIC,UAAU,CAACR,CAAC,CAACO,KAAK,KAAK,CAAC;UAC7EE,KAAK,EAAET,CAAC,CAACS,KAAI,IAAK;QACpB,CAAC,CAAC;MACJ,EAAE,OAAOC,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,4CAA4C,EAAEF,GAAG;MACjE;IACF,CAAC;IACDG,WAAWA,CAACC,GAAG,EAAE;MACf,IAAI,OAAOA,GAAE,KAAM,QAAQ,EAAE,OAAOA,GAAE;MACtC,OAAOA,GAAG,CAACC,OAAO,CAAC,CAAC;IACtB,CAAC;IACDC,cAAcA,CAAA,EAAG;MACf,OAAO,4VAA2V;IACpW,CAAC;IACDC,WAAWA,CAACjB,CAAC,EAAE;MACb;MACA,IAAI,CAACkB,OAAO,CAACC,IAAI,CAAC;QAAE/B,IAAI,EAAE;MAAW,CAAC;IACxC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}