{"ast":null,"code":"import { useNexusComponent } from '../assets/scripts/nexusComponent';\nimport { reactive, toRefs } from 'vue';\nexport default {\n  name: 'NexusComponent',\n  setup() {\n    const {\n      state,\n      cargarLibrosDestacados,\n      setupScrollAnimations\n    } = useNexusComponent();\n    const reactiveState = reactive(state);\n\n    // Cargar libros cuando el componente se monte\n    cargarLibrosDestacados();\n\n    // Configurar animaciones cuando el componente se monte\n    setTimeout(() => {\n      setupScrollAnimations();\n    }, 0);\n    return {\n      ...toRefs(reactiveState)\n    };\n  }\n};","map":{"version":3,"names":["useNexusComponent","reactive","toRefs","name","setup","state","cargarLibrosDestacados","setupScrollAnimations","reactiveState","setTimeout"],"sources":["C:\\Users\\User\\Documents\\parcial_2_desarrollo\\nexus_library\\src\\components\\NexusComponent.vue"],"sourcesContent":["<template>\r\n  <main class=\"nexus-main container\" role=\"main\">\r\n\r\n    <section class=\"hero-section\" role=\"region\" aria-label=\"Presentación principal\">\r\n\r\n      <div class=\"hero-content\">\r\n\r\n        <h1 class=\"hero-title\">\r\n          Descubre el <span class=\"highlight\">futuro</span> de la lectura\r\n        </h1>\r\n        <p class=\"hero-subtitle\">\r\n          Una experiencia inmersiva donde la tecnología y la literatura\r\n          convergen\r\n        </p>\r\n\r\n        <div class=\"hero-actions\">\r\n          <button class=\"primary-btn btn\" onclick=\"showCollectionModal()\">\r\n            <i class=\"bi bi-collection\"></i> Explorar colección\r\n          </button>\r\n\r\n          <button class=\"secondary-btn btn\" onclick=\"showEventsModal()\">\r\n            <i class=\"bi bi-calendar-check\"></i> Próximos eventos\r\n          </button>\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </section>\r\n\r\n    <section class=\"carousel-section scroll-animation\">\r\n      <div class=\"section-header\">\r\n        <h2>Colección destacada</h2>\r\n      </div>\r\n      <div class=\"nexus-carousel position-relative overflow-hidden\">\r\n        <div v-if=\"loading\" class=\"text-center py-4\">\r\n          Cargando libros...\r\n        </div>\r\n        <div v-else-if=\"error\" class=\"text-center py-4 text-danger\">\r\n          {{ error }}\r\n        </div>\r\n        <div v-else class=\"recommendations-container\">\r\n          <div v-for=\"libro in librosDestacados\" :key=\"libro.id\" class=\"recommendation-card\">\r\n            <img :src=\"libro.image\" :alt=\"'Portada de ' + libro.title\" class=\"book-cover\" />\r\n            <div class=\"book-info\">\r\n              <h3 class=\"book-title\">{{ libro.title }}</h3>\r\n              <p class=\"book-author\">{{ libro.author }}</p>\r\n              <div class=\"book-meta\">\r\n                <span class=\"book-category\">{{ libro.category }}</span>\r\n                <span class=\"book-rating\">{{ '⭐'.repeat(Math.floor(libro.rating)) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <!-- Debug info -->\r\n        <div class=\"mt-2 text-muted small\" style=\"display: none;\">\r\n          Debug: {{ librosDestacados?.length || 0 }} libros cargados\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"features-section scroll-animation \" role=\"region\" aria-label=\"Características principales\">\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-telephone-plus fs-3\"></i>\r\n        </div>\r\n        <h3>Contacto</h3>\r\n        <p>Comunicate con nosotros a traves del correo: <a class=\"info-Correo\" href=\"#\">info@nexuslibrary.com</a> o deja\r\n          un comentario</p>\r\n      </div>\r\n\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-person-vcard fs-3\"></i>\r\n        </div>\r\n        <h3>Membresia <span class=\"premium\">VIP</span></h3>\r\n        <p>\r\n          Accede a contenido exclusivo, eventos privados y ofertas exclusivas.\r\n        </p>\r\n        <button class=\"btn primary-btn\" style=\"margin-top: 1.3rem;\" onclick=\"showMembershipModal()\">Únete ahora</button>\r\n      </div>\r\n\r\n      <div class=\"feature-card col-12 col-md-4\">\r\n        <div class=\"feature-icon rounded-circle d-flex align-items-center justify-content-center mb-3\">\r\n          <i class=\"bi bi-chat-left-dots fs-3\"></i>\r\n        </div>\r\n        <h3>Comunidad Nexus</h3>\r\n        <p>\r\n          Únete a nuestra comunidad de lectores y comparte tus opiniones y recomendaciones.\r\n        </p>\r\n\r\n        <button class=\"btn primary-btn\" onclick=\"showDiscordModal()\"> <i class=\"bi bi-discord\"></i> Unirte</button>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"newsletter-section scroll-animation\" role=\"region\" aria-label=\"Suscríbete a nuestro newsletter\">\r\n      <div class=\"newsletter-container\">\r\n        <div class=\"text\">\r\n          <p id=\"two\" class=\"fw-semibold\">Tu curiosidad nos inspira</p>\r\n          <p id=\"three\">Escríbenos sin temor para resolver tus dudas.</p>\r\n        </div>\r\n        <form class=\"newsletter-form\" action=\"#\" method=\"post\" novalidate>\r\n          <div>\r\n            <label for=\"nombre\" class=\"form-label visually-hidden\">Nombre</label>\r\n            <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Nombre\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa tu nombre.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"email\" class=\"form-label visually-hidden\">Email</label>\r\n            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Correo electrónico\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa un correo válido.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"telefono\" class=\"form-label visually-hidden\">Teléfono</label>\r\n            <input type=\"tel\" id=\"telefono\" name=\"telefono\" placeholder=\"Teléfono\" pattern=\"[0-9]{10,15}\" required>\r\n            <div class=\"invalid-feedback\">Por favor, ingresa un teléfono válido.</div>\r\n          </div>\r\n          <div>\r\n            <label for=\"mensaje\" class=\"form-label visually-hidden\">Mensaje</label>\r\n            <textarea id=\"mensaje\" name=\"mensaje\" placeholder=\"Mensaje\" rows=\"1\" required></textarea>\r\n            <div class=\"invalid-feedback\">Por favor, escribe tu mensaje.</div>\r\n          </div>\r\n          <div>\r\n            <button type=\"submit\" class=\"btn primary-btn px-4\" id=\"contact-btn\">¡Háblanos!</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </section>\r\n\r\n  </main>\r\n</template>\r\n\r\n<script>\r\nimport { useNexusComponent } from '../assets/scripts/nexusComponent';\r\nimport { reactive, toRefs } from 'vue';\r\n\r\nexport default {\r\n  name: 'NexusComponent',\r\n  setup() {\r\n    const { state, cargarLibrosDestacados, setupScrollAnimations } = useNexusComponent();\r\n    const reactiveState = reactive(state);\r\n\r\n    // Cargar libros cuando el componente se monte\r\n    cargarLibrosDestacados();\r\n\r\n    // Configurar animaciones cuando el componente se monte\r\n    setTimeout(() => {\r\n      setupScrollAnimations();\r\n    }, 0);\r\n\r\n    return {\r\n      ...toRefs(reactiveState)\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n\r\n<style src=\"../assets/estilosCss/style.css\"></style>\r\n<style src=\"../assets/estilosCss/books.css\"></style>"],"mappings":"AAoIA,SAASA,iBAAgB,QAAS,kCAAkC;AACpE,SAASC,QAAQ,EAAEC,MAAK,QAAS,KAAK;AAEtC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC,sBAAsB;MAAEC;IAAsB,IAAIP,iBAAiB,CAAC,CAAC;IACpF,MAAMQ,aAAY,GAAIP,QAAQ,CAACI,KAAK,CAAC;;IAErC;IACAC,sBAAsB,CAAC,CAAC;;IAExB;IACAG,UAAU,CAAC,MAAM;MACfF,qBAAqB,CAAC,CAAC;IACzB,CAAC,EAAE,CAAC,CAAC;IAEL,OAAO;MACL,GAAGL,MAAM,CAACM,aAAa;IACzB,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}